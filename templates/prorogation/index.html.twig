{% extends 'base.html.twig' %}

{% block title %}Demandes de Prorogation d'Échéance{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2 class="page-title">Prorogations d'Échéance</h2>
        <p class="page-subtitle">Gestion et validation des reports de délais pour les instructions et actions</p>
    </div>
</div>

<!-- Pending Requests Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-hourglass-split" style="color: var(--color-warning);"></i> Demandes en Attente de Décision ({{ pending|length }})
        </h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Cible (Instruction / Action)</th>
                        <th>Demandeur</th>
                        <th>Ancienne Échéance</th>
                        <th>Nouvelle Échéance Proposée</th>
                        <th>Motif du Report</th>
                        <th>Date Demande</th>
                        <th style="text-align: right;">Décision</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in pending %}
                        <tr>
                            <td>
                                {% if p.action %}
                                    <span class="badge badge-secondary">Action</span>
                                    <a href="{{ path('app_action_show', {'id': p.action.id}) }}" style="font-weight: 600;">
                                        {{ p.action.libelle }}
                                    </a>
                                    <div style="font-size: 0.72rem; color: var(--text-muted);">{{ p.instruction.reference }}</div>
                                {% elseif p.instruction %}
                                    <span class="badge badge-primary">Instruction</span>
                                    <a href="{{ path('app_instruction_show', {'id': p.instruction.id}) }}" style="font-weight: 600;">
                                        {{ p.instruction.reference }}
                                    </a>
                                {% endif %}
                            </td>
                            <td>{{ p.demandePar ? p.demandePar.nomComplet : 'N/A' }}</td>
                            <td style="color: var(--text-muted); text-decoration: line-through;">
                                {{ p.ancienneEcheance|date('d/m/Y') }}
                            </td>
                            <td style="font-weight: 700; color: var(--color-success);">
                                {{ p.nouvelleEcheance|date('d/m/Y') }}
                            </td>
                            <td style="font-size: 0.82rem; max-width: 250px;">{{ p.motif }}</td>
                            <td style="font-size: 0.78rem; color: var(--text-muted);">{{ p.dateDemande|date('d/m/Y H:i') }}</td>
                            <td style="text-align: right;">
                                <a href="{{ path('app_prorogation_decision', {'id': p.id}) }}" class="btn btn-primary btn-sm">
                                    <i class="bi bi-shield-check"></i> Décider
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 28px; color: var(--text-muted);">
                                <i class="bi bi-check2-all" style="font-size: 1.8rem; color: var(--color-success);"></i>
                                <p style="margin-top: 6px;">Aucune demande de prorogation en attente.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- All Requests History -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-clock-history"></i> Historique Global des Prorogations ({{ all|length }})</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Cible</th>
                        <th>Demandeur</th>
                        <th>Ancienne &rarr; Nouvelle</th>
                        <th>Motif</th>
                        <th>Statut</th>
                        <th>Validateur & Date</th>
                        <th>Commentaire</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in all %}
                        <tr>
                            <td>
                                {% if p.action %}
                                    <a href="{{ path('app_action_show', {'id': p.action.id}) }}">{{ p.action.libelle }}</a>
                                {% elseif p.instruction %}
                                    <a href="{{ path('app_instruction_show', {'id': p.instruction.id}) }}">{{ p.instruction.reference }}</a>
                                {% endif %}
                            </td>
                            <td>{{ p.demandePar ? p.demandePar.nomComplet : 'N/A' }}</td>
                            <td>
                                {{ p.ancienneEcheance|date('d/m/Y') }} &rarr; <strong>{{ p.nouvelleEcheance|date('d/m/Y') }}</strong>
                            </td>
                            <td style="font-size: 0.8rem;">{{ p.motif }}</td>
                            <td><span class="badge {{ p.statutProrogation.badgeClass }}">{{ p.statutProrogation.libelle }}</span></td>
                            <td style="font-size: 0.78rem;">
                                {{ p.validePar ? p.validePar.nomComplet : '-' }}
                                {% if p.dateValidation %}<div>{{ p.dateValidation|date('d/m/Y') }}</div>{% endif %}
                            </td>
                            <td style="font-size: 0.8rem; color: var(--text-secondary);">{{ p.commentaireValidation|default('-') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 24px; color: var(--text-muted);">
                                Aucune prorogation enregistrée.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
