{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - ACTIS-BCC{% endblock %}

{% block body %}
<div class="dashboard-page-container">
    <!-- Top Header & Fast Filters Bar -->
    <div class="dashboard-topbar-header">
        <div class="header-titles">
            <div class="dashboard-breadcrumbs">
                <a href="{{ path('app_dashboard') }}"><i class="bi bi-house-door"></i></a>
                <span class="bc-sep">/</span>
                <span class="bc-current">Tableau de bord</span>
            </div>
            <h1 class="dashboard-main-title">Tableau de bord</h1>
            <p class="dashboard-main-subtitle">Vue d'ensemble du suivi des Instructions et Actions</p>
            <p class="dashboard-period-info" id="periodInfo" title="La période filtre les instructions et actions selon leur date de création dans ACTIS">
                <i class="bi bi-info-circle"></i> <span id="periodInfoText">{{ dashboard.period_info }}</span>
            </p>
        </div>

        <!-- Quick Filters Toolbar -->
        <div class="dashboard-filters-toolbar">
            <!-- Period Filter -->
            <div class="filter-pill-select">
                <i class="bi bi-calendar3 filter-icon"></i>
                <div class="filter-labels">
                    <span class="filter-caption">Période</span>
                    <select class="filter-select-input" id="filterPeriode" onchange="onPeriodeChange()">
                        <option value="all" selected>Tous</option>
                        <option value="month">Ce mois</option>
                        <option value="quarter">Ce trimestre</option>
                        <option value="year">Cette année</option>
                        <option value="custom">Personnalisée…</option>
                    </select>
                </div>
                <i class="bi bi-chevron-down filter-arrow"></i>
            </div>

            <!-- Custom Period Range (visible si « Personnalisée ») -->
            <div class="filter-custom-range" id="customRangeBox" hidden>
                <label>
                    <span class="filter-caption">Du</span>
                    <input type="date" class="filter-date-input" id="filterDu" max="{{ 'now'|date('Y-m-d') }}">
                </label>
                <label>
                    <span class="filter-caption">Au</span>
                    <input type="date" class="filter-date-input" id="filterAu" value="{{ 'now'|date('Y-m-d') }}">
                </label>
                <button type="button" class="btn-apply-range" onclick="applyFilters()">
                    <i class="bi bi-check2"></i> Appliquer
                </button>
                <span class="filter-range-error" id="customRangeError" hidden></span>
            </div>

            <!-- Entity Filter -->
            <div class="filter-pill-select">
                <i class="bi bi-bank filter-icon"></i>
                <div class="filter-labels">
                    <span class="filter-caption">Entité</span>
                    <select class="filter-select-input" id="filterEntite" onchange="applyFilters()">
                        <option value="" selected>Toutes les entités</option>
                        {% for ent in allEntites %}
                            <option value="{{ ent.id }}">{{ ent.code }} - {{ ent.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <i class="bi bi-chevron-down filter-arrow"></i>
            </div>

            <!-- Reset Filters Button -->
            <button type="button" class="btn-reset-filters" id="btnResetFilters" style="display: none;" onclick="resetFilters()">
                <i class="bi bi-x-circle"></i>
                <span>Réinitialiser</span>
            </button>

            <!-- Loading Badge -->
            <div class="filter-loading-badge" id="filterLoadingBadge" style="display: none;">
                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                <span>Actualisation...</span>
            </div>

            <!-- Advanced Filters Button -->
            <a href="{{ path('app_instruction_index') }}" class="btn-advanced-filters">
                <i class="bi bi-funnel"></i>
                <span>Filtres avancés</span>
            </a>
        </div>
    </div>

    <!-- Dynamic Container Wrapper -->
    <div class="dashboard-dynamic-content" id="dashboardDynamicContainer">

    <!-- 4 Top KPI Metric Cards -->
    <div class="kpi-quad-row kpi-five">
        <!-- 1. Instructions en cours -->
        <a href="{{ path('app_instruction_index', {'statut': 'EN_COURS'}) }}" class="kpi-metric-card">
            <div class="kpi-metric-icon-box icon-blue">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <div class="kpi-metric-content">
                <div class="kpi-metric-number" id="kpiEnCours">{{ dashboard.kpis.en_cours }}</div>
                <div class="kpi-metric-label">Instructions en cours</div>
                <div class="kpi-metric-trend" id="trendEnCours"></div>
            </div>
        </a>

        <!-- 2. Total actions -->
        <a href="{{ path('app_action_index') }}" class="kpi-metric-card">
            <div class="kpi-metric-icon-box icon-indigo">
                <i class="bi bi-list-check"></i>
            </div>
            <div class="kpi-metric-content">
                <div class="kpi-metric-number" id="kpiTotalActions">{{ dashboard.kpis.total_actions }}</div>
                <div class="kpi-metric-label">Total actions</div>
                <div class="kpi-metric-detail" id="kpiTotalActionsDetail"></div>
                <div class="kpi-metric-trend" id="trendTotalActions"></div>
            </div>
        </a>

        <!-- 3. Actions en retard -->
        <a href="{{ path('app_action_index', {'retard': '1'}) }}" class="kpi-metric-card">
            <div class="kpi-metric-icon-box icon-red">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="kpi-metric-content">
                <div class="kpi-metric-number text-red" id="kpiRetard">{{ dashboard.kpis.actions_en_retard }}</div>
                <div class="kpi-metric-label">Actions en retard</div>
                <div class="kpi-metric-trend" id="trendRetard"></div>
            </div>
        </a>

        <!-- 4. Échéances cette semaine -->
        <a href="{{ path('app_action_index') }}" class="kpi-metric-card">
            <div class="kpi-metric-icon-box icon-amber">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div class="kpi-metric-content">
                <div class="kpi-metric-number" id="kpiEcheances">{{ dashboard.kpis.echeances_this_week }}</div>
                <div class="kpi-metric-label">Échéances cette semaine</div>
                <div class="kpi-metric-trend" id="trendEcheances"></div>
            </div>
        </a>

        <!-- 5. Taux d'exécution -->
        <div class="kpi-metric-card">
            <div class="kpi-metric-icon-box icon-green">
                <i class="bi bi-bullseye"></i>
            </div>
            <div class="kpi-metric-content">
                <div class="kpi-metric-number" id="kpiTaux">{{ dashboard.kpis.taux_execution_actions }}%</div>
                <div class="kpi-metric-label">Taux d'exécution des actions</div>
                <div class="kpi-metric-trend" id="trendTaux"></div>
            </div>
        </div>
    </div>

    <!-- Main Content 2-Column Layout -->
    <div class="dashboard-main-grid">
        <!-- Left Section (70%): Charts + Priority Actions Table -->
        <div class="main-left-col">
            <!-- Row of 2 Visual Charts -->
            <div class="charts-dual-row">
                <!-- Chart 1: Instructions par statut -->
                <div class="bcc-card chart-card">
                    <div class="card-head-simple">
                        <h3 class="card-block-title">Instructions par statut</h3>
                    </div>
                    <div class="donut-chart-container">
                        <div class="donut-canvas-wrapper">
                            <canvas id="statutsDonutChart"></canvas>
                            <div class="donut-center-info">
                                <span class="donut-center-val" id="donutTotalCount">{{ dashboard.charts.total_instructions_count }}</span>
                                <span class="donut-center-lbl">Instructions<br>totales</span>
                            </div>
                        </div>
                        <div class="donut-legend-custom" id="donutLegendCustom"></div>
                    </div>
                </div>

                <!-- Chart 2: Évolution du taux d'exécution -->
                <div class="bcc-card chart-card">
                    <div class="card-head-simple">
                        <h3 class="card-block-title">Évolution du taux d'exécution <small class="text-muted fw-normal">(cumulé)</small></h3>
                    </div>
                    <div class="line-chart-wrapper">
                        <div class="chart-peak-badge" id="chartPeakBadge" title="Taux d'exécution actuel">{{ dashboard.charts.monthly_rates.current_rate }}%</div>
                        <canvas id="executionLineChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Priority Actions Table Card -->
            <div class="bcc-card table-actions-card">
                <div class="card-head-flex">
                    <h3 class="card-block-title">Actions prioritaires</h3>
                    <a href="{{ path('app_action_index') }}" class="link-see-all">Voir tout <i class="bi bi-arrow-right"></i></a>
                </div>

                <div class="table-responsive-clean">
                    <table class="bcc-modern-table">
                        <thead>
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Instruction</th>
                                <th>Entité responsable</th>
                                <th>Échéance <i class="bi bi-arrow-down-up sort-icon"></i></th>
                                <th>Statut <i class="bi bi-arrow-down-up sort-icon"></i></th>
                                <th>Priorité <i class="bi bi-arrow-down-up sort-icon"></i></th>
                                <th style="width: 40px; text-align: center;">&bull;&bull;&bull;</th>
                            </tr>
                        </thead>
                        <tbody id="priorityActionsTbody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Section (30%): À suivre + Activités Récentes -->
        <div class="main-right-col">
            <!-- Widget 1: À suivre -->
            <div class="bcc-card widget-card">
                <div class="card-head-flex">
                    <h3 class="card-block-title">À suivre</h3>
                    <a href="{{ path('app_action_index') }}" class="link-see-all">Voir tout <i class="bi bi-arrow-right"></i></a>
                </div>

                <div class="agenda-items-list" id="upcomingAgendaList">
                </div>
            </div>

            <!-- Widget 2: Activités récentes -->
            <div class="bcc-card widget-card">
                <div class="card-head-flex">
                    <h3 class="card-block-title">Activités récentes</h3>
                    <a href="{{ path('app_instruction_index') }}" class="link-see-all">Voir tout <i class="bi bi-arrow-right"></i></a>
                </div>

                <div class="activity-timeline-feed" id="recentActivitiesFeed">
                </div>
            </div>
        </div>
    </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
let statutsDonutChartInstance = null;
let executionLineChartInstance = null;

const INITIAL_DASHBOARD = {{ dashboard|json_encode|raw }};

function escapeHtml(text) {
    if (text === null || text === undefined) return '';
    return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

function emptyState(icon, message, colspan) {
    const inner = `<i class="bi ${icon}" style="font-size: 1.8rem; color: #CBD5E1; display: block; margin-bottom: 6px;"></i>${escapeHtml(message)}`;
    if (colspan) {
        return `<tr><td colspan="${colspan}" style="text-align: center; padding: 32px 16px; color: #64748B;">${inner}</td></tr>`;
    }
    return `<div style="text-align: center; padding: 24px 12px; color: #64748B; font-size: 0.85rem;">${inner}</div>`;
}

document.addEventListener('DOMContentLoaded', function() {
    // ── 1. Donut Chart: Instructions par statut ──
    const donutCtx = document.getElementById('statutsDonutChart');
    if (donutCtx) {
        statutsDonutChartInstance = new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: [],
                datasets: [{
                    data: [],
                    backgroundColor: [],
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverOffset: 4,
                    cutout: '68%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const val = context.parsed || 0;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = total > 0 ? Math.round((val / total) * 100) : 0;
                                return ` ${context.label}: ${val} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    // ── 2. Line Chart: Évolution du taux d'exécution (cumulé, année en cours) ──
    const lineCtx = document.getElementById('executionLineChart');
    if (lineCtx) {
        const gradient = lineCtx.getContext('2d').createLinearGradient(0, 0, 0, 220);
        gradient.addColorStop(0, 'rgba(13, 71, 161, 0.22)');
        gradient.addColorStop(1, 'rgba(13, 71, 161, 0.01)');

        executionLineChartInstance = new Chart(lineCtx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: "Taux d'exécution",
                    data: [],
                    borderColor: '#0A2540',
                    borderWidth: 2.5,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.35,
                    spanGaps: false,
                    // Point du mois courant mis en évidence
                    pointRadius: (ctx) => ctx.dataIndex === ctx.dataset.data.length - 1 ? 5 : 3,
                    pointBackgroundColor: '#0A2540',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return ` Taux: ${context.parsed.y}%`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#64748B',
                            font: {
                                size: 11,
                                family: "'Inter', sans-serif"
                            }
                        }
                    },
                    y: {
                        min: 0,
                        max: 100,
                        ticks: {
                            stepSize: 20,
                            callback: function(val) {
                                return val + '%';
                            },
                            color: '#64748B',
                            font: {
                                size: 11,
                                family: "'Inter', sans-serif"
                            }
                        },
                        grid: {
                            color: '#F1F5F9',
                            drawBorder: false
                        }
                    }
                }
            }
        });
    }

    renderDashboard(INITIAL_DASHBOARD);
});

function renderTrend(elementId, trend, subLabel) {
    const el = document.getElementById(elementId);
    if (!el) return;

    // Pas de période de comparaison (filtre « Tous ») : aucune tendance affichée plutôt qu'une valeur inventée
    if (!trend || !subLabel) {
        el.className = 'kpi-metric-trend';
        el.innerHTML = '';
        return;
    }

    el.className = 'kpi-metric-trend ' + trend.css_class;
    el.innerHTML = `
        <i class="bi ${escapeHtml(trend.icon)}"></i>
        <span>${escapeHtml(trend.label)}</span>
        <span class="trend-sub">${escapeHtml(subLabel)}</span>
    `;
}

function renderDashboard(data) {
    if (!data || !data.success) return;

    document.getElementById('periodInfoText').textContent = data.period_info;

    // 1. KPI Cards + tendances
    const kpis = data.kpis;
    document.getElementById('kpiEnCours').textContent = kpis.en_cours;
    document.getElementById('kpiTotalActions').textContent = kpis.total_actions;
    document.getElementById('kpiTotalActionsDetail').textContent =
        `${kpis.actions_executees} exécutée${kpis.actions_executees > 1 ? 's' : ''} · ${kpis.total_actions - kpis.actions_executees} non terminée${(kpis.total_actions - kpis.actions_executees) > 1 ? 's' : ''}`;
    document.getElementById('kpiRetard').textContent = kpis.actions_en_retard;
    document.getElementById('kpiEcheances').textContent = kpis.echeances_this_week;
    document.getElementById('kpiTaux').textContent = (kpis.taux_execution_actions || 0) + '%';

    renderTrend('trendEnCours', kpis.trends.en_cours, kpis.trend_label);
    renderTrend('trendTotalActions', kpis.trends.total_actions, kpis.trend_label);
    renderTrend('trendRetard', kpis.trends.actions_en_retard, kpis.trend_label);
    renderTrend('trendEcheances', kpis.trends.echeances, 'vs semaine précédente');
    renderTrend('trendTaux', kpis.trends.taux_execution, kpis.trend_label);

    // 2. Donut Chart & Légende
    const charts = data.charts;
    if (statutsDonutChartInstance) {
        statutsDonutChartInstance.data.labels = charts.statuts.labels;
        statutsDonutChartInstance.data.datasets[0].data = charts.statuts.data;
        statutsDonutChartInstance.data.datasets[0].backgroundColor = charts.statuts.colors;
        statutsDonutChartInstance.update();
    }

    document.getElementById('donutTotalCount').textContent = charts.total_instructions_count;

    const donutLegendCustom = document.getElementById('donutLegendCustom');
    if (charts.statuts_detailed.length > 0) {
        donutLegendCustom.innerHTML = charts.statuts_detailed.map(item => `
            <div class="donut-legend-row">
                <span class="legend-color-dot" style="background-color: ${escapeHtml(item.color)};"></span>
                <span class="legend-text-label">${escapeHtml(item.libelle)}</span>
                <span class="legend-count-val">${item.total}</span>
                <span class="legend-pct-val">${item.percent}%</span>
            </div>
        `).join('');
    } else {
        donutLegendCustom.innerHTML = emptyState('bi-pie-chart', 'Aucune instruction pour cette sélection');
    }

    // 3. Line Chart (série complète) & badge du taux actuel
    if (executionLineChartInstance) {
        executionLineChartInstance.data.labels = charts.monthly_rates.labels;
        executionLineChartInstance.data.datasets[0].data = charts.monthly_rates.data;
        executionLineChartInstance.update();
    }
    document.getElementById('chartPeakBadge').textContent = Math.round(charts.monthly_rates.current_rate || 0) + '%';

    // 4. Tableau des actions prioritaires
    const tbody = document.getElementById('priorityActionsTbody');
    if (data.actions.length > 0) {
        tbody.innerHTML = data.actions.map((act, index) => {
            const instUrl = act.instruction_url || act.url;
            const refText = act.instruction_reference || act.reference;
            const titleText = act.instruction_objet || act.libelle;
            const dateClass = act.is_en_retard ? 'text-danger font-bold' : '';

            return `
                <tr>
                    <td class="col-index">${index + 1}</td>
                    <td class="col-instruction">
                        <a href="${instUrl}" class="inst-ref-link">${escapeHtml(refText)}</a>
                        <div class="inst-sub-title" title="${escapeHtml(act.libelle)}">
                            ${escapeHtml(titleText)}
                        </div>
                    </td>
                    <td class="col-entity">
                        <div class="entity-code-bold">${escapeHtml(act.entite_code)}</div>
                        <div class="entity-name-sub">${escapeHtml(act.entite_nom)}</div>
                    </td>
                    <td class="col-date ${dateClass}">
                        ${escapeHtml(act.date_echeance)}
                    </td>
                    <td class="col-status">
                        <span class="modern-badge ${escapeHtml(act.statut.class)}">${escapeHtml(act.statut.label)}</span>
                    </td>
                    <td class="col-priority">
                        <span class="modern-badge ${escapeHtml(act.priorite.class)}">${escapeHtml(act.priorite.label)}</span>
                    </td>
                    <td class="col-actions">
                        <a href="${escapeHtml(act.url)}" class="btn-dots-menu" title="Voir les détails">
                            <i class="bi bi-three-dots"></i>
                        </a>
                    </td>
                </tr>
            `;
        }).join('');
    } else {
        tbody.innerHTML = emptyState('bi-inbox', 'Aucune action en cours pour ces filtres', 7);
    }

    // 5. Liste À suivre (échéances)
    const upcomingAgendaList = document.getElementById('upcomingAgendaList');
    if (data.echeances.length > 0) {
        upcomingAgendaList.innerHTML = data.echeances.map(ech => `
            <a href="${escapeHtml(ech.url)}" class="agenda-item" style="text-decoration: none; color: inherit;">
                <div class="calendar-date-box ${escapeHtml(ech.date_class)}">
                    <span class="date-day">${escapeHtml(ech.date_day)}</span>
                    <span class="date-month">${escapeHtml(ech.date_month)}</span>
                </div>
                <div class="agenda-meta">
                    <h4 class="agenda-task-title" title="${escapeHtml(ech.libelle)}">${escapeHtml(ech.libelle)}</h4>
                    <span class="agenda-entity-code">${escapeHtml(ech.entite_code)}</span>
                </div>
                <div class="agenda-status-pill">
                    <span class="modern-badge ${escapeHtml(ech.status_class)}">${escapeHtml(ech.status_label)}</span>
                </div>
            </a>
        `).join('');
    } else {
        upcomingAgendaList.innerHTML = emptyState('bi-calendar-check', 'Aucune échéance à venir pour cette sélection');
    }

    // 6. Activités récentes (journal historique)
    const feed = document.getElementById('recentActivitiesFeed');
    if (data.activities.length > 0) {
        feed.innerHTML = data.activities.map(act => {
            let subject = '';
            if (act.subject) {
                const strong = `<strong>${escapeHtml(act.subject)}</strong>`;
                subject = (act.url ? `<a href="${escapeHtml(act.url)}">${strong}</a>` : strong) + ' — ';
            }
            return `
                <div class="timeline-feed-item">
                    <div class="timeline-icon-circle ${escapeHtml(act.icon_class)}">
                        <i class="bi ${escapeHtml(act.icon)}"></i>
                    </div>
                    <div class="timeline-content">
                        <p class="timeline-text">${subject}${escapeHtml(act.text)}</p>
                        ${act.actor ? `<div class="timeline-actor">par ${escapeHtml(act.actor)}</div>` : ''}
                        <div class="timeline-time">${escapeHtml(act.time)}</div>
                    </div>
                </div>
            `;
        }).join('');
    } else {
        feed.innerHTML = emptyState('bi-clock-history', 'Aucune activité récente pour cette sélection');
    }
}

function showRangeError(message) {
    const el = document.getElementById('customRangeError');
    el.textContent = message || '';
    el.hidden = !message;
}

function onPeriodeChange() {
    const isCustom = document.getElementById('filterPeriode').value === 'custom';
    document.getElementById('customRangeBox').hidden = !isCustom;
    showRangeError(null);

    if (isCustom) {
        // On attend que l'utilisateur choisisse ses dates puis clique « Appliquer »
        document.getElementById('filterDu').focus();
        return;
    }
    applyFilters();
}

function applyFilters() {
    const entiteSelect = document.getElementById('filterEntite');
    const periodeSelect = document.getElementById('filterPeriode');
    const entite = entiteSelect ? entiteSelect.value : '';
    const periode = periodeSelect ? periodeSelect.value : 'all';

    const params = new URLSearchParams();
    if (periode === 'custom') {
        const du = document.getElementById('filterDu').value;
        const au = document.getElementById('filterAu').value;
        if (!du || !au) {
            showRangeError('Choisissez une date de début et de fin.');
            return;
        }
        if (du > au) {
            showRangeError('La date de début doit précéder la date de fin.');
            return;
        }
        showRangeError(null);
        params.append('periode', 'custom');
        params.append('du', du);
        params.append('au', au);
    } else if (periode && periode !== 'all') {
        params.append('periode', periode);
    }
    if (entite) params.append('entite_id', entite);

    // Bouton de réinitialisation
    const btnReset = document.getElementById('btnResetFilters');
    if (btnReset) {
        btnReset.style.display = (periode !== 'all' || entite !== '') ? 'inline-flex' : 'none';
    }

    // Indicateur de chargement
    const loadingBadge = document.getElementById('filterLoadingBadge');
    const dynamicContainer = document.getElementById('dashboardDynamicContainer');
    if (loadingBadge) loadingBadge.style.display = 'inline-flex';
    if (dynamicContainer) dynamicContainer.classList.add('is-loading');

    // Requête AJAX
    fetch('{{ path('app_dashboard_api') }}?' + params.toString(), {
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        }
    })
    .then(response => response.json().then(data => {
        if (!response.ok) {
            throw new Error(data.message || ('Erreur HTTP ' + response.status));
        }
        return data;
    }))
    .then(renderDashboard)
    .catch(err => {
        console.error('Erreur lors du filtrage dynamique:', err);
        if (periode === 'custom') showRangeError(err.message);
    })
    .finally(() => {
        if (loadingBadge) loadingBadge.style.display = 'none';
        if (dynamicContainer) dynamicContainer.classList.remove('is-loading');
    });
}

function resetFilters() {
    const filterPeriode = document.getElementById('filterPeriode');
    const filterEntite = document.getElementById('filterEntite');
    if (filterPeriode) filterPeriode.value = 'all';
    if (filterEntite) filterEntite.value = '';
    document.getElementById('customRangeBox').hidden = true;
    showRangeError(null);
    applyFilters();
}
</script>
{% endblock %}

