                        </div>
                    </div>

                    <!-- Item 3: Comment -->
                    <div class="timeline-feed-item">
                        <div class="timeline-icon-circle disc-gray">
                            <i class="bi bi-chat-left-text"></i>
                        </div>
                        <div class="timeline-content">
                            <p class="timeline-text">
                                Nouveau commentaire sur <strong>INS-2026-031</strong>
                            </p>
                            <div class="timeline-actor">par Patrick Lemba (DGJ)</div>
