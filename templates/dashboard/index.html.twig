                    <!-- Item 1: Instruction updated -->
                    <div class="timeline-feed-item">
                        <div class="timeline-icon-circle disc-blue">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <div class="timeline-content">
                            <p class="timeline-text">
                                <strong>Instruction INS-2026-058</strong> mise à jour
                            </p>
