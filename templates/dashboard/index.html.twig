{% extends 'base.html.twig' %}

{% block title %}Cockpit Exécutif - Tableau de bord{% endblock %}

{% block body %}
<!-- Top Header & Actions -->
<div class="page-header" style="align-items: flex-start; margin-bottom: 24px;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            <span class="badge badge-gold" style="font-size: 0.72rem; letter-spacing: 0.8px; font-weight: 700;">BANQUE CENTRALE DU CONGO</span>
            <span class="badge badge-secondary" style="font-size: 0.72rem;"><i class="bi bi-shield-check" style="color: var(--color-success);"></i> Cockpit Opérationnel</span>
        </div>
        <h2 class="page-title" style="font-size: 1.6rem; margin-bottom: 4px;">Tableau de Bord Exécutif</h2>
        <p class="page-subtitle">Supervision et pilotage des Ordres de Service, Décisions et Instructions du Gouverneur</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: center;">
        <form action="{{ path('app_relance_trigger_engine') }}" method="post" style="margin: 0;">
            <button type="submit" class="btn btn-secondary btn-sm" title="Vérifier et déclencher les alertes d'échéances automatiques">
                <i class="bi bi-bell-fill" style="color: var(--actis-accent);"></i> Scanner les Échéances
            </button>
        </form>
        <a href="{{ path('app_action_new') }}" class="btn btn-secondary btn-sm">
            <i class="bi bi-check2-square"></i> Nouvelle Action
        </a>
        <a href="{{ path('app_instruction_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle-fill"></i> Nouvelle Instruction
        </a>
    </div>
</div>

<!-- Dashboard KPI Section (Option 1 : Cockpit Hiérarchisé) -->
<div class="dashboard-kpi-container">
    <!-- Left Hero Card: Executive Performance Index -->
    <div class="kpi-hero-card">
        <div>
            <div class="kpi-hero-header">
                <span class="kpi-hero-badge"><i class="bi bi-speedometer2"></i> Indice Global</span>
                <span style="font-size: 0.72rem; color: rgba(255,255,255,0.6);"><i class="bi bi-activity"></i> En temps réel</span>
            </div>
            <div class="kpi-hero-value-wrapper">
                <div class="kpi-hero-rate">{{ kpis.taux_avancement_moyen }}<span>%</span></div>
                <div class="kpi-hero-label">Taux d'Avancement Moyen</div>
            </div>
            <div class="kpi-hero-progress">
                <div class="kpi-hero-progress-bar" style="width: {{ kpis.taux_avancement_moyen }}%;"></div>
            </div>
        </div>

        <div class="kpi-hero-footer">
            <div class="kpi-hero-stat-box">
                <i class="bi bi-journal-bookmark"></i>
                <div>
                    <div class="stat-num">{{ kpis.total_instructions }}</div>
                    <div class="stat-desc">Instructions</div>
                </div>
            </div>
            <div class="kpi-hero-stat-box">
                <i class="bi bi-layers"></i>
                <div>
                    <div class="stat-num">{{ kpis.total_actions }}</div>
                    <div class="stat-desc">Actions</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Grid: 4 Operational Status Cards -->
    <div class="kpi-status-grid">
        <!-- 1. Nouvelles -->
        <a href="{{ path('app_instruction_index', {'statut': 'NOUVELLE'}) }}" class="kpi-status-card active-amber" title="Voir les instructions à affecter">
            <div>
                <div class="kpi-status-header">
                    <span class="kpi-status-title">Nouvelles</span>
                    <div class="kpi-status-icon">
                        <i class="bi bi-inbox-fill"></i>
                    </div>
                </div>
                <div class="kpi-status-num">{{ kpis.nouvelles }}</div>
            </div>
            <div class="kpi-status-hint">
                <i class="bi bi-clock-history"></i> À affecter
            </div>
        </a>

        <!-- 2. En cours -->
        <a href="{{ path('app_instruction_index', {'statut': 'EN_COURS'}) }}" class="kpi-status-card active-purple" title="Voir les instructions en cours">
            <div>
                <div class="kpi-status-header">
                    <span class="kpi-status-title">En cours</span>
                    <div class="kpi-status-icon">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                </div>
                <div class="kpi-status-num">{{ kpis.en_cours }}</div>
            </div>
            <div class="kpi-status-hint">
                <i class="bi bi-cpu"></i> {{ kpis.actions_en_cours }} actions actives
            </div>
        </a>

        <!-- 3. Exécutées -->
        <a href="{{ path('app_instruction_index', {'statut': 'EXECUTEE'}) }}" class="kpi-status-card active-emerald" title="Voir les instructions exécutées ou clôturées">
            <div>
                <div class="kpi-status-header">
                    <span class="kpi-status-title">Exécutées</span>
                    <div class="kpi-status-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
                <div class="kpi-status-num">{{ kpis.finalisees }}</div>
            </div>
            <div class="kpi-status-hint" style="color: var(--color-success); font-weight: 600;">
                <i class="bi bi-check2-all"></i> {{ kpis.actions_executees }} achevées
            </div>
        </a>

        <!-- 4. En retard -->
        <a href="{{ path('app_instruction_index', {'retard': '1'}) }}" class="kpi-status-card active-rose {% if kpis.en_retard > 0 or kpis.actions_en_retard > 0 %}pulse-danger{% endif %}" title="Voir les alertes et retards">
            <div>
                <div class="kpi-status-header">
                    <span class="kpi-status-title">En retard</span>
                    <div class="kpi-status-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
                <div class="kpi-status-num">{{ kpis.en_retard }}</div>
            </div>
            <div class="kpi-status-hint" style="color: var(--color-danger); font-weight: 600;">
                <i class="bi bi-alarm"></i> {{ kpis.actions_en_retard }} actions hors délais
            </div>
        </a>
    </div>
</div>

<!-- Section: Mes Actions / Mon Espace Point Focal (si applicable) -->
{% if myPendingActions is defined and myPendingActions|length > 0 %}
<div class="card" style="margin-bottom: 24px; border-left: 4px solid var(--actis-primary); background: linear-gradient(180deg, #FFFFFF 0%, #F0FDFA 100%);">
    <div class="card-header" style="background: transparent;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-person-workspace" style="color: var(--actis-primary); font-size: 1.2rem;"></i>
            <h3 class="card-title" style="margin: 0; font-size: 1.05rem;">Mon Espace de Travail — Mes Actions Assignées</h3>
        </div>
        <a href="{{ path('app_action_index', {'my_actions': '1'}) }}" class="btn btn-secondary btn-sm" style="font-size: 0.76rem;">
            Toutes mes actions ({{ myPendingActions|length }}) <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    <div class="card-body" style="padding: 12px 20px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px;">
            {% for act in myPendingActions %}
                <div style="padding: 14px 16px; background: #FFFFFF; border: 1px solid var(--border-color); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                            <span class="badge badge-secondary" style="font-size: 0.72rem; font-weight: 700;">{{ act.reference ?: 'Action #' ~ act.id }}</span>
                            <span class="badge {{ act.statut ? act.statut.badgeClass : 'badge-secondary' }}">{{ act.statut ? act.statut.libelle : 'Non défini' }}</span>
                        </div>
                        <div style="font-weight: 600; color: var(--bcc-navy); font-size: 0.88rem; margin-bottom: 6px; line-height: 1.35;">
                            {{ act.libelle }}
                        </div>
                        <div style="font-size: 0.76rem; color: var(--text-secondary); margin-bottom: 10px;">
                            <i class="bi bi-journal-text"></i> {{ act.instruction ? act.instruction.reference : '-' }}
                        </div>
                    </div>
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; margin-bottom: 4px;">
                            <span style="color: var(--text-muted);">Avancement</span>
                            <strong>{{ act.tauxAvancement }}%</strong>
                        </div>
                        <div class="progress-bar-container" style="height: 5px; margin-bottom: 10px;">
                            <div class="progress-bar-fill {% if act.tauxAvancement >= 80 %}success{% elseif act.tauxAvancement >= 40 %}warning{% else %}danger{% endif %}" style="width: {{ act.tauxAvancement }}%;"></div>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 8px; border-top: 1px dashed var(--border-light);">
                            <span style="font-size: 0.75rem; color: {% if act.isEnRetard %}var(--color-danger); font-weight: 700;{% else %}var(--text-secondary);{% endif %}">
                                <i class="bi bi-calendar3"></i> Échéance : {{ act.dateEcheance ? act.dateEcheance|date('d/m/Y') : '-' }}
                            </span>
                            <a href="{{ path('app_action_avancement', {'id': act.id}) }}" class="btn btn-primary btn-sm" style="padding: 3px 9px; font-size: 0.72rem;">
                                <i class="bi bi-sliders"></i> Mettre à jour
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

<!-- Analytics Charts Row (3 Charts) -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <!-- Chart 1: Statuts -->
    <div class="card" style="margin-bottom: 0;">
        <div class="card-header">
            <h3 class="card-title" style="font-size: 0.95rem;">
                <i class="bi bi-pie-chart-fill" style="color: var(--actis-primary);"></i> Répartition par Statut
            </h3>
        </div>
        <div class="card-body">
            <div style="height: 220px; position: relative;">
                <canvas id="statutsChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Priorités -->
    <div class="card" style="margin-bottom: 0;">
        <div class="card-header">
            <h3 class="card-title" style="font-size: 0.95rem;">
                <i class="bi bi-bar-chart-fill" style="color: var(--actis-primary);"></i> Répartition par Priorité
            </h3>
        </div>
        <div class="card-body">
            <div style="height: 220px; position: relative;">
                <canvas id="prioritesChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 3: Types d'Instructions -->
    <div class="card" style="margin-bottom: 0;">
        <div class="card-header">
            <h3 class="card-title" style="font-size: 0.95rem;">
                <i class="bi bi-diagram-3-fill" style="color: var(--color-purple);"></i> Nature des Actes & Décisions
            </h3>
        </div>
        <div class="card-body">
            <div style="height: 220px; position: relative;">
                <canvas id="typesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Performance Matrix by Direction -->
<div class="card" style="margin-bottom: 24px;">
    <div class="card-header" style="flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <i class="bi bi-building-check" style="color: var(--actis-primary); font-size: 1.25rem;"></i>
            <div>
                <h3 class="card-title" style="margin: 0; font-size: 1.05rem;">Performance d'Exécution par Direction / Entité</h3>
                <small style="color: var(--text-muted); font-size: 0.75rem;">Suivi des taux d'avancement et des retards par structure responsable</small>
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
            <div style="position: relative; width: 240px;">
                <i class="bi bi-search" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.8rem;"></i>
                <input type="text" id="filterDirectionTable" class="form-control form-control-sm" placeholder="Filtrer une direction (ex: DSI)..." style="padding-left: 28px; font-size: 0.8rem;">
            </div>
            <span class="badge badge-info">{{ performanceDirections|length }} Directions actives</span>
        </div>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table" id="directionsPerformanceTable">
                <thead>
                    <tr>
                        <th>Direction / Entité</th>
                        <th>Type</th>
                        <th style="text-align: center;">Total Décisions</th>
                        <th style="text-align: center;">Exécutées</th>
                        <th style="text-align: center;">En cours</th>
                        <th style="text-align: center;">En retard</th>
                        <th style="width: 200px;">Taux Moyen Actions</th>
                        <th style="text-align: right;">Détail</th>
                    </tr>
                </thead>
                <tbody>
                    {% for perf in performanceDirections %}
                        <tr class="direction-row">
                            <td>
                                <span class="badge badge-primary" style="font-weight: 800; font-size: 0.75rem; margin-right: 6px;">{{ perf.code }}</span>
                                <span class="direction-name" style="font-weight: 600; color: var(--bcc-navy);">{{ perf.nom }}</span>
                            </td>
                            <td><span class="badge badge-secondary" style="font-size: 0.72rem;">{{ perf.type_entite }}</span></td>
                            <td style="text-align: center; font-weight: 700; font-size: 0.95rem;">{{ perf.total_instructions }}</td>
                            <td style="text-align: center; color: var(--color-success); font-weight: 700;">{{ perf.instructions_executees }}</td>
                            <td style="text-align: center; color: var(--color-purple); font-weight: 700;">{{ perf.instructions_en_cours }}</td>
                            <td style="text-align: center;">
                                {% if perf.instructions_en_retard > 0 %}
                                    <span class="badge badge-danger pulse-danger" style="font-weight: 700;">{{ perf.instructions_en_retard }}</span>
                                {% else %}
                                    <span class="badge badge-success" style="opacity: 0.75;">0</span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <div class="progress-bar-container" style="flex: 1; height: 7px;">
                                        <div class="progress-bar-fill {% if perf.taux_moyen_actions >= 80 %}success{% elseif perf.taux_moyen_actions >= 40 %}warning{% else %}danger{% endif %}" style="width: {{ perf.taux_moyen_actions }}%;"></div>
                                    </div>
                                    <span style="font-size: 0.8rem; font-weight: 700; min-width: 42px; text-align: right;">{{ perf.taux_moyen_actions }}%</span>
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <a href="{{ path('app_instruction_index', {'entite': perf.id}) }}" class="btn btn-secondary btn-sm" style="padding: 3px 9px; font-size: 0.75rem;" title="Voir les instructions de cette direction">
                                    <i class="bi bi-eye"></i> Explorer
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 28px; color: var(--text-muted);">
                                Aucune entité trouvée.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bottom Radar Row: Upcoming Deadlines & Recent Instructions -->
<div class="grid-2">
    <!-- Upcoming Deadlines -->
    <div class="card" style="margin-bottom: 0;">
        <div class="card-header">
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-calendar-event-fill" style="color: var(--color-danger); font-size: 1.1rem;"></i>
                <h3 class="card-title" style="margin: 0; font-size: 1.02rem;">Échéances Imminentes & Alertes (7 jours)</h3>
            </div>
            <a href="{{ path('app_action_index', {'retard': '1'}) }}" class="badge badge-danger" style="font-size: 0.74rem;">
                <i class="bi bi-alarm"></i> Voir retards
            </a>
        </div>
        <div class="card-body" style="padding: 10px 20px;">
            {% for act in upcomingEcheances %}
                <div style="padding: 12px 0; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                    <div style="min-width: 0; flex: 1;">
                        <div style="font-weight: 600; color: var(--bcc-navy); font-size: 0.88rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            {{ act.libelle }}
                        </div>
                        <div style="font-size: 0.77rem; color: var(--text-secondary); margin-top: 3px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                            <span class="badge badge-secondary" style="font-size: 0.7rem;">{{ act.instruction ? act.instruction.reference : '-' }}</span>
                            <span style="color: var(--text-muted);">&bull;</span>
                            <span>Direction : <strong>{{ act.entiteResponsable ? act.entiteResponsable.code : '-' }}</strong></span>
                            {% if act.responsable %}
                                <span style="color: var(--text-muted);">&bull;</span>
                                <span>Point Focal : <strong>{{ act.responsable.nomComplet }}</strong></span>
                            {% endif %}
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <span class="badge {% if act.isEnRetard %}badge-danger pulse-danger{% else %}badge-warning{% endif %}" style="font-size: 0.75rem;">
                            <i class="bi bi-clock"></i> {{ act.dateEcheance ? act.dateEcheance|date('d/m/Y') : '-' }}
                        </span>
                        <div style="margin-top: 4px;">
                            <a href="{{ path('app_action_show', {'id': act.id}) }}" class="btn btn-secondary btn-sm" style="padding: 2px 8px; font-size: 0.72rem;">
                                Suivre <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div style="padding: 32px 16px; text-align: center; color: var(--text-muted);">
                    <i class="bi bi-check-circle" style="font-size: 2.2rem; color: var(--color-success);"></i>
                    <p style="margin-top: 8px; font-size: 0.88rem;">Aucune échéance critique dans les 7 prochains jours.</p>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Recent Instructions -->
    <div class="card" style="margin-bottom: 0;">
        <div class="card-header">
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-clock-history" style="color: var(--actis-primary); font-size: 1.1rem;"></i>
                <h3 class="card-title" style="margin: 0; font-size: 1.02rem;">Dernières Instructions Enregistrées</h3>
            </div>
            <a href="{{ path('app_instruction_index') }}" class="btn btn-secondary btn-sm" style="font-size: 0.74rem;">
                Toutes <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="card-body" style="padding: 10px 20px;">
            {% for inst in recentInstructions %}
                <div style="padding: 12px 0; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                    <div style="min-width: 0; flex: 1;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 3px; flex-wrap: wrap;">
                            <strong style="color: var(--bcc-navy); font-size: 0.85rem;">{{ inst.reference }}</strong>
                            <span class="badge {{ inst.statut ? inst.statut.badgeClass : 'badge-secondary' }}" style="font-size: 0.7rem;">
                                {{ inst.statut ? inst.statut.libelle : '-' }}
                            </span>
                            {% if inst.priorite %}
                                <span class="badge badge-secondary" style="font-size: 0.68rem;">{{ inst.priorite.libelle }}</span>
                            {% endif %}
                        </div>
                        <div style="font-size: 0.82rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            {{ inst.objet }}
                        </div>
                        <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">
                            Direction Pilote : <strong>{{ inst.entitePilote ? inst.entitePilote.code : '-' }}</strong>
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <div style="font-weight: 800; font-size: 0.95rem; color: var(--actis-accent); font-family: 'Inter', sans-serif;">
                            {{ inst.tauxAvancement }}%
                        </div>
                        <a href="{{ path('app_instruction_show', {'id': inst.id}) }}" class="btn btn-secondary btn-sm" style="padding: 2px 8px; font-size: 0.72rem; margin-top: 4px;">
                            Cockpit 360°
                        </a>
                    </div>
                </div>
            {% else %}
                <div style="padding: 32px 16px; text-align: center; color: var(--text-muted);">
                    <i class="bi bi-inbox" style="font-size: 2.2rem;"></i>
                    <p style="margin-top: 8px; font-size: 0.88rem;">Aucune instruction enregistrée.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // ── 1. Live Instant Search for Performance Matrix ──
    const searchInput = document.getElementById('filterDirectionTable');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#directionsPerformanceTable tbody tr.direction-row');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });
    }

    // ── 2. Statuts Doughnut Chart ──
    const ctxStatut = document.getElementById('statutsChart');
    if (ctxStatut) {
        new Chart(ctxStatut.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: {{ charts.statuts.labels|json_encode|raw }},
                datasets: [{
                    data: {{ charts.statuts.data|json_encode|raw }},
                    backgroundColor: ['#2563EB', '#059669', '#D97706', '#DC2626', '#7C3AED', '#64748B', '#0284C7'],
                    borderWidth: 3,
                    borderColor: '#FFFFFF',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            boxWidth: 10,
                            padding: 8,
                            font: { family: 'Inter', size: 10, weight: 600 }
                        }
                    },
                    tooltip: {
                        padding: 10,
                        cornerRadius: 8
                    }
                }
            }
        });
    }

    // ── 3. Priorités Bar Chart ──
    const ctxPriorite = document.getElementById('prioritesChart');
    if (ctxPriorite) {
        new Chart(ctxPriorite.getContext('2d'), {
            type: 'bar',
            data: {
                labels: {{ charts.priorites.labels|json_encode|raw }},
                datasets: [{
                    label: 'Instructions',
                    data: {{ charts.priorites.data|json_encode|raw }},
                    backgroundColor: ['#DC2626', '#EA580C', '#0D9488', '#94A3B8'],
                    borderRadius: 6,
                    barThickness: 22
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#F1F5F9' },
                        ticks: { stepSize: 1, font: { family: 'Inter', size: 10 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: 'Inter', size: 10, weight: 600 } }
                    }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: { padding: 10, cornerRadius: 8 }
                }
            }
        });
    }

    // ── 4. Types d'Actes Polar/Bar Chart ──
    const ctxType = document.getElementById('typesChart');
    if (ctxType) {
        new Chart(ctxType.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: {{ charts.types.labels|json_encode|raw }},
                datasets: [{
                    data: {{ charts.types.data|json_encode|raw }},
                    backgroundColor: ['#0D9488', '#B87333', '#0284C7', '#059669', '#7C3AED'],
                    borderWidth: 3,
                    borderColor: '#FFFFFF',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            boxWidth: 10,
                            padding: 8,
                            font: { family: 'Inter', size: 10, weight: 600 }
                        }
                    },
                    tooltip: { padding: 10, cornerRadius: 8 }
                }
            }
        });
    }
});
</script>
{% endblock %}
