{% block javascripts %}
<script>
let statutsDonutChartInstance = null;
let executionLineChartInstance = null;

function escapeHtml(text) {
    if (!text) return '';
    return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

document.addEventListener('DOMContentLoaded', function() {
    // ── 1. Donut Chart: Instructions par statut ──
    const donutCtx = document.getElementById('statutsDonutChart');
    if (donutCtx) {
        statutsDonutChartInstance = new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: {{ charts.statuts.labels|json_encode|raw }},
                datasets: [{
                    data: {{ charts.statuts.data|json_encode|raw }},
                    backgroundColor: {{ charts.statuts.colors|json_encode|raw }},
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverOffset: 4,
                    cutout: '68%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const val = context.parsed || 0;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = total > 0 ? Math.round((val / total) * 100) : 0;
                                return ` ${context.label}: ${val} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    // ── 2. Line Chart: Évolution du taux d'exécution ──
    const lineCtx = document.getElementById('executionLineChart');
    if (lineCtx) {
        const labels = {{ charts.monthly_rates.labels|json_encode|raw }};
        const dataValues = {{ charts.monthly_rates.data|json_encode|raw }};

        const gradient = lineCtx.getContext('2d').createLinearGradient(0, 0, 0, 220);
        gradient.addColorStop(0, 'rgba(13, 71, 161, 0.22)');
        gradient.addColorStop(1, 'rgba(13, 71, 161, 0.01)');

        executionLineChartInstance = new Chart(lineCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: "Taux d'exécution",
                    data: dataValues,
                    borderColor: '#0A2540',
                    borderWidth: 2.5,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.35,
                    pointRadius: [3, 3, 3, 3, 3, 3, 3, 3, 5],
                    pointBackgroundColor: '#0A2540',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return ` Taux: ${context.parsed.y}%`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#64748B',
                            font: {
                                size: 11,
                                family: "'Inter', sans-serif"
                            }
                        }
                    },
                    y: {
                        min: 0,
                        max: 100,
                        ticks: {
                            stepSize: 20,
                            callback: function(val) {
                                return val + '%';
                            },
                            color: '#64748B',
                            font: {
                                size: 11,
                                family: "'Inter', sans-serif"
                            }
                        },
                        grid: {
                            color: '#F1F5F9',
                            drawBorder: false
                        }
                    }
                }
            }
        });
    }
});

function applyFilters() {
    const entiteSelect = document.getElementById('filterEntite');
    const periodeSelect = document.getElementById('filterPeriode');
    const entite = entiteSelect ? entiteSelect.value : '';
    const periode = periodeSelect ? periodeSelect.value : 'all';

    // Bouton de réinitialisation
    const btnReset = document.getElementById('btnResetFilters');
    if (btnReset) {
        btnReset.style.display = (periode !== 'all' || entite !== '') ? 'inline-flex' : 'none';
    }

    // Indicateur de chargement
    const loadingBadge = document.getElementById('filterLoadingBadge');
    const dynamicContainer = document.getElementById('dashboardDynamicContainer');
    if (loadingBadge) loadingBadge.style.display = 'inline-flex';
    if (dynamicContainer) dynamicContainer.classList.add('is-loading');

    // Requête AJAX
    const params = new URLSearchParams();
    if (periode && periode !== 'all') params.append('periode', periode);
    if (entite) params.append('entite_id', entite);

    fetch('/api/dashboard?' + params.toString(), {
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        }
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Erreur HTTP ' + response.status);
        }
        return response.json();
    })
    .then(data => {
        if (!data.success) return;

        // 1. Mise à jour des 4 KPI Cards
        const kpiEnCours = document.getElementById('kpiEnCours');
        const kpiRetard = document.getElementById('kpiRetard');
        const kpiEcheances = document.getElementById('kpiEcheances');
        const kpiTaux = document.getElementById('kpiTaux');

        if (kpiEnCours) kpiEnCours.textContent = data.kpis.en_cours;
        if (kpiRetard) kpiRetard.textContent = data.kpis.actions_en_retard;
        if (kpiEcheances) kpiEcheances.textContent = data.echeances.length;
        if (kpiTaux) kpiTaux.textContent = (data.kpis.taux_execution_actions || 0) + '%';

        // 2. Mise à jour Donut Chart & Légende
        if (statutsDonutChartInstance && data.charts && data.charts.statuts) {
            statutsDonutChartInstance.data.labels = data.charts.statuts.labels;
            statutsDonutChartInstance.data.datasets[0].data = data.charts.statuts.data;
            statutsDonutChartInstance.data.datasets[0].backgroundColor = data.charts.statuts.colors;
            statutsDonutChartInstance.update();
        }

        const donutTotalCount = document.getElementById('donutTotalCount');
        if (donutTotalCount && data.charts) {
            donutTotalCount.textContent = data.charts.total_instructions_count;
        }

        const donutLegendCustom = document.getElementById('donutLegendCustom');
        if (donutLegendCustom && data.charts && data.charts.statuts_detailed) {
            let legendHtml = '';
            data.charts.statuts_detailed.forEach(item => {
                legendHtml += `
                    <div class="donut-legend-row">
                        <span class="legend-color-dot" style="background-color: ${escapeHtml(item.color)};"></span>
                        <span class="legend-text-label">${escapeHtml(item.libelle)}</span>
                        <span class="legend-count-val">${item.total}</span>
                        <span class="legend-pct-val">${item.percent}%</span>
                    </div>
                `;
            });
            donutLegendCustom.innerHTML = legendHtml;
        }

        // 3. Mise à jour Line Chart & Badge de crête
        if (executionLineChartInstance && data.charts && data.charts.monthly_rates) {
            const currentRate = Math.round(data.charts.monthly_rates.current_rate || 0);
            const dataset = executionLineChartInstance.data.datasets[0];
            dataset.data[dataset.data.length - 1] = currentRate;
            executionLineChartInstance.update();

            const peakBadge = document.getElementById('chartPeakBadge');
            if (peakBadge) {
                peakBadge.textContent = currentRate + '%';
            }
        }

        // 4. Mise à jour du tableau des actions prioritaires
        const tbody = document.getElementById('priorityActionsTbody');
        if (tbody) {
            if (data.actions && data.actions.length > 0) {
                let rowsHtml = '';
                data.actions.forEach((act, index) => {
                    const instUrl = act.instruction_id ? `/instruction/${act.instruction_id}` : `/action/${act.id}`;
                    const refText = act.instruction_reference || act.reference;
                    const titleText = act.instruction_objet || act.libelle;
                    const dateClass = act.is_en_retard ? 'text-danger font-bold' : '';

                    rowsHtml += `
                        <tr>
                            <td class="col-index">${index + 1}</td>
                            <td class="col-instruction">
                                <a href="${instUrl}" class="inst-ref-link">${escapeHtml(refText)}</a>
                                <div class="inst-sub-title" title="${escapeHtml(titleText)}">
                                    ${escapeHtml(titleText)}
                                </div>
                            </td>
                            <td class="col-entity">
                                <div class="entity-code-bold">${escapeHtml(act.entite_code)}</div>
                                <div class="entity-name-sub">${escapeHtml(act.entite_nom)}</div>
                            </td>
                            <td class="col-date ${dateClass}">
                                ${escapeHtml(act.date_echeance)}
                            </td>
                            <td class="col-status">
                                <span class="modern-badge ${escapeHtml(act.statut.class)}">${escapeHtml(act.statut.label)}</span>
                            </td>
                            <td class="col-priority">
                                <span class="modern-badge ${escapeHtml(act.priorite.class)}">${escapeHtml(act.priorite.label)}</span>
                            </td>
                            <td class="col-actions">
                                <a href="/action/${act.id}" class="btn-dots-menu" title="Voir les détails">
                                    <i class="bi bi-three-dots"></i>
                                </a>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = rowsHtml;
            } else {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 32px 16px; color: #64748B;">
                            <i class="bi bi-inbox" style="font-size: 2rem; color: #CBD5E1; display: block; margin-bottom: 8px;"></i>
                            Aucune action prioritaire trouvée pour ces filtres
                        </td>
                    </tr>
                `;
            }
        }

        // 5. Mise à jour de la liste À suivre (Échéances)
        const upcomingAgendaList = document.getElementById('upcomingAgendaList');
        if (upcomingAgendaList) {
            if (data.echeances && data.echeances.length > 0) {
                let echeancesHtml = '';
                data.echeances.forEach(ech => {
                    echeancesHtml += `
                        <div class="agenda-item">
                            <div class="calendar-date-box ${escapeHtml(ech.date_class)}">
                                <span class="date-day">${escapeHtml(ech.date_day)}</span>
                                <span class="date-month">${escapeHtml(ech.date_month)}</span>
                            </div>
                            <div class="agenda-meta">
                                <h4 class="agenda-task-title">${escapeHtml(ech.libelle)}</h4>
                                <span class="agenda-entity-code">${escapeHtml(ech.entite_code)}</span>
                            </div>
                            <div class="agenda-status-pill">
                                <span class="modern-badge ${escapeHtml(ech.status_class)}">${escapeHtml(ech.status_label)}</span>
                            </div>
                        </div>
                    `;
                });
                upcomingAgendaList.innerHTML = echeancesHtml;
            } else {
                upcomingAgendaList.innerHTML = `
                    <div style="text-align: center; padding: 24px 12px; color: #64748B; font-size: 0.85rem;">
                        <i class="bi bi-calendar-check" style="font-size: 1.8rem; color: #CBD5E1; display: block; margin-bottom: 6px;"></i>
                        Aucune échéance à venir pour cette sélection
                    </div>
                `;
            }
        }
    })
    .catch(err => {
        console.error('Erreur lors du filtrage dynamique:', err);
    })
    .finally(() => {
        if (loadingBadge) loadingBadge.style.display = 'none';
        if (dynamicContainer) dynamicContainer.classList.remove('is-loading');
    });
}

function resetFilters() {
    const filterPeriode = document.getElementById('filterPeriode');
    const filterEntite = document.getElementById('filterEntite');
    if (filterPeriode) filterPeriode.value = 'all';
    if (filterEntite) filterEntite.value = '';
    applyFilters();
}
</script>
{% endblock %}
