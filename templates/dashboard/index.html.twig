    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // ── 1. Donut Chart: Instructions par statut ──
    const donutCtx = document.getElementById('statutsDonutChart');
    if (donutCtx) {
        new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: {{ charts.statuts.labels|json_encode|raw }},
                datasets: [{
                    data: {{ charts.statuts.data|json_encode|raw }},
                    backgroundColor: {{ charts.statuts.colors|json_encode|raw }},
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverOffset: 4,
                    cutout: '68%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false // Custom legend used on the right
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const val = context.parsed || 0;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = total > 0 ? Math.round((val / total) * 100) : 0;
                                return ` ${context.label}: ${val} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    // ── 2. Line Chart: Évolution du taux d'exécution ──
    const lineCtx = document.getElementById('executionLineChart');
    if (lineCtx) {
        const labels = {{ charts.monthly_rates.labels|json_encode|raw }};
        const dataValues = {{ charts.monthly_rates.data|json_encode|raw }};

        const gradient = lineCtx.getContext('2d').createLinearGradient(0, 0, 0, 220);
        gradient.addColorStop(0, 'rgba(13, 71, 161, 0.22)');
        gradient.addColorStop(1, 'rgba(13, 71, 161, 0.01)');

        new Chart(lineCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: "Taux d'exécution",
                    data: dataValues,
                    borderColor: '#0A2540',
                    borderWidth: 2.5,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.35, // Smooth curve
                    pointRadius: [3, 3, 3, 3, 3, 3, 3, 3, 5],
                    pointBackgroundColor: '#0A2540',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return ` Taux: ${context.parsed.y}%`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#64748B',
                            font: {
                                size: 11,
                                family: "'Inter', sans-serif"
                            }
                        }
                    },
                    y: {
                        min: 0,
                        max: 100,
                        ticks: {
                            stepSize: 20,
                            callback: function(val) {
                                return val + '%';
                            },
                            color: '#64748B',
                            font: {
                                size: 11,
                                family: "'Inter', sans-serif"
                            }
                        },
                        grid: {
                            color: '#F1F5F9',
                            drawBorder: false
                        }
                    }
                }
            }
        });
    }
});

function applyFilters() {
    const entite = document.getElementById('filterEntite').value;
    const periode = document.getElementById('filterPeriode').value;
    console.log('Filtres appliqués:', { entite, periode });
}
</script>
