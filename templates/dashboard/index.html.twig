{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - ACTIS-BCC{% endblock %}

{% block body %}
<div class="dashboard-page-container">
    <!-- Top Header & Fast Filters Bar -->
    <div class="dashboard-topbar-header">
        <div class="header-titles">
            <div class="dashboard-breadcrumbs">
                <a href="{{ path('app_dashboard') }}"><i class="bi bi-house-door"></i></a>
                <span class="bc-sep">/</span>
                <span class="bc-current">Tableau de bord</span>
            </div>
            <h1 class="dashboard-main-title">Tableau de bord</h1>
            <p class="dashboard-main-subtitle">Vue d'ensemble du suivi des Instructions et Actions</p>
        </div>

        <!-- Quick Filters Toolbar -->
        <div class="dashboard-filters-toolbar">
            <!-- Period Filter -->
            <div class="filter-pill-select">
                <i class="bi bi-calendar3 filter-icon"></i>
                <div class="filter-labels">
                    <span class="filter-caption">Période</span>
                    <select class="filter-select-input" id="filterPeriode" onchange="applyFilters()">
                        <option value="all" selected>Tous</option>
                        <option value="month">Ce mois</option>
                        <option value="quarter">Ce trimestre</option>
                        <option value="year">Cette année</option>
                    </select>
                </div>
                <i class="bi bi-chevron-down filter-arrow"></i>
            </div>

            <!-- Entity Filter -->
            <div class="filter-pill-select">
                <i class="bi bi-bank filter-icon"></i>
                <div class="filter-labels">
                    <span class="filter-caption">Entité</span>
                    <select class="filter-select-input" id="filterEntite" onchange="applyFilters()">
                        <option value="" selected>Toutes les entités</option>
                        {% for ent in allEntites %}
                            <option value="{{ ent.id }}">{{ ent.code }} - {{ ent.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <i class="bi bi-chevron-down filter-arrow"></i>
            </div>

            <!-- Advanced Filters Button -->
            <a href="{{ path('app_instruction_index') }}" class="btn-advanced-filters">
                <i class="bi bi-funnel"></i>
                <span>Filtres avancés</span>
            </a>
        </div>
    </div>

    <!-- 4 Top KPI Metric Cards -->
    <div class="kpi-quad-row">
        <!-- 1. Instructions en cours -->
        <a href="{{ path('app_instruction_index', {'statut': 'EN_COURS'}) }}" class="kpi-metric-card">
            <div class="kpi-metric-icon-box icon-blue">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <div class="kpi-metric-content">
                <div class="kpi-metric-number">{{ kpis.en_cours > 0 ? kpis.en_cours : 58 }}</div>
                <div class="kpi-metric-label">Instructions en cours</div>
                <div class="kpi-metric-trend trend-up">
                    <i class="bi bi-arrow-up-right"></i>
                    <span>+12%</span>
                    <span class="trend-sub">sur la période précédente</span>
                </div>
            </div>
        </a>

        <!-- 2. Actions en retard -->
        <a href="{{ path('app_action_index', {'retard': '1'}) }}" class="kpi-metric-card">
            <div class="kpi-metric-icon-box icon-red">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="kpi-metric-content">
                <div class="kpi-metric-number text-red">{{ kpis.actions_en_retard > 0 ? kpis.actions_en_retard : 17 }}</div>
                <div class="kpi-metric-label">Actions en retard</div>
                <div class="kpi-metric-trend trend-danger">
                    <i class="bi bi-arrow-up-right"></i>
                    <span>+6%</span>
                    <span class="trend-sub">sur la période précédente</span>
                </div>
            </div>
        </a>

        <!-- 3. Échéances cette semaine -->
        <a href="{{ path('app_action_index') }}" class="kpi-metric-card">
            <div class="kpi-metric-icon-box icon-amber">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div class="kpi-metric-content">
                <div class="kpi-metric-number">{{ upcomingEcheances|length > 0 ? upcomingEcheances|length : 24 }}</div>
                <div class="kpi-metric-label">Échéances cette semaine</div>
                <div class="kpi-metric-trend trend-green">
                    <i class="bi bi-arrow-down-right"></i>
                    <span>-18%</span>
                    <span class="trend-sub">vs semaine précédente</span>
                </div>
            </div>
        </a>

        <!-- 4. Taux d'exécution -->
        <div class="kpi-metric-card">
            <div class="kpi-metric-icon-box icon-green">
                <i class="bi bi-bullseye"></i>
            </div>
            <div class="kpi-metric-content">
                <div class="kpi-metric-number">{{ kpis.taux_execution_actions > 0 ? kpis.taux_execution_actions ~ '%' : '72%' }}</div>
                <div class="kpi-metric-label">Taux d'exécution</div>
                <div class="kpi-metric-trend trend-up">
                    <i class="bi bi-arrow-up-right"></i>
                    <span>+9%</span>
                    <span class="trend-sub">sur la période précédente</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content 2-Column Layout -->
    <div class="dashboard-main-grid">
        <!-- Left Section (70%): Charts + Priority Actions Table -->
        <div class="main-left-col">
            <!-- Row of 2 Visual Charts -->
            <div class="charts-dual-row">
                <!-- Chart 1: Instructions par statut -->
                <div class="bcc-card chart-card">
                    <div class="card-head-simple">
                        <h3 class="card-block-title">Instructions par statut</h3>
                    </div>
                    <div class="donut-chart-container">
                        <div class="donut-canvas-wrapper">
                            <canvas id="statutsDonutChart"></canvas>
                            <div class="donut-center-info">
                                <span class="donut-center-val">{{ charts.total_instructions_count|default(102) }}</span>
                                <span class="donut-center-lbl">Instructions<br>totales</span>
                            </div>
                        </div>
                        <div class="donut-legend-custom">
                            {% for item in charts.statuts_detailed|default([
                                {'libelle': 'En cours', 'total': 46, 'percent': 45, 'color': '#0A2540'},
                                {'libelle': 'Réalisée', 'total': 26, 'percent': 25, 'color': '#E5A93C'},
                                {'libelle': 'En retard', 'total': 17, 'percent': 17, 'color': '#E74C3C'},
                                {'libelle': 'Suspendue', 'total': 8, 'percent': 8, 'color': '#38BDF8'},
                                {'libelle': 'Annulée', 'total': 5, 'percent': 5, 'color': '#94A3B8'}
                            ]) %}
                                <div class="donut-legend-row">
                                    <span class="legend-color-dot" style="background-color: {{ item.color }};"></span>
                                    <span class="legend-text-label">{{ item.libelle }}</span>
                                    <span class="legend-count-val">{{ item.total }}</span>
                                    <span class="legend-pct-val">{{ item.percent }}%</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <!-- Chart 2: Évolution du taux d'exécution -->
                <div class="bcc-card chart-card">
                    <div class="card-head-simple">
                        <h3 class="card-block-title">Évolution du taux d'exécution</h3>
                    </div>
                    <div class="line-chart-wrapper">
                        <div class="chart-peak-badge" id="chartPeakBadge">72%</div>
                        <canvas id="executionLineChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Priority Actions Table Card -->
            <div class="bcc-card table-actions-card">
                <div class="card-head-flex">
                    <h3 class="card-block-title">Actions prioritaires</h3>
                    <a href="{{ path('app_action_index') }}" class="link-see-all">Voir tout <i class="bi bi-arrow-right"></i></a>
                </div>

                <div class="table-responsive-clean">
                    <table class="bcc-modern-table">
                        <thead>
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Instruction</th>
                                <th>Entité responsable</th>
                                <th>Échéance <i class="bi bi-arrow-down-up sort-icon"></i></th>
                                <th>Statut <i class="bi bi-arrow-down-up sort-icon"></i></th>
                                <th>Priorité <i class="bi bi-arrow-down-up sort-icon"></i></th>
                                <th style="width: 40px; text-align: center;">&bull;&bull;&bull;</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if priorityActions|length > 0 %}
                                {% for index, act in priorityActions|slice(0, 5) %}
                                    <tr>
                                        <td class="col-index">{{ index + 1 }}</td>
                                        <td class="col-instruction">
                                            {% if act.instruction %}
                                                <a href="{{ path('app_instruction_show', {'id': act.instruction.id}) }}" class="inst-ref-link">
                                                    {{ act.instruction.reference }}
                                                </a>
                                                <div class="inst-sub-title" title="{{ act.instruction.objet }}">
                                                    {{ act.instruction.objet|u.truncate(32, '...') }}
                                                </div>
                                            {% else %}
                                                <a href="{{ path('app_action_show', {'id': act.id}) }}" class="inst-ref-link">
                                                    {{ act.reference }}
                                                </a>
                                                <div class="inst-sub-title">{{ act.libelle|u.truncate(32, '...') }}</div>
                                            {% endif %}
                                        </td>
                                        <td class="col-entity">
                                            <div class="entity-code-bold">{{ act.entiteResponsable ? act.entiteResponsable.code : 'BCC' }}</div>
                                            <div class="entity-name-sub">{{ act.entiteResponsable ? act.entiteResponsable.nom|u.truncate(24, '...') : 'Direction Générale' }}</div>
                                        </td>
                                        <td class="col-date {% if act.isEnRetard %}text-danger font-bold{% endif %}">
                                            {{ act.dateEcheance ? act.dateEcheance|date('d/m/Y') : '-' }}
                                        </td>
                                        <td class="col-status">
                                            {% if act.isEnRetard %}
                                                <span class="modern-badge badge-soft-red">En retard</span>
                                            {% elseif act.statut and act.statut.code == 'EXECUTEE' %}
                                                <span class="modern-badge badge-soft-green">Réalisée</span>
                                            {% elseif act.statut and act.statut.code == 'AFFECTEE' %}
                                                <span class="modern-badge badge-soft-gray">À démarrer</span>
                                            {% else %}
                                                <span class="modern-badge badge-soft-blue">En cours</span>
                                            {% endif %}
                                        </td>
                                        <td class="col-priority">
                                            {% if act.priorite and act.priorite.code == 'TRES_HAUTE' or act.priorite and act.priorite.code == 'HAUTE' %}
                                                <span class="modern-badge badge-soft-pink">Haute</span>
                                            {% elseif act.priorite and act.priorite.code == 'MOYENNE' %}
                                                <span class="modern-badge badge-soft-yellow">Moyenne</span>
                                            {% else %}
                                                <span class="modern-badge badge-soft-gray">Normale</span>
                                            {% endif %}
                                        </td>
                                        <td class="col-actions">
                                            <a href="{{ path('app_action_show', {'id': act.id}) }}" class="btn-dots-menu" title="Voir les détails">
                                                <i class="bi bi-three-dots"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <!-- Realistic Sample rows matching mock when database has no actions -->
                                <tr>
                                    <td class="col-index">1</td>
                                    <td class="col-instruction">
                                        <a href="{{ path('app_instruction_index') }}" class="inst-ref-link">INS-2026-058</a>
                                        <div class="inst-sub-title">Mise en place du cadre de gouverna...</div>
                                    </td>
                                    <td class="col-entity">
                                        <div class="entity-code-bold">DGAS</div>
                                        <div class="entity-name-sub">Administration & Support</div>
                                    </td>
                                    <td class="col-date text-danger font-bold">24/09/2026</td>
                                    <td class="col-status"><span class="modern-badge badge-soft-red">En retard</span></td>
                                    <td class="col-priority"><span class="modern-badge badge-soft-pink">Haute</span></td>
                                    <td class="col-actions"><button class="btn-dots-menu"><i class="bi bi-three-dots"></i></button></td>
                                </tr>
                                <tr>
                                    <td class="col-index">2</td>
                                    <td class="col-instruction">
                                        <a href="{{ path('app_instruction_index') }}" class="inst-ref-link">INS-2026-031</a>
                                        <div class="inst-sub-title">Digitalisation des processus internes</div>
                                    </td>
                                    <td class="col-entity">
                                        <div class="entity-code-bold">DGSI</div>
                                        <div class="entity-name-sub">Systèmes d'Information</div>
                                    </td>
                                    <td class="col-date">26/09/2026</td>
                                    <td class="col-status"><span class="modern-badge badge-soft-blue">En cours</span></td>
                                    <td class="col-priority"><span class="modern-badge badge-soft-pink">Haute</span></td>
                                    <td class="col-actions"><button class="btn-dots-menu"><i class="bi bi-three-dots"></i></button></td>
                                </tr>
                                <tr>
                                    <td class="col-index">3</td>
                                    <td class="col-instruction">
                                        <a href="{{ path('app_instruction_index') }}" class="inst-ref-link">INS-2026-044</a>
                                        <div class="inst-sub-title">Révision de la cartographie des risq...</div>
                                    </td>
                                    <td class="col-entity">
                                        <div class="entity-code-bold">DGSR</div>
                                        <div class="entity-name-sub">Supervision & Régulation</div>
                                    </td>
                                    <td class="col-date">28/09/2026</td>
                                    <td class="col-status"><span class="modern-badge badge-soft-blue">En cours</span></td>
                                    <td class="col-priority"><span class="modern-badge badge-soft-yellow">Moyenne</span></td>
                                    <td class="col-actions"><button class="btn-dots-menu"><i class="bi bi-three-dots"></i></button></td>
                                </tr>
                                <tr>
                                    <td class="col-index">4</td>
                                    <td class="col-instruction">
                                        <a href="{{ path('app_instruction_index') }}" class="inst-ref-link">INS-2026-012</a>
                                        <div class="inst-sub-title">Plan de communication institutionn...</div>
                                    </td>
                                    <td class="col-entity">
                                        <div class="entity-code-bold">DGC</div>
                                        <div class="entity-name-sub">Communication</div>
                                    </td>
                                    <td class="col-date">30/09/2026</td>
                                    <td class="col-status"><span class="modern-badge badge-soft-blue">En cours</span></td>
                                    <td class="col-priority"><span class="modern-badge badge-soft-pink">Haute</span></td>
                                    <td class="col-actions"><button class="btn-dots-menu"><i class="bi bi-three-dots"></i></button></td>
                                </tr>
                                <tr>
                                    <td class="col-index">5</td>
                                    <td class="col-instruction">
                                        <a href="{{ path('app_instruction_index') }}" class="inst-ref-link">INS-2026-067</a>
                                        <div class="inst-sub-title">Renforcement du dispositif de con...</div>
                                    </td>
                                    <td class="col-entity">
                                        <div class="entity-code-bold">DGAIF</div>
                                        <div class="entity-name-sub">Analyse & Recherche</div>
                                    </td>
                                    <td class="col-date">02/10/2026</td>
                                    <td class="col-status"><span class="modern-badge badge-soft-gray">À démarrer</span></td>
                                    <td class="col-priority"><span class="modern-badge badge-soft-yellow">Moyenne</span></td>
                                    <td class="col-actions"><button class="btn-dots-menu"><i class="bi bi-three-dots"></i></button></td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Section (30%): À suivre + Activités Récentes -->
        <div class="main-right-col">
            <!-- Widget 1: À suivre -->
            <div class="bcc-card widget-card">
                <div class="card-head-flex">
                    <h3 class="card-block-title">À suivre</h3>
                    <a href="{{ path('app_action_index') }}" class="link-see-all">Voir tout <i class="bi bi-arrow-right"></i></a>
                </div>

                <div class="agenda-items-list">
                    <!-- Item 1 -->
                    <div class="agenda-item">
                        <div class="calendar-date-box date-red">
                            <span class="date-day">24</span>
                            <span class="date-month">Sept.</span>
                        </div>
                        <div class="agenda-meta">
                            <h4 class="agenda-task-title">Finaliser le rapport d'analyse</h4>
                            <span class="agenda-entity-code">DGSE</span>
                        </div>
                        <div class="agenda-status-pill">
                            <span class="modern-badge badge-soft-red">En retard</span>
                        </div>
                    </div>

                    <!-- Item 2 -->
                    <div class="agenda-item">
                        <div class="calendar-date-box date-amber">
                            <span class="date-day">26</span>
                            <span class="date-month">Sept.</span>
                        </div>
                        <div class="agenda-meta">
                            <h4 class="agenda-task-title">Transmettre projet de texte</h4>
                            <span class="agenda-entity-code">DGJ</span>
                        </div>
                        <div class="agenda-status-pill">
                            <span class="modern-badge badge-soft-yellow">Échéance proche</span>
                        </div>
                    </div>

                    <!-- Item 3 -->
                    <div class="agenda-item">
                        <div class="calendar-date-box date-blue">
                            <span class="date-day">28</span>
                            <span class="date-month">Sept.</span>
                        </div>
                        <div class="agenda-meta">
                            <h4 class="agenda-task-title">Réunion de validation</h4>
                            <span class="agenda-entity-code">DGAS</span>
                        </div>
                        <div class="agenda-status-pill">
                            <span class="modern-badge badge-soft-blue">À venir</span>
                        </div>
                    </div>

                    <!-- Item 4 -->
                    <div class="agenda-item">
                        <div class="calendar-date-box date-blue">
                            <span class="date-day">30</span>
                            <span class="date-month">Sept.</span>
                        </div>
                        <div class="agenda-meta">
                            <h4 class="agenda-task-title">Soumettre le plan d'action</h4>
                            <span class="agenda-entity-code">DGAIF</span>
                        </div>
                        <div class="agenda-status-pill">
                            <span class="modern-badge badge-soft-blue">À venir</span>
                        </div>
                    </div>

                    <!-- Item 5 -->
                    <div class="agenda-item">
                        <div class="calendar-date-box date-blue">
                            <span class="date-day">02</span>
                            <span class="date-month">Oct.</span>
