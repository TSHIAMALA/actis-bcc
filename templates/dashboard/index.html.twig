{% extends 'base.html.twig' %}

{% block title %}Cockpit Exécutif - Tableau de bord{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2 class="page-title">Tableau de bord de pilotage</h2>
        <p class="page-subtitle">Cockpit décisionnel des Ordres de Service et Instructions du Gouverneur</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <form action="{{ path('app_relance_trigger_engine') }}" method="post">
            <button type="submit" class="btn btn-secondary btn-sm" title="Vérifier et déclencher les alertes d'échéances">
                <i class="bi bi-arrow-repeat"></i> Scanner les Échéances
            </button>
        </form>
        <a href="{{ path('app_instruction_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Créer une Instruction
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card blue">
        <div class="kpi-icon-wrapper">
            <i class="bi bi-journal-text"></i>
        </div>
        <div class="kpi-content">
            <div class="kpi-label">Total Instructions</div>
            <div class="kpi-value">{{ kpis.total_instructions }}</div>
        </div>
    </div>

    <div class="kpi-card yellow">
        <div class="kpi-icon-wrapper">
            <i class="bi bi-inbox-fill"></i>
        </div>
        <div class="kpi-content">
            <div class="kpi-label">Nouvelles / À affecter</div>
            <div class="kpi-value">{{ kpis.nouvelles }}</div>
        </div>
    </div>

    <div class="kpi-card purple">
        <div class="kpi-icon-wrapper">
            <i class="bi bi-arrow-repeat"></i>
        </div>
        <div class="kpi-content">
            <div class="kpi-label">En cours d'exécution</div>
            <div class="kpi-value">{{ kpis.en_cours }}</div>
        </div>
    </div>

    <div class="kpi-card green">
        <div class="kpi-icon-wrapper">
            <i class="bi bi-check2-circle"></i>
        </div>
        <div class="kpi-content">
            <div class="kpi-label">Exécutées / Clôturées</div>
            <div class="kpi-value">{{ kpis.finalisees }}</div>
        </div>
    </div>

    <div class="kpi-card red">
        <div class="kpi-icon-wrapper">
            <i class="bi bi-alarm-fill"></i>
        </div>
        <div class="kpi-content">
            <div class="kpi-label">Instructions en Retard</div>
            <div class="kpi-value">{{ kpis.en_retard }}</div>
        </div>
    </div>

    <div class="kpi-card gold">
        <div class="kpi-icon-wrapper">
            <i class="bi bi-graph-up-arrow"></i>
        </div>
        <div class="kpi-content">
            <div class="kpi-label">Avancement Global</div>
            <div class="kpi-value">{{ kpis.taux_avancement_moyen }} %</div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="grid-2" style="margin-bottom: 24px;">
    <div class="card" style="margin-bottom: 0;">
        <div class="card-header">
            <h3 class="card-title"><i class="bi bi-pie-chart-fill" style="color: var(--bcc-gold);"></i> Répartition par Statut</h3>
        </div>
        <div class="card-body">
            <div style="height: 250px; position: relative;">
                <canvas id="statutsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom: 0;">
        <div class="card-header">
            <h3 class="card-title"><i class="bi bi-bar-chart-fill" style="color: var(--bcc-navy-light);"></i> Répartition par Priorité</h3>
        </div>
        <div class="card-body">
            <div style="height: 250px; position: relative;">
                <canvas id="prioritesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Performance Directions Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-building-check" style="color: var(--bcc-navy);"></i> Performance d'Exécution par Direction / Entité</h3>
        <span class="badge badge-info">{{ performanceDirections|length }} Entités répertoriées</span>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Direction / Entité</th>
                        <th>Type</th>
                        <th style="text-align: center;">Total Instr.</th>
                        <th style="text-align: center;">Exécutées</th>
                        <th style="text-align: center;">En cours</th>
                        <th style="text-align: center;">En retard</th>
                        <th>Avancement Actions</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for perf in performanceDirections %}
                        <tr>
                            <td>
                                <strong>{{ perf.code }}</strong> - {{ perf.nom }}
                            </td>
                            <td><span class="badge badge-secondary">{{ perf.type_entite }}</span></td>
                            <td style="text-align: center; font-weight: 700;">{{ perf.total_instructions }}</td>
                            <td style="text-align: center; color: var(--color-success); font-weight: 700;">{{ perf.instructions_executees }}</td>
                            <td style="text-align: center; color: var(--color-purple); font-weight: 700;">{{ perf.instructions_en_cours }}</td>
                            <td style="text-align: center;">
                                {% if perf.instructions_en_retard > 0 %}
                                    <span class="badge badge-danger">{{ perf.instructions_en_retard }}</span>
                                {% else %}
                                    <span class="badge badge-success">0</span>
                                {% endif %}
                            </td>
                            <td style="width: 180px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill {% if perf.taux_moyen_actions >= 80 %}success{% elseif perf.taux_moyen_actions >= 40 %}warning{% else %}danger{% endif %}" style="width: {{ perf.taux_moyen_actions }}%;"></div>
                                    </div>
                                    <span style="font-size: 0.78rem; font-weight: 700; width: 45px;">{{ perf.taux_moyen_actions }}%</span>
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <a href="{{ path('app_instruction_index', {'entite': perf.id}) }}" class="btn btn-secondary btn-sm" title="Voir les instructions de cette direction">
                                    <i class="bi bi-eye"></i> Voir
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 24px; color: var(--text-muted);">
                                Aucune entité trouvée.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Two Columns: Upcoming Deadlines & Recent Instructions -->
<div class="grid-2">
    <!-- Upcoming Deadlines -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="bi bi-calendar-event-fill" style="color: var(--color-danger);"></i> Échéances Imminentes & Alertes (7 jours)</h3>
            <a href="{{ path('app_action_index', {'retard': '1'}) }}" class="badge badge-danger">Retards</a>
        </div>
        <div class="card-body" style="padding: 12px 20px;">
            {% for act in upcomingEcheances %}
                <div style="padding: 12px 0; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <div style="font-weight: 600; color: var(--bcc-navy);">{{ act.libelle }}</div>
                        <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 2px;">
                            <span class="badge badge-secondary">{{ act.instruction.reference }}</span> &bull;
                            Responsable : <strong>{{ act.responsable ? act.responsable.nomComplet : act.entiteResponsable.code }}</strong>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <span class="badge badge-warning"><i class="bi bi-clock"></i> {{ act.dateEcheance ? act.dateEcheance|date('d/m/Y') : '-' }}</span>
                        <div style="margin-top: 4px;">
                            <a href="{{ path('app_action_show', {'id': act.id}) }}" class="btn btn-secondary btn-sm" style="padding: 2px 8px; font-size: 0.72rem;">
                                Suivre
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div style="padding: 24px; text-align: center; color: var(--text-muted);">
                    <i class="bi bi-check-circle" style="font-size: 2rem; color: var(--color-success);"></i>
                    <p style="margin-top: 8px;">Aucune échéance critique dans les 7 prochains jours.</p>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Recent Instructions -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="bi bi-clock-history" style="color: var(--bcc-gold);"></i> Dernières Instructions Enregistrées</h3>
            <a href="{{ path('app_instruction_index') }}" class="btn btn-secondary btn-sm">Toutes</a>
        </div>
        <div class="card-body" style="padding: 12px 20px;">
            {% for inst in recentInstructions %}
                <div style="padding: 12px 0; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between;">
                    <div style="max-width: 70%;">
                        <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 2px;">
                            <strong style="color: var(--bcc-navy); font-size: 0.85rem;">{{ inst.reference }}</strong>
                            <span class="badge {{ inst.statut.badgeClass }}">{{ inst.statut.libelle }}</span>
                        </div>
                        <div style="font-size: 0.82rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            {{ inst.objet }}
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-weight: 700; font-size: 0.85rem; color: var(--bcc-gold);">{{ inst.tauxAvancement }}%</div>
                        <a href="{{ path('app_instruction_show', {'id': inst.id}) }}" class="btn btn-secondary btn-sm" style="padding: 2px 8px; font-size: 0.72rem; margin-top: 4px;">
                            Cockpit 360°
                        </a>
                    </div>
                </div>
            {% else %}
                <div style="padding: 24px; text-align: center; color: var(--text-muted);">
                    Aucune instruction enregistrée.
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Statuts Chart
    const ctxStatut = document.getElementById('statutsChart').getContext('2d');
    new Chart(ctxStatut, {
        type: 'doughnut',
        data: {
            labels: {{ charts.statuts.labels|json_encode|raw }},
            datasets: [{
                data: {{ charts.statuts.data|json_encode|raw }},
                backgroundColor: ['#4F46E5', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6', '#64748B', '#0EA5E9'],
                borderWidth: 2,
                borderColor: '#FFFFFF'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'right',
                    labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11 } }
                }
            }
        }
    });

    // Priorités Chart
    const ctxPriorite = document.getElementById('prioritesChart').getContext('2d');
    new Chart(ctxPriorite, {
        type: 'bar',
        data: {
            labels: {{ charts.priorites.labels|json_encode|raw }},
            datasets: [{
                label: 'Nombre d\'instructions',
                data: {{ charts.priorites.data|json_encode|raw }},
                backgroundColor: ['#DC2626', '#EA580C', '#2563EB', '#94A3B8'],
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1 }
                }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });
});
</script>
{% endblock %}
