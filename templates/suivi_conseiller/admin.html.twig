{% extends 'base.html.twig' %}

{% block title %}Gestion des Conseillers du Gouverneur - ACTIS-BCC{% endblock %}

{% block stylesheets %}
<style>
.admin-subpage-header {
    background: linear-gradient(135deg, #091a2f 0%, #0f2744 50%, #1a3a60 100%);
    color: #ffffff;
    border-radius: 16px;
    padding: 1.75rem 2rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 8px 24px rgba(9, 26, 47, 0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
}
.advisor-avatar-circle {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: linear-gradient(135deg, #1e3a5f, #0f2744);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.advisor-admin-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
    overflow: hidden;
}
.advisor-toolbar {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
}
.advisor-search-input {
    padding: 0.5rem 0.85rem 0.5rem 2.2rem;
    font-size: 0.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    background: #ffffff;
    outline: none;
    min-width: 260px;
    transition: all 0.2s ease;
}
.advisor-search-input:focus {
    border-color: #0d9488;
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
}

/* Custom Modal Overlay Styles */
.actis-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(4px);
    z-index: 1050;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: actisFadeIn 0.2s ease-out;
}
.actis-modal-backdrop.active {
    display: flex !important;
}
.actis-modal-box {
    background: #ffffff;
    border-radius: 16px;
    max-width: 560px;
    width: 100%;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: actisScaleIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid #e2e8f0;
}
.actis-modal-header {
    background: linear-gradient(135deg, #091a2f 0%, #0f2744 100%);
    color: #ffffff;
    padding: 1.15rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #0d9488;
}
.actis-modal-header h5 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
}
.actis-modal-close-btn {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 8px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e2e8f0;
    cursor: pointer;
    font-size: 1.25rem;
    line-height: 1;
    transition: background 0.2s;
}
.actis-modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
}
.actis-modal-body {
    padding: 1.5rem;
    max-height: 75vh;
    overflow-y: auto;
}
.actis-modal-footer {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
}

@keyframes actisFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}
@keyframes actisScaleIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

    <!-- Top Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Administration</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_suivi_conseiller_index') }}">Suivi Conseillers</a></li>
            <li class="breadcrumb-item active">Collège des Conseillers</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="admin-subpage-header">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge" style="background: rgba(255,255,255,0.15); color: #d4e3f5; font-size: 0.78rem; border: 1px solid rgba(255,255,255,0.2);">
                    <i class="bi bi-shield-check me-1"></i> Cabinet du Gouverneur • Cellule Stratégique
                </span>
            </div>
            <h2 class="fw-bold text-white mb-1">Collège des Conseillers du Gouverneur</h2>
            <p class="text-white-50 small mb-0">Paramétrage des portefeuilles sectoriels d'expertise, rattachement des comptes et ordre d'affichage.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_suivi_conseiller_index') }}" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Tableau de Suivi
            </a>
            <button type="button" class="btn btn-light btn-sm fw-semibold" onclick="openAddConseillerModal()">
                <i class="bi bi-person-plus-fill me-1 text-primary"></i> Nouveau Conseiller
            </button>
        </div>
    </div>

    <!-- Table Card -->
    <div class="advisor-admin-card">
        <!-- Toolbar -->
        <div class="advisor-toolbar">
            <div class="d-flex align-items-center gap-2">
                <h5 class="fw-bold mb-0 text-dark" style="font-size: 1rem;">
                    <i class="bi bi-people-fill text-primary me-2"></i>Conseillers et Domaines configurés
                </h5>
                <span class="badge bg-light text-muted border">{{ conseillers|length }} profils enregistrés</span>
            </div>
            <div class="position-relative">
                <i class="bi bi-search position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%); font-size: 0.85rem;"></i>
                <input type="text" id="advisorSearchBox" class="advisor-search-input" placeholder="Filtrer par nom, domaine, code..." onkeyup="filterAdvisorsTable()">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="advisorsTable">
                <thead class="table-light">
                    <tr style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: #475569;">
                        <th style="width: 70px; text-align: center;">Ordre</th>
                        <th>Conseiller (Utilisateur)</th>
                        <th>Code Domaine</th>
                        <th>Domaine de Compétence</th>
                        <th>Description / Périmètre</th>
                        <th style="text-align: center;">Statut</th>
                        <th style="text-align: right; width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if conseillers|length > 0 %}
                        {% for c in conseillers %}
                            <tr>
                                <!-- Ordre -->
                                <td style="text-align: center;">
                                    <span class="badge bg-light text-dark border fw-bold">{{ c.ordreAffichage }}</span>
                                </td>

                                <!-- Advisor User & Avatar -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="advisor-avatar-circle">
                                            {{ c.utilisateur ? (c.utilisateur.prenom|slice(0,1) ~ c.utilisateur.nom|slice(0,1))|upper : 'CG' }}
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">{{ c.utilisateur ? c.utilisateur.nomComplet : 'N/A' }}</div>
                                            <div class="text-muted small" style="font-size: 0.75rem;">{{ c.utilisateur ? c.utilisateur.email : '' }}</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Code Domaine -->
                                <td>
                                    <span class="badge bg-primary-subtle text-primary fw-bold" style="font-size: 0.82rem; letter-spacing: 0.03em;">
                                        {{ c.codeDomaine }}
                                    </span>
                                </td>

                                <!-- Domaine Competence -->
                                <td>
                                    <div class="fw-semibold text-dark">{{ c.domaineCompetence }}</div>
                                </td>

                                <!-- Description -->
                                <td>
                                    <div class="text-muted small text-truncate" style="max-width: 280px;" title="{{ c.description }}">
                                        {{ c.description ?: '—' }}
                                    </div>
                                </td>

                                <!-- Status -->
                                <td style="text-align: center;">
                                    {% if c.actif %}
                                        <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-check-circle-fill"></i> Actif
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary-subtle text-secondary d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-slash-circle"></i> Inactif
                                        </span>
                                    {% endif %}
                                </td>

                                <!-- Actions -->
                                <td style="text-align: right;">
                                    <div class="d-inline-flex align-items-center justify-content-end gap-1">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-primary" 
                                                onclick="openEditConseillerModal('{{ c.id }}', '{{ (c.utilisateur ? c.utilisateur.nomComplet : '')|e('js') }}', '{{ c.codeDomaine|e('js') }}', '{{ c.domaineCompetence|e('js') }}', '{{ c.description|e('js') }}', '{{ c.ordreAffichage }}')" 
                                                title="Modifier la fiche">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" action="{{ path('app_suivi_conseiller_admin_toggle', {'id': c.id}) }}" class="d-inline" onsubmit="return confirm('Confirmez-vous le changement de statut pour ce conseiller ?');">
                                            <button type="submit" class="btn btn-sm btn-outline-{{ c.actif ? 'warning' : 'success' }}" title="{{ c.actif ? 'Désactiver' : 'Activer' }}">
                                                <i class="bi bi-{{ c.actif ? 'pause-circle-fill' : 'play-circle-fill' }}"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                <h6>Aucun conseiller configuré.</h6>
                                <p class="small mb-0">Cliquez sur « Nouveau Conseiller » pour en ajouter un.</p>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==========================================
     MODALE 1 : NOUVEAU CONSEILLER
     ========================================== -->
<div class="actis-modal-backdrop" id="modalAddConseiller">
    <div class="actis-modal-box">
        <form method="post" action="{{ path('app_suivi_conseiller_admin') }}">
            <input type="hidden" name="action_type" value="add">
            
            <div class="actis-modal-header">
                <h5>
                    <i class="bi bi-person-plus-fill text-warning"></i>
                    Ajouter un Conseiller du Gouverneur
                </h5>
                <button type="button" class="actis-modal-close-btn" onclick="closeAddConseillerModal()">&times;</button>
            </div>
            
            <div class="actis-modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Sélectionner l'Utilisateur <span class="text-danger">*</span></label>
                    <select name="utilisateur_id" class="form-select" required>
                        <option value="">-- Choisir un compte utilisateur --</option>
                        {% for u in users %}
                            <option value="{{ u.id }}">{{ u.nomComplet }} ({{ u.email }}) - {{ u.entite ? u.entite.code : 'Sans entité' }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label class="form-label fw-semibold text-dark">Code Domaine <span class="text-danger">*</span></label>
                        <input type="text" name="code_domaine" class="form-control text-uppercase" placeholder="Ex: ECO_FIN" required>
                        <div class="form-text small" style="font-size: 0.72rem;">Code court unique.</div>
                    </div>
                    <div class="col-md-7 mb-3">
                        <label class="form-label fw-semibold text-dark">Ordre d'affichage</label>
                        <input type="number" name="ordre_affichage" class="form-control" value="10">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Domaine de Compétence <span class="text-danger">*</span></label>
                    <input type="text" name="domaine_competence" class="form-control" placeholder="Ex: Économie, Finances & Budget" required>
                </div>

                <div class="mb-0">
                    <label class="form-label fw-semibold text-dark">Description / Mission</label>
                    <textarea name="description" class="form-control" rows="3" placeholder="Périmètre de supervision et attributions sectorielles..."></textarea>
                </div>
            </div>
            
            <div class="actis-modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" onclick="closeAddConseillerModal()">Annuler</button>
                <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                    <i class="bi bi-check-circle me-1"></i> Créer le Conseiller
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==========================================
     MODALE 2 : MODIFIER UN CONSEILLER
     ========================================== -->
<div class="actis-modal-backdrop" id="modalEditConseiller">
    <div class="actis-modal-box">
        <form method="post" action="{{ path('app_suivi_conseiller_admin') }}">
            <input type="hidden" name="action_type" value="edit">
            <input type="hidden" name="conseiller_id" id="edit_conseiller_id" value="">
            
            <div class="actis-modal-header">
                <h5>
                    <i class="bi bi-pencil-square text-warning"></i>
                    Modifier la fiche Conseiller
                </h5>
                <button type="button" class="actis-modal-close-btn" onclick="closeEditConseillerModal()">&times;</button>
            </div>
            
            <div class="actis-modal-body">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Utilisateur associé</label>
                    <input type="text" id="edit_utilisateur_nom" class="form-control bg-light" value="" disabled>
                </div>

                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label class="form-label fw-semibold text-dark">Code Domaine <span class="text-danger">*</span></label>
                        <input type="text" name="code_domaine" id="edit_code_domaine" class="form-control text-uppercase" required>
                    </div>
                    <div class="col-md-7 mb-3">
                        <label class="form-label fw-semibold text-dark">Ordre d'affichage</label>
                        <input type="number" name="ordre_affichage" id="edit_ordre_affichage" class="form-control" value="10">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Domaine de Compétence <span class="text-danger">*</span></label>
                    <input type="text" name="domaine_competence" id="edit_domaine_competence" class="form-control" required>
                </div>

                <div class="mb-0">
                    <label class="form-label fw-semibold text-dark">Description / Périmètre</label>
                    <textarea name="description" id="edit_description" class="form-control" rows="3"></textarea>
                </div>
            </div>
            
            <div class="actis-modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" onclick="closeEditConseillerModal()">Annuler</button>
                <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                    <i class="bi bi-check-circle me-1"></i> Enregistrer les modifications
                </button>
            </div>
        </form>
    </div>
</div>

<script>
// Filter Search in Table
function filterAdvisorsTable() {
    const input = document.getElementById('advisorSearchBox');
    const filter = input.value.toLowerCase();
    const table = document.getElementById('advisorsTable');
    const tr = table.getElementsByTagName('tr');

    for (let i = 1; i < tr.length; i++) {
        const rowText = tr[i].textContent || tr[i].innerText;
        if (rowText.toLowerCase().indexOf(filter) > -1) {
            tr[i].style.display = '';
        } else {
            tr[i].style.display = 'none';
        }
    }
}

// Modal Functions - Add
function openAddConseillerModal() {
    document.getElementById('modalAddConseiller').classList.add('active');
}
function closeAddConseillerModal() {
    document.getElementById('modalAddConseiller').classList.remove('active');
}

// Modal Functions - Edit
function openEditConseillerModal(id, userName, codeDomaine, domaine, description, ordre) {
    document.getElementById('edit_conseiller_id').value = id;
    document.getElementById('edit_utilisateur_nom').value = userName;
    document.getElementById('edit_code_domaine').value = codeDomaine;
    document.getElementById('edit_domaine_competence').value = domaine;
    document.getElementById('edit_description').value = description || '';
    document.getElementById('edit_ordre_affichage').value = ordre || 10;
    
    document.getElementById('modalEditConseiller').classList.add('active');
}
function closeEditConseillerModal() {
    document.getElementById('modalEditConseiller').classList.remove('active');
}

// Close modals when clicking backdrop
document.addEventListener('click', function(e) {
    const modalAdd = document.getElementById('modalAddConseiller');
    const modalEdit = document.getElementById('modalEditConseiller');
    if (e.target === modalAdd) closeAddConseillerModal();
    if (e.target === modalEdit) closeEditConseillerModal();
});

// Close modals on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeAddConseillerModal();
        closeEditConseillerModal();
    }
});
</script>
{% endblock %}
