{% extends 'base.html.twig' %}

{% block title %}{% if isEdit %}Modifier l'entité{% else %}Nouvelle Entité{% endif %}{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2 class="page-title">{% if isEdit %}Modifier l'entité : {{ entite.code }}{% else %}Créer une Entité Organisationnelle{% endif %}</h2>
        <p class="page-subtitle">Rattachement hiérarchique et typologie</p>
    </div>
    <div>
        <a href="{{ path('app_admin_entites') }}" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>
</div>

<div class="card" style="max-width: 750px; margin: 0 auto;">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-building-gear"></i> Paramètres de l'Entité</h3>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
            <div class="grid-2">
                <div class="form-group">
                    {{ form_label(form.code, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.code, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.code) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.typeEntite, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.typeEntite, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.typeEntite) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.nom) }}
            </div>

            <div class="form-group">
                {{ form_label(form.parent, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.parent, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.parent) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-group">
                <div style="display: flex; align-items: center; gap: 8px;">
                    {{ form_widget(form.actif) }}
                    {{ form_label(form.actif) }}
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
                <a href="{{ path('app_admin_entites') }}" class="btn btn-secondary">Annuler</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Enregistrer
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
