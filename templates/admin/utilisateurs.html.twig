{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs - Administration{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2 class="page-title">Gestion des Utilisateurs</h2>
        <p class="page-subtitle">Comptes d'accès, affectations et rôles applicatifs</p>
    </div>
    <div>
        <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-person-plus-fill"></i> Nouvel Utilisateur
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-people-fill"></i> Liste des Utilisateurs ({{ users|length }})</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Matricule</th>
                        <th>Nom Complet</th>
                        <th>Email Professionnel</th>
                        <th>Entité de Rattachement</th>
                        <th>Rôles / Profils</th>
                        <th>Statut</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                        <tr>
                            <td><strong>{{ u.matricule }}</strong></td>
                            <td>{{ u.nomComplet }}</td>
                            <td>{{ u.email }}</td>
                            <td><span class="badge badge-secondary">{{ u.entite.nomComplet }}</span></td>
                            <td>
                                {% for r in u.appRoles %}
                                    <span class="badge badge-info">{{ r.libelle }}</span>
                                {% endfor %}
                            </td>
                            <td>
                                {% if u.actif %}
                                    <span class="badge badge-success">Actif</span>
                                {% else %}
                                    <span class="badge badge-danger">Inactif</span>
                                {% endif %}
                            </td>
                            <td style="text-align: right;">
                                <div class="d-flex justify-content-end gap-1">
                                    <a href="{{ path('app_admin_user_edit', {'id': u.id}) }}" class="btn btn-secondary btn-sm" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    
                                    {% if u != app.user %}
                                        <form method="post" action="{{ path('app_admin_user_toggle_actif', {'id': u.id}) }}" onsubmit="return confirm('Voulez-vous {{ u.actif ? 'suspendre' : 'activer' }} le compte de {{ u.nomComplet|e('js') }} ?');" style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_user_' ~ u.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-{{ u.actif ? 'warning' : 'success' }}" title="{{ u.actif ? 'Suspendre / Désactiver' : 'Activer le compte' }}">
                                                <i class="bi bi-{{ u.actif ? 'pause-circle' : 'play-circle' }}"></i>
                                            </button>
                                        </form>

                                        {% if u.actif %}
                                            <form method="post" action="{{ path('app_admin_user_delete', {'id': u.id}) }}" onsubmit="return confirm('Confirmez-vous l\'archivage / suppression logique de l\'utilisateur {{ u.nomComplet|e('js') }} ?');" style="display: inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ u.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Archiver / Suppression logique">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
