{% extends 'base.html.twig' %}

{% block title %}Journal d'Audit & Traçabilité - Administration - ACTIS-BCC{% endblock %}

{% block stylesheets %}
<style>
.admin-subpage-header {
    background: linear-gradient(135deg, #091a2f 0%, #0f2744 50%, #1a3a60 100%);
    color: #ffffff;
    border-radius: 16px;
    padding: 1.75rem 2rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 8px 24px rgba(9, 26, 47, 0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
}
.audit-table-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
    overflow: hidden;
}
.audit-toolbar {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
}
.audit-search-input {
    padding: 0.45rem 0.85rem 0.45rem 2.2rem;
    font-size: 0.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    background: #ffffff;
    outline: none;
    min-width: 260px;
}
.audit-search-input:focus {
    border-color: var(--actis-primary, #0d9488);
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
}
.evt-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    display: inline-block;
}
.evt-creation { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
.evt-modification { background: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; }
.evt-suppression { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
.evt-affectation { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
.evt-autre { background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

    <!-- Top Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Administration</a></li>
            <li class="breadcrumb-item active">Journal d'Audit</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="admin-subpage-header">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge" style="background: rgba(255,255,255,0.15); color: #d4e3f5; font-size: 0.78rem; border: 1px solid rgba(255,255,255,0.2);">
                    <i class="bi bi-shield-check me-1"></i> Traçabilité Légale & Piste d'Audit
                </span>
            </div>
            <h2 class="fw-bold text-white mb-1">Journal d'Audit & Piste de Contrôle</h2>
            <p class="text-white-50 small mb-0">Historique inaltérable de tous les événements, modifications, validations et actions sensibles du système.</p>
        </div>
        <div>
            <a href="{{ path('app_admin_index') }}" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Tableau Admin
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="audit-table-card">
        <!-- Toolbar -->
        <div class="audit-toolbar">
            <div class="d-flex align-items-center gap-2">
                <h5 class="fw-bold mb-0 text-dark" style="font-size: 1rem;">
                    <i class="bi bi-clock-history text-primary me-2"></i>Dernières Activités Enregistrées
                </h5>
                <span class="badge bg-light text-muted border">{{ logs|length }} événements affichés</span>
            </div>
            <div class="position-relative">
                <i class="bi bi-search position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%); font-size: 0.85rem;"></i>
                <input type="text" id="auditSearchBox" class="audit-search-input" placeholder="Rechercher dans l'audit..." onkeyup="filterAuditTable()">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="auditTable">
                <thead class="table-light">
                    <tr style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: #475569;">
                        <th style="width: 140px;">Date & Heure</th>
                        <th style="width: 150px;">Type d'Événement</th>
                        <th style="width: 180px;">Auteur</th>
                        <th style="width: 110px;">Entité</th>
                        <th style="width: 180px;">Cible</th>
                        <th>Description Détaillée</th>
                    </tr>
                </thead>
                <tbody>
                    {% for l in logs %}
                        {% set codeEvt = l.typeEvenement.code|default('') %}
                        <tr>
                            <!-- Date & Time -->
                            <td>
                                <div class="fw-bold text-dark" style="font-size: 0.82rem;">
                                    {{ l.createdAt|date('d/m/Y') }}
                                </div>
                                <div class="text-muted small" style="font-size: 0.74rem;">
                                    {{ l.createdAt|date('H:i:s') }}
                                </div>
                            </td>

                            <!-- Event Type -->
                            <td>
                                <span class="evt-badge {% if 'CREAT' in codeEvt %}evt-creation{% elseif 'SUPPR' in codeEvt or 'SUPPRIM' in codeEvt %}evt-suppression{% elseif 'MODIF' in codeEvt %}evt-modification{% elseif 'AFFECT' in codeEvt %}evt-affectation{% else %}evt-autre{% endif %}">
                                    {{ l.typeEvenement.libelle }}
                                </span>
                            </td>

                            <!-- Author -->
                            <td>
                                <div class="fw-semibold text-dark" style="font-size: 0.86rem;">
                                    <i class="bi bi-person-circle me-1 text-muted"></i>
                                    {{ l.utilisateur ? l.utilisateur.nomComplet : 'Système' }}
                                </div>
                                {% if l.utilisateur and l.utilisateur.email %}
                                    <div class="text-muted small text-truncate" style="max-width: 160px; font-size: 0.74rem;">
                                        {{ l.utilisateur.email }}
                                    </div>
                                {% endif %}
                            </td>

                            <!-- Entite -->
                            <td>
                                {% if l.entite %}
                                    <span class="badge bg-light text-dark border fw-bold">{{ l.entite.code }}</span>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>

                            <!-- Target / Object -->
                            <td>
                                {% if l.action %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle small me-1">Action</span>
                                    <a href="{{ path('app_instruction_show', {'id': l.action.instruction.id}) }}#action-{{ l.action.id }}" class="text-dark fw-semibold text-decoration-none hover-primary" style="font-size: 0.82rem;">
                                        {{ l.action.libelle|length > 22 ? l.action.libelle|slice(0, 22) ~ '...' : l.action.libelle }}
                                    </a>
                                {% elseif l.instruction %}
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small me-1">Instruction</span>
                                    <a href="{{ path('app_instruction_show', {'id': l.instruction.id}) }}" class="text-dark fw-semibold text-decoration-none" style="font-size: 0.82rem;">
                                        {{ l.instruction.reference }}
                                    </a>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>

                            <!-- Description -->
                            <td>
                                <div style="font-size: 0.84rem; color: #334155; line-height: 1.4;">
                                    {{ l.description }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                <h6>Aucun événement consigné dans le journal d'audit.</h6>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterAuditTable() {
    const input = document.getElementById('auditSearchBox');
    const filter = input.value.toLowerCase();
    const table = document.getElementById('auditTable');
    const tr = table.getElementsByTagName('tr');

    for (let i = 1; i < tr.length; i++) {
        const rowText = tr[i].textContent || tr[i].innerText;
        if (rowText.toLowerCase().indexOf(filter) > -1) {
            tr[i].style.display = '';
        } else {
            tr[i].style.display = 'none';
        }
    }
}
</script>
{% endblock %}
