{% extends 'base.html.twig' %}

{% block title %}Administration du Système - ACTIS-BCC{% endblock %}

{% block stylesheets %}
<style>
/* ── Admin Page Container ── */
.admin-page-container {
    padding: 1.5rem 1.75rem 3.5rem 1.75rem;
    max-width: 100%;
}

/* ── Hero Banner ── */
.admin-hero-banner {
    background: linear-gradient(135deg, #091a2f 0%, #0f2744 45%, #18385e 100%);
    color: #ffffff;
    border-radius: 18px;
    padding: 2rem 2.25rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 12px 28px -6px rgba(9, 26, 47, 0.25);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
}
.admin-hero-banner::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(194, 147, 66, 0.15) 0%, rgba(13, 148, 136, 0.12) 40%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
}
.admin-hero-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
}
.admin-hero-left {
    max-width: 760px;
}
.admin-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    padding: 0.35rem 0.9rem;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #d4e3f5;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    letter-spacing: 0.02em;
}
.admin-hero-badge i {
    color: #fbbf24;
}
.admin-hero-title {
    font-size: 1.85rem;
    font-weight: 800;
    margin-bottom: 0.45rem;
    letter-spacing: -0.025em;
    color: #ffffff;
    line-height: 1.2;
}
.admin-hero-desc {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.92rem;
    line-height: 1.5;
    margin-bottom: 0;
}
.admin-hero-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
}
.btn-admin-hero-light {
    background: #ffffff;
    color: #0f2744;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.55rem 1.1rem;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    border: 1px solid rgba(255,255,255,0.8);
}
.btn-admin-hero-light:hover {
    background: #f1f5f9;
    color: #0b1a2d;
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.15);
}
.btn-admin-hero-outline {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.55rem 1.1rem;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition: all 0.2s ease;
    backdrop-filter: blur(4px);
}
.btn-admin-hero-outline:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    transform: translateY(-2px);
}

/* ── 5 Horizontal KPI Metric Cards ── */
.admin-kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin-bottom: 2rem;
}
.admin-kpi-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 1.15rem 1.25rem;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    color: inherit;
}
.admin-kpi-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    border-color: #cbd5e1;
}
.admin-kpi-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
}
.icon-kpi-users { background: #dcfce7; color: #16a34a; }
.icon-kpi-entites { background: #e0f2fe; color: #0284c7; }
.icon-kpi-conseillers { background: #fef3c7; color: #d97706; }
.icon-kpi-referentiels { background: #ede9fe; color: #7c3aed; }
.icon-kpi-audit { background: #fee2e2; color: #dc2626; }

.admin-kpi-info {
    flex: 1;
    min-width: 0;
}
.admin-kpi-value {
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.1;
    color: #0f172a;
    letter-spacing: -0.02em;
}
.admin-kpi-label {
    font-size: 0.76rem;
    color: #64748b;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 0.15rem;
}

/* ── Section Titles ── */
.admin-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
}
.admin-section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
}
.admin-section-title i {
    color: var(--actis-primary, #0d9488);
}

/* ── Administration Modules Grid (6 Cards) ── */
.admin-modules-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 2.25rem;
}
.admin-module-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    transition: all 0.22s ease;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
}
.admin-module-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: transparent;
    transition: background 0.2s ease;
}
.admin-module-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.09);
    transform: translateY(-3px);
}
.admin-module-card.mod-conseillers:hover::before { background: #d97706; }
.admin-module-card.mod-users:hover::before { background: #16a34a; }
.admin-module-card.mod-entites:hover::before { background: #0284c7; }
.admin-module-card.mod-referentiels:hover::before { background: #7c3aed; }
.admin-module-card.mod-audit:hover::before { background: #dc2626; }
.admin-module-card.mod-instructions:hover::before { background: #0d9488; }

.admin-module-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1rem;
}
.admin-module-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
}
.admin-module-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    background: #f1f5f9;
    color: #475569;
}
.admin-module-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.4rem;
    line-height: 1.3;
}
.admin-module-desc {
    font-size: 0.84rem;
    color: #64748b;
    line-height: 1.45;
    margin-bottom: 1.25rem;
    flex: 1;
}
.admin-module-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--actis-primary, #0d9488);
    transition: gap 0.2s ease;
}
.admin-module-card:hover .admin-module-link {
    gap: 0.65rem;
}

/* ── Bottom 2-Column Grid (Audit Feed & System Status) ── */
.admin-bottom-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 18px;
}
.admin-panel-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    overflow: hidden;
}
.admin-panel-header {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 1.1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.admin-panel-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
}
.admin-panel-body {
    padding: 1.25rem;
}

/* ── Audit Timeline List ── */
.audit-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.audit-row-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.75rem 0.85rem;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    transition: background 0.15s ease;
}
.audit-row-item:hover {
    background: #f1f5f9;
}
.audit-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 5px;
    flex-shrink: 0;
}
.dot-primary { background: #3b82f6; box-shadow: 0 0 0 3px #dbeafe; }
.dot-success { background: #10b981; box-shadow: 0 0 0 3px #d1fae5; }
.dot-warning { background: #f59e0b; box-shadow: 0 0 0 3px #fef3c7; }
.dot-danger { background: #ef4444; box-shadow: 0 0 0 3px #fee2e2; }
.dot-purple { background: #8b5cf6; box-shadow: 0 0 0 3px #ede9fe; }

.audit-meta {
    flex: 1;
    min-width: 0;
}
.audit-header-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
}
.audit-event-type {
    font-weight: 700;
    font-size: 0.82rem;
    color: #0f172a;
}
.audit-time {
    font-size: 0.74rem;
    color: #94a3b8;
    white-space: nowrap;
}
.audit-desc {
    font-size: 0.8rem;
    color: #475569;
    line-height: 1.35;
}
.audit-author {
    font-size: 0.72rem;
    color: #64748b;
    margin-top: 0.2rem;
    font-weight: 600;
}

/* ── System Status Box ── */
.sys-info-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
}
.sys-info-table tr {
    border-bottom: 1px solid #f1f5f9;
}
.sys-info-table tr:last-child {
    border-bottom: none;
}
.sys-info-table td {
    padding: 0.75rem 0.25rem;
    color: #475569;
}
.sys-info-table td.sys-val {
    font-weight: 600;
    color: #0f172a;
    text-align: right;
}

.status-online-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #dcfce7;
    color: #15803d;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 20px;
    border: 1px solid #bbf7d0;
}
.status-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 2px rgba(22, 163, 74, 0.4);
}

/* ── Responsive ── */
@media (max-width: 1200px) {
    .admin-kpi-grid {
        grid-template-columns: repeat(3, 1fr);
    }
    .admin-modules-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
@media (max-width: 900px) {
    .admin-bottom-grid {
        grid-template-columns: 1fr;
    }
}
@media (max-width: 768px) {
    .admin-page-container {
        padding: 1rem;
    }
    .admin-hero-banner {
        padding: 1.5rem;
    }
    .admin-hero-title {
        font-size: 1.45rem;
    }
    .admin-kpi-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .admin-modules-grid {
        grid-template-columns: 1fr;
    }
}
@media (max-width: 480px) {
    .admin-kpi-grid {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="admin-page-container">

    <!-- Top Admin Hero Banner -->
    <div class="admin-hero-banner">
        <div class="admin-hero-content">
            <div class="admin-hero-left">
                <div class="admin-hero-badge">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Centre de Contrôle & Administration • ACTIS-BCC</span>
                </div>
                <h1 class="admin-hero-title">Administration & Gouvernance du Système</h1>
                <p class="admin-hero-desc">
                    Pilotage des habilitations, configuration du collège des conseillers du Gouverneur, structuration de l'organigramme de la BCC, référentiels métiers et audit de conformité.
                </p>
            </div>
            <div class="admin-hero-actions">
                <a href="{{ path('app_admin_user_new') }}" class="btn-admin-hero-light">
                    <i class="bi bi-person-plus-fill text-primary"></i>
                    <span>Nouvel Utilisateur</span>
                </a>
                <a href="{{ path('app_suivi_conseiller_admin') }}" class="btn-admin-hero-outline">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Conseillers Gouverneur</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 5 KPI Metric Cards -->
    <div class="admin-kpi-grid">
        <!-- 1. Utilisateurs -->
        <a href="{{ path('app_admin_utilisateurs') }}" class="admin-kpi-card" title="Gérer les utilisateurs">
            <div class="admin-kpi-icon icon-kpi-users">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="admin-kpi-info">
                <div class="admin-kpi-value">{{ activeUsers }} <span style="font-size: 0.95rem; font-weight: 500; color: #94a3b8;">/ {{ totalUsers }}</span></div>
                <div class="admin-kpi-label">Utilisateurs Actifs</div>
            </div>
        </a>

        <!-- 2. Entités & Directions -->
        <a href="{{ path('app_admin_entites') }}" class="admin-kpi-card" title="Gérer l'organigramme">
            <div class="admin-kpi-icon icon-kpi-entites">
                <i class="bi bi-building"></i>
            </div>
            <div class="admin-kpi-info">
                <div class="admin-kpi-value">{{ totalEntites }}</div>
                <div class="admin-kpi-label">Directions & Entités</div>
            </div>
        </a>

        <!-- 3. Conseillers du Gouverneur -->
        <a href="{{ path('app_suivi_conseiller_admin') }}" class="admin-kpi-card" title="Gérer le collège des conseillers">
            <div class="admin-kpi-icon icon-kpi-conseillers">
                <i class="bi bi-person-workspace"></i>
            </div>
            <div class="admin-kpi-info">
                <div class="admin-kpi-value">{{ activeConseillers }} <span style="font-size: 0.95rem; font-weight: 500; color: #94a3b8;">/ {{ totalConseillers }}</span></div>
                <div class="admin-kpi-label">Conseillers Actifs</div>
            </div>
        </a>

        <!-- 4. Référentiels -->
        <a href="{{ path('app_admin_referentiels') }}" class="admin-kpi-card" title="Gérer les référentiels">
            <div class="admin-kpi-icon icon-kpi-referentiels">
                <i class="bi bi-sliders2"></i>
            </div>
            <div class="admin-kpi-info">
                <div class="admin-kpi-value">{{ totalTypes + totalPriorites }}</div>
                <div class="admin-kpi-label">Types & Priorités</div>
            </div>
        </a>

        <!-- 5. Audit -->
        <a href="{{ path('app_admin_audit') }}" class="admin-kpi-card" title="Consulter le journal d'audit">
            <div class="admin-kpi-icon icon-kpi-audit">
                <i class="bi bi-shield-check"></i>
            </div>
            <div class="admin-kpi-info">
                <div class="admin-kpi-value">{{ totalAudit }}</div>
                <div class="admin-kpi-label">Événements Journalisés</div>
            </div>
        </a>
    </div>

    <!-- Administration Modules Grid -->
    <div class="admin-section-header">
        <h5 class="admin-section-title">
            <i class="bi bi-grid-fill"></i>
            <span>Modules d'Administration Système</span>
        </h5>
        <span class="badge bg-light text-muted border">6 Modules Disponibles</span>
    </div>

    <div class="admin-modules-grid">
        <!-- Module 1: Conseillers du Gouverneur -->
        <a href="{{ path('app_suivi_conseiller_admin') }}" class="admin-module-card mod-conseillers">
            <div class="admin-module-top">
                <div class="admin-module-icon" style="background: #fef3c7; color: #d97706;">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <span class="admin-module-badge">{{ totalConseillers }} Profils</span>
            </div>
            <h3 class="admin-module-title">Conseillers du Gouverneur</h3>
            <p class="admin-module-desc">
                Configuration des domaines sectoriels (ECO_FIN, JUR_REG, SYS_INFO...), rattachement des utilisateurs et gestion des portefeuilles d'expertise.
            </p>
            <div class="admin-module-link">
                <span>Gérer le Collège</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <!-- Module 2: Utilisateurs & Habilitations -->
        <a href="{{ path('app_admin_utilisateurs') }}" class="admin-module-card mod-users">
            <div class="admin-module-top">
                <div class="admin-module-icon" style="background: #dcfce7; color: #16a34a;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <span class="admin-module-badge">{{ totalUsers }} Utilisateurs</span>
            </div>
            <h3 class="admin-module-title">Gestion des Utilisateurs</h3>
            <p class="admin-module-desc">
                Création et modification des comptes, attribution des rôles applicatifs (Admin, Cabinet, Direction), réinitialisation de mots de passe et statut actif/suspendu.
            </p>
            <div class="admin-module-link">
                <span>Gérer les Comptes</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <!-- Module 3: Entités & Organigramme BCC -->
        <a href="{{ path('app_admin_entites') }}" class="admin-module-card mod-entites">
            <div class="admin-module-top">
                <div class="admin-module-icon" style="background: #e0f2fe; color: #0284c7;">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <span class="admin-module-badge">{{ totalEntites }} Entités</span>
            </div>
            <h3 class="admin-module-title">Organigramme & Entités</h3>
            <p class="admin-module-desc">
                Définition de la structure organisationnelle de la Banque Centrale du Congo : Directions Générales, Départements, Cellules et Services opérationnels.
            </p>
            <div class="admin-module-link">
                <span>Gérer l'Organigramme</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <!-- Module 4: Référentiels Métier -->
        <a href="{{ path('app_admin_referentiels') }}" class="admin-module-card mod-referentiels">
            <div class="admin-module-top">
                <div class="admin-module-icon" style="background: #ede9fe; color: #7c3aed;">
                    <i class="bi bi-sliders"></i>
                </div>
                <span class="admin-module-badge">Nomenclatures</span>
            </div>
            <h3 class="admin-module-title">Référentiels & Paramètres</h3>
            <p class="admin-module-desc">
                Gestion des types d'instructions, niveaux de priorité, canaux de notification, types de relance et typologies d'entités organisationnelles.
            </p>
            <div class="admin-module-link">
                <span>Configurer les Référentiels</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <!-- Module 5: Journal d'Audit -->
        <a href="{{ path('app_admin_audit') }}" class="admin-module-card mod-audit">
            <div class="admin-module-top">
                <div class="admin-module-icon" style="background: #fee2e2; color: #dc2626;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <span class="admin-module-badge">Piste d'audit</span>
            </div>
            <h3 class="admin-module-title">Journal d'Audit Global</h3>
            <p class="admin-module-desc">
                Traçabilité intégrale, conformité institutionnelle et historique complet des créations, modifications, validations et suppressions du système.
            </p>
            <div class="admin-module-link">
                <span>Consulter l'Audit</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <!-- Module 6: Suivi des Instructions -->
        <a href="{{ path('app_instruction_index') }}" class="admin-module-card mod-instructions">
            <div class="admin-module-top">
                <div class="admin-module-icon" style="background: #ccfbf1; color: #0d9488;">
                    <i class="bi bi-journal-check"></i>
                </div>
                <span class="admin-module-badge">Supervision</span>
            </div>
            <h3 class="admin-module-title">Portefeuille Stratégique</h3>
            <p class="admin-module-desc">
                Vue transverse sur l'ensemble des instructions, décisions du Gouverneur et ordres de service en cours d'exécution au sein de la Banque.
            </p>
            <div class="admin-module-link">
                <span>Voir les Instructions</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>
    </div>

    <!-- Bottom Section: Live Activity Feed & System Diagnostic -->
    <div class="admin-bottom-grid">
        <!-- Left: Recent Activity Feed -->
        <div class="admin-panel-card">
            <div class="admin-panel-header">
                <h4 class="admin-panel-title">
                    <i class="bi bi-clock-history text-primary"></i>
                    <span>Dernières Activités du Système</span>
                </h4>
                <a href="{{ path('app_admin_audit') }}" class="btn btn-sm btn-outline-secondary" style="font-size: 0.76rem;">
                    Voir tout <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <div class="admin-panel-body">
                <div class="audit-list">
                    {% for log in recentAudit %}
                        {% set evtCode = log.typeEvenement.code|default('') %}
                        <div class="audit-row-item">
                            <div class="audit-dot {% if 'CREAT' in evtCode %}dot-success{% elseif 'SUPPR' in evtCode or 'SUPPRIM' in evtCode %}dot-danger{% elseif 'MODIF' in evtCode %}dot-primary{% elseif 'AFFECT' in evtCode %}dot-warning{% else %}dot-purple{% endif %}"></div>
                            <div class="audit-meta">
                                <div class="audit-header-line">
                                    <span class="audit-event-type">{{ log.typeEvenement.libelle }}</span>
                                    <span class="audit-time">{{ log.createdAt|date('d/m/Y H:i') }}</span>
                                </div>
                                <div class="audit-desc">{{ log.description }}</div>
                                <div class="audit-author">
                                    <i class="bi bi-person-circle me-1"></i>{{ log.utilisateur ? log.utilisateur.nomComplet : 'Système' }}
                                    {% if log.entite %}
                                        &bull; <span class="text-primary">{{ log.entite.code }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-inbox fs-3 d-block mb-1 opacity-50"></i>
                            Aucune activité consignée récemment.
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Right: Diagnostic & Environment Status -->
        <div class="admin-panel-card">
            <div class="admin-panel-header">
                <h4 class="admin-panel-title">
                    <i class="bi bi-cpu text-primary"></i>
                    <span>État & Environnement Système</span>
                </h4>
                <div class="status-online-pill">
                    <span class="status-pulse"></span>
                    <span>Opérationnel</span>
                </div>
            </div>
            <div class="admin-panel-body">
                <table class="sys-info-table">
                    <tbody>
                        <tr>
                            <td>Application</td>
                            <td class="sys-val">ACTIS-BCC v2.0</td>
                        </tr>
                        <tr>
                            <td>Institution</td>
                            <td class="sys-val">Banque Centrale du Congo</td>
                        </tr>
                        <tr>
                            <td>Cabinet</td>
                            <td class="sys-val">Cellule de Suivi Stratégique</td>
                        </tr>
                        <tr>
                            <td>Sécurité & Rôles</td>
                            <td class="sys-val"><span class="badge bg-success-subtle text-success">RBAC Actif</span></td>
                        </tr>
                        <tr>
                            <td>Piste d'audit</td>
                            <td class="sys-val"><span class="badge bg-primary-subtle text-primary">Intégrale (Détail JSON)</span></td>
                        </tr>
                        <tr>
                            <td>Base de données</td>
                            <td class="sys-val">MySQL / MariaDB</td>
                        </tr>
                        <tr>
                            <td>Serveur Local</td>
                            <td class="sys-val">PHP {{ constant('PHP_VERSION') }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                    <a href="{{ path('app_dashboard') }}" class="btn btn-sm btn-outline-primary" style="font-size: 0.8rem;">
                        <i class="bi bi-house-door me-1"></i> Tableau de bord
                    </a>
                    <a href="{{ path('app_export_instructions_csv') }}" class="btn btn-sm btn-secondary" style="font-size: 0.8rem;">
                        <i class="bi bi-download me-1"></i> Exporter Rapports
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
