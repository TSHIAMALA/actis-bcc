{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier Priorité' : 'Nouvelle Priorité' }} - ACTIS-BCC{% endblock %}

{% block stylesheets %}
<style>
.form-container-card {
    max-width: 800px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
    overflow: hidden;
}
.form-header-banner {
    background: linear-gradient(135deg, #091a2f 0%, #0f2744 50%, #1a3a60 100%);
    color: #ffffff;
    padding: 1.75rem 2rem;
}
.form-body-content {
    padding: 2rem;
}
.custom-form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}
@media (max-width: 768px) {
    .custom-form-grid-2 {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

    <!-- Top Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Administration</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_admin_referentiels', {'tab': 'priorites'}) }}">Priorités</a></li>
            <li class="breadcrumb-item active">{{ isEdit ? 'Modifier' : 'Nouvelle' }}</li>
        </ol>
    </nav>

    <div class="form-container-card">
        <div class="form-header-banner">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold text-white mb-1">
                        <i class="bi bi-flag-fill me-2 text-warning"></i>{{ isEdit ? 'Modifier la Priorité' : 'Nouvelle Priorité' }}
                    </h3>
                    <p class="text-white-50 small mb-0">Paramétrage des niveaux de criticité et d'urgence opérationnelle.</p>
                </div>
                <a href="{{ path('app_admin_referentiels', {'tab': 'priorites'}) }}" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Retour aux Priorités
                </a>
            </div>
        </div>

        <div class="form-body-content">
            {{ form_start(form) }}
                <div class="custom-form-grid-2 mb-3">
                    <div>
                        {{ form_label(form.code, 'Code *', {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                        {{ form_widget(form.code, {'attr': {'class': 'form-control text-uppercase', 'placeholder': 'Ex: URGENTE'}}) }}
                        {{ form_errors(form.code) }}
                    </div>
                    <div>
                        {{ form_label(form.libelle, 'Libellé *', {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                        {{ form_widget(form.libelle, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Urgente'}}) }}
                        {{ form_errors(form.libelle) }}
                    </div>
                </div>

                <div class="custom-form-grid-2 mb-3">
                    <div>
                        {{ form_label(form.niveau, 'Niveau de Criticité (1 à 10) *', {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                        {{ form_widget(form.niveau, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.niveau) }}
                    </div>
                    <div>
                        {{ form_label(form.ordreAffichage, 'Ordre d\'Affichage', {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                        {{ form_widget(form.ordreAffichage, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.ordreAffichage) }}
                    </div>
                </div>

                <div class="mb-4 pt-2">
                    <div class="form-check form-switch">
                        {{ form_widget(form.actif, {'attr': {'class': 'form-check-input', 'role': 'switch'}}) }}
                        {{ form_label(form.actif, 'Priorité Active', {'label_attr': {'class': 'form-check-label fw-semibold text-dark'}}) }}
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="{{ path('app_admin_referentiels', {'tab': 'priorites'}) }}" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> {{ isEdit ? 'Mettre à jour' : 'Enregistrer' }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
