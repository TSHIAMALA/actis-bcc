{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier Type d\'Instruction' : 'Nouveau Type d\'Instruction' }} - ACTIS-BCC{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">
            <i class="bi bi-journal-bookmark-fill text-primary"></i> 
            {{ isEdit ? 'Modifier le Type d\'Instruction' : 'Nouveau Type d\'Instruction' }}
        </h1>
        <p class="text-muted mb-0">Paramétrage du référentiel des natures d'ordres du Gouverneur</p>
    </div>
    <div>
        <a href="{{ path('app_admin_referentiels', {'tab': 'types_instruction'}) }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour aux Types
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle me-1 text-primary"></i> Informations du Type</h6>
            </div>
            <div class="card-body p-4">
                {{ form_start(form) }}
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_row(form.code) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.libelle) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(form.description) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.ordreAffichage) }}
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-4">
                            <div class="form-check form-switch fs-5">
                                {{ form_widget(form.actif, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.actif, null, {'label_attr': {'class': 'form-check-label fs-6 ms-2'}}) }}
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a href="{{ path('app_admin_referentiels', {'tab': 'types_instruction'}) }}" class="btn btn-light">Annuler</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> {{ isEdit ? 'Mettre à jour' : 'Enregistrer' }}
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
