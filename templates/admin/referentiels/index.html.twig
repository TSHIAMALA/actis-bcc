{% extends 'base.html.twig' %}

{% block title %}Référentiels & Paramètres Système - Administration - ACTIS-BCC{% endblock %}

{% block stylesheets %}
<style>
.admin-subpage-header {
    background: linear-gradient(135deg, #091a2f 0%, #0f2744 50%, #1a3a60 100%);
    color: #ffffff;
    border-radius: 16px;
    padding: 1.75rem 2rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 8px 24px rgba(9, 26, 47, 0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
}
.ref-tabs-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
    overflow: hidden;
}
.ref-tabs-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0.85rem 1.25rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}
.ref-tab-link {
    padding: 0.55rem 1rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: #64748b;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: all 0.2s ease;
    border: 1px solid transparent;
}
.ref-tab-link:hover {
    color: #0f172a;
    background: #ffffff;
    border-color: #e2e8f0;
}
.ref-tab-link.active {
    color: var(--actis-primary, #0d9488);
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
}
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

    <!-- Top Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}">Administration</a></li>
            <li class="breadcrumb-item active">Référentiels & Paramètres</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="admin-subpage-header">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge" style="background: rgba(255,255,255,0.15); color: #d4e3f5; font-size: 0.78rem; border: 1px solid rgba(255,255,255,0.2);">
                    <i class="bi bi-sliders me-1"></i> Nomenclatures Métier & Paramètres
                </span>
            </div>
            <h2 class="fw-bold text-white mb-1">Référentiels & Typologies Système</h2>
            <p class="text-white-50 small mb-0">Configuration des types d'instructions, niveaux de priorité, typologies d'entités, relances et canaux de diffusion.</p>
        </div>
        <div>
            <a href="{{ path('app_admin_index') }}" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Tableau Admin
            </a>
        </div>
    </div>

    <!-- Tabs Container Card -->
    <div class="ref-tabs-card">
        <!-- Tabs Nav -->
        <div class="ref-tabs-nav">
            <a class="ref-tab-link {% if activeTab == 'types_instruction' %}active{% endif %}" href="{{ path('app_admin_referentiels', {'tab': 'types_instruction'}) }}">
                <i class="bi bi-journal-bookmark-fill"></i>
                <span>Types d'Instruction ({{ typesInstruction|length }})</span>
            </a>
            <a class="ref-tab-link {% if activeTab == 'priorites' %}active{% endif %}" href="{{ path('app_admin_referentiels', {'tab': 'priorites'}) }}">
                <i class="bi bi-flag-fill"></i>
                <span>Priorités ({{ priorites|length }})</span>
            </a>
            <a class="ref-tab-link {% if activeTab == 'types_entite' %}active{% endif %}" href="{{ path('app_admin_referentiels', {'tab': 'types_entite'}) }}">
                <i class="bi bi-diagram-3-fill"></i>
                <span>Types d'Entité ({{ typesEntite|length }})</span>
            </a>
            <a class="ref-tab-link {% if activeTab == 'types_relance' %}active{% endif %}" href="{{ path('app_admin_referentiels', {'tab': 'types_relance'}) }}">
                <i class="bi bi-bell-fill"></i>
                <span>Types de Relance ({{ typesRelance|length }})</span>
            </a>
            <a class="ref-tab-link {% if activeTab == 'canaux' %}active{% endif %}" href="{{ path('app_admin_referentiels', {'tab': 'canaux'}) }}">
                <i class="bi bi-broadcast-pin"></i>
                <span>Canaux de Notification ({{ canaux|length }})</span>
            </a>
        </div>

        <div class="p-4">
            {# ================= TAB: TYPES D'INSTRUCTION ================= #}
            {% if activeTab == 'types_instruction' %}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-journal-text text-primary me-2"></i>Types d'Instructions & Ordres du Gouverneur</h5>
                    <a href="{{ path('app_admin_type_instruction_new') }}" class="btn btn-primary btn-sm fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Nouveau Type d'Instruction
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                <th style="width: 80px;">Ordre</th>
                                <th>Code</th>
                                <th>Libellé</th>
                                <th>Description</th>
                                <th style="width: 120px;">Statut</th>
                                <th style="text-align: right; width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in typesInstruction %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border">{{ item.ordreAffichage }}</span></td>
                                    <td><span class="badge bg-primary-subtle text-primary fw-bold">{{ item.code }}</span></td>
                                    <td class="fw-bold text-dark">{{ item.libelle }}</td>
                                    <td class="text-muted small">{{ item.description|default('—') }}</td>
                                    <td>
                                        {% if item.actif %}
                                            <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-check-circle-fill"></i> Actif
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-slash-circle"></i> Inactif
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="d-inline-flex gap-1">
                                            <a href="{{ path('app_admin_type_instruction_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_admin_type_instruction_toggle', {'id': item.id}) }}" onsubmit="return confirm('Basculer l\'état de ce type ?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_type_' ~ item.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-{{ item.actif ? 'warning' : 'success' }}" title="{{ item.actif ? 'Désactiver' : 'Activer' }}">
                                                    <i class="bi bi-{{ item.actif ? 'pause-circle-fill' : 'play-circle-fill' }}"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-muted py-4">Aucun type d'instruction configuré.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            {# ================= TAB: PRIORITÉS ================= #}
            {% elseif activeTab == 'priorites' %}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-flag text-primary me-2"></i>Niveaux de Priorité & Criticité</h5>
                    <a href="{{ path('app_admin_priorite_new') }}" class="btn btn-primary btn-sm fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Nouvelle Priorité
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                <th style="width: 80px;">Ordre</th>
                                <th>Code</th>
                                <th>Libellé</th>
                                <th>Niveau numérique</th>
                                <th style="width: 120px;">Statut</th>
                                <th style="text-align: right; width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in priorites %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border">{{ item.ordreAffichage }}</span></td>
                                    <td><span class="badge bg-primary-subtle text-primary fw-bold">{{ item.code }}</span></td>
                                    <td>
                                        <span class="badge {{ item.badgeClass }} px-2 py-1">{{ item.libelle }}</span>
                                    </td>
                                    <td><strong>{{ item.niveau }}</strong> / 10</td>
                                    <td>
                                        {% if item.actif %}
                                            <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-check-circle-fill"></i> Actif
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-slash-circle"></i> Inactif
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="d-inline-flex gap-1">
                                            <a href="{{ path('app_admin_priorite_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_admin_priorite_toggle', {'id': item.id}) }}" onsubmit="return confirm('Basculer l\'état de cette priorité ?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_priorite_' ~ item.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-{{ item.actif ? 'warning' : 'success' }}" title="{{ item.actif ? 'Désactiver' : 'Activer' }}">
                                                    <i class="bi bi-{{ item.actif ? 'pause-circle-fill' : 'play-circle-fill' }}"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-muted py-4">Aucune priorité configurée.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            {# ================= TAB: TYPES D'ENTITÉ ================= #}
            {% elseif activeTab == 'types_entite' %}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-diagram-3 text-primary me-2"></i>Niveaux & Typologies de l'Organigramme BCC</h5>
                    <a href="{{ path('app_admin_type_entite_new') }}" class="btn btn-primary btn-sm fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Nouveau Type d'Entité
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                <th style="width: 80px;">Ordre</th>
                                <th>Code</th>
                                <th>Libellé</th>
                                <th>Niveau hiérarchique</th>
                                <th>Description</th>
                                <th style="width: 120px;">Statut</th>
                                <th style="text-align: right; width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in typesEntite %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border">{{ item.ordreAffichage }}</span></td>
                                    <td><span class="badge bg-primary-subtle text-primary fw-bold">{{ item.code }}</span></td>
                                    <td class="fw-bold text-dark">{{ item.libelle }}</td>
                                    <td><span class="badge bg-info-subtle text-info border">Niveau {{ item.niveau }}</span></td>
                                    <td class="text-muted small">{{ item.description|default('—') }}</td>
                                    <td>
                                        {% if item.actif %}
                                            <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-check-circle-fill"></i> Actif
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-slash-circle"></i> Inactif
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="d-inline-flex gap-1">
                                            <a href="{{ path('app_admin_type_entite_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_admin_type_entite_toggle', {'id': item.id}) }}" onsubmit="return confirm('Basculer l\'état de ce type d\'entité ?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_type_entite_' ~ item.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-{{ item.actif ? 'warning' : 'success' }}" title="{{ item.actif ? 'Désactiver' : 'Activer' }}">
                                                    <i class="bi bi-{{ item.actif ? 'pause-circle-fill' : 'play-circle-fill' }}"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="7" class="text-center text-muted py-4">Aucun type d'entité configuré.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            {# ================= TAB: TYPES DE RELANCE ================= #}
            {% elseif activeTab == 'types_relance' %}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-bell text-primary me-2"></i>Règles & Déclencheurs de Relance Automatisée</h5>
                    <a href="{{ path('app_admin_type_relance_new') }}" class="btn btn-primary btn-sm fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Nouveau Type de Relance
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                <th style="width: 80px;">Ordre</th>
                                <th>Code</th>
                                <th>Libellé</th>
                                <th>Description</th>
                                <th style="width: 120px;">Statut</th>
                                <th style="text-align: right; width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in typesRelance %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border">{{ item.ordreAffichage }}</span></td>
                                    <td><span class="badge bg-primary-subtle text-primary fw-bold">{{ item.code }}</span></td>
                                    <td class="fw-bold text-dark">{{ item.libelle }}</td>
                                    <td class="text-muted small">{{ item.description|default('—') }}</td>
                                    <td>
                                        {% if item.actif %}
                                            <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-check-circle-fill"></i> Actif
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-slash-circle"></i> Inactif
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="d-inline-flex gap-1">
                                            <a href="{{ path('app_admin_type_relance_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_admin_type_relance_toggle', {'id': item.id}) }}" onsubmit="return confirm('Basculer l\'état de ce type de relance ?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_type_relance_' ~ item.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-{{ item.actif ? 'warning' : 'success' }}" title="{{ item.actif ? 'Désactiver' : 'Activer' }}">
                                                    <i class="bi bi-{{ item.actif ? 'pause-circle-fill' : 'play-circle-fill' }}"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-muted py-4">Aucun type de relance configuré.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            {# ================= TAB: CANAUX DE NOTIFICATION ================= #}
            {% elseif activeTab == 'canaux' %}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-broadcast-pin text-primary me-2"></i>Canaux de Notification & Vecteurs d'Alerte</h5>
                    <a href="{{ path('app_admin_canal_new') }}" class="btn btn-primary btn-sm fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Nouveau Canal
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                <th style="width: 80px;">Ordre</th>
                                <th>Code</th>
                                <th>Libellé</th>
                                <th style="width: 120px;">Statut</th>
                                <th style="text-align: right; width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in canaux %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border">{{ item.ordreAffichage }}</span></td>
                                    <td><span class="badge bg-primary-subtle text-primary fw-bold">{{ item.code }}</span></td>
                                    <td class="fw-bold text-dark">{{ item.libelle }}</td>
                                    <td>
                                        {% if item.actif %}
                                            <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-check-circle-fill"></i> Actif
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-slash-circle"></i> Inactif
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="d-inline-flex gap-1">
                                            <a href="{{ path('app_admin_canal_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_admin_canal_toggle', {'id': item.id}) }}" onsubmit="return confirm('Basculer l\'état de ce canal ?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_canal_' ~ item.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-{{ item.actif ? 'warning' : 'success' }}" title="{{ item.actif ? 'Désactiver' : 'Activer' }}">
                                                    <i class="bi bi-{{ item.actif ? 'pause-circle-fill' : 'play-circle-fill' }}"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="text-center text-muted py-4">Aucun canal configuré.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
