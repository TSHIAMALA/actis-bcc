{% extends 'base.html.twig' %}

{% block title %}Organigramme & Entités - Administration{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2 class="page-title">Entités Organisationnelles</h2>
        <p class="page-subtitle">Structure hiérarchique : Directions Générales, Directions et Services de la BCC</p>
    </div>
    <div>
        <a href="{{ path('app_admin_entite_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Nouvelle Entité
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-diagram-3-fill"></i> Liste des Entités ({{ entites|length }})</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Code / Sigle</th>
                        <th>Nom de l'Entité</th>
                        <th>Type d'Entité</th>
                        <th>Rattachement Parente</th>
                        <th>Statut</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for e in entites %}
                        <tr>
                            <td><strong>{{ e.code }}</strong></td>
                            <td>{{ e.nom }}</td>
                            <td><span class="badge badge-secondary">{{ e.typeEntite.libelle }}</span></td>
                            <td>{{ e.parent ? e.parent.nomComplet : '<span class="text-muted">Racine (Aucun)</span>'|raw }}</td>
                            <td>
                                {% if e.actif %}
                                    <span class="badge badge-success">Actif</span>
                                {% else %}
                                    <span class="badge badge-danger">Inactif</span>
                                {% endif %}
                            </td>
                            <td style="text-align: right;">
                                <div class="d-flex justify-content-end gap-1">
                                    <a href="{{ path('app_admin_entite_edit', {'id': e.id}) }}" class="btn btn-secondary btn-sm" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_admin_entite_toggle_actif', {'id': e.id}) }}" onsubmit="return confirm('Voulez-vous {{ e.actif ? 'désactiver' : 'activer' }} l\'entité {{ e.nom|e('js') }} ?');" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_entite_' ~ e.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-{{ e.actif ? 'warning' : 'success' }}" title="{{ e.actif ? 'Désactiver l\'entité' : 'Activer l\'entité' }}">
                                            <i class="bi bi-{{ e.actif ? 'pause-circle' : 'play-circle' }}"></i>
                                        </button>
                                    </form>
                                    {% if e.actif %}
                                        <form method="post" action="{{ path('app_admin_entite_delete', {'id': e.id}) }}" onsubmit="return confirm('Confirmez-vous l\'archivage / suppression logique de l\'entité {{ e.nom|e('js') }} ?');" style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_entite_' ~ e.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Archiver / Suppression logique">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
