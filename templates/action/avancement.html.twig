{% extends 'base.html.twig' %}

{% block title %}Mettre à jour l'avancement - {{ action.libelle }}{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2 class="page-title">Mise à Jour de l'Avancement</h2>
        <p class="page-subtitle">Action : <strong>{{ action.libelle }}</strong> ({{ action.instruction.reference }})</p>
    </div>
    <div>
        <a href="{{ path('app_action_show', {'id': action.id}) }}" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="card" style="max-width: 750px; margin: 0 auto;">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-speedometer2" style="color: var(--bcc-gold);"></i> Saisie du Taux d'Exécution & Preuves</h3>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
            <!-- Interactive Slider Gauge -->
            <div style="background: var(--bg-main); padding: 24px; border-radius: var(--radius-lg); text-align: center; margin-bottom: 24px;">
                <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700;">Niveau d'Avancement Réalisé</div>
                <div id="gaugeDisplay" style="font-size: 3rem; font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--bcc-navy); margin: 6px 0;">
                    {{ action.tauxAvancement }} %
                </div>
                
                <div style="max-width: 400px; margin: 0 auto;">
                    {{ form_widget(form.tauxAvancement, {'id': 'inputAvancement', 'attr': {'oninput': 'updateGauge(this.value)'}}) }}
                </div>
                <div style="display: flex; justify-content: space-between; max-width: 400px; margin: 6px auto 0; font-size: 0.75rem; color: var(--text-muted);">
                    <span>0% Non démarré</span>
                    <span>50% En cours</span>
                    <span>100% Finalisé</span>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    {{ form_label(form.statut, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.statut) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.dateRealisation, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.dateRealisation, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.dateRealisation) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.resultatObtenu, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.resultatObtenu, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                <small style="color: var(--text-muted); font-size: 0.75rem;">Indiquez les réalisations concrètes obtenues ou les blocages rencontrés.</small>
                {{ form_errors(form.resultatObtenu) }}
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
                <a href="{{ path('app_action_show', {'id': action.id}) }}" class="btn btn-secondary">Annuler</a>
                <button type="submit" class="btn btn-gold">
                    <i class="bi bi-check2-all"></i> Enregistrer l'avancement
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
function updateGauge(val) {
    document.getElementById('gaugeDisplay').innerText = Math.round(val) + ' %';
}
</script>
{% endblock %}
