<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ACTIS-BCC{% endblock %} - Suivi des Instructions du Gouverneur | Banque Centrale du Congo</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="{{ asset('images/icon.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/icon.png') }}">
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    
    <!-- TomSelect (Searchable Dropdowns) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <!-- TomSelect JS -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% if app.user %}
        <!-- Mobile Overlay Backdrop -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="app-wrapper">
            <!-- Sidebar — ACTIS Sovereign Navy -->
            <aside class="sidebar actis-sidebar" id="sidebar">
                <!-- Sidebar Brand / Logo -->
                <div class="sidebar-brand-container">
                    <a href="{{ path('app_dashboard') }}" class="actis-brand-logo">
                        <div class="actis-logo-mark">
                            <svg viewBox="0 0 100 100" class="logo-triangle-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M50 8 L90 85 H70 L50 42 L30 85 H10 L50 8Z" fill="#1D8CF8" />
                                <path d="M50 24 L78 80 H64 L50 50 L36 80 H22 L50 24Z" fill="#0D47A1" />
                                <!-- Rising Golden Trend Arrow -->
                                <path d="M28 78 L45 58 L58 66 L78 32" stroke="#E5A93C" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M68 32 H78 V42" stroke="#E5A93C" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                                <!-- Mini bars inside -->
                                <rect x="34" y="66" width="5" height="10" rx="1.5" fill="#E5A93C" opacity="0.9"/>
                                <rect x="44" y="58" width="5" height="18" rx="1.5" fill="#E5A93C" opacity="0.9"/>
                                <rect x="54" y="50" width="5" height="26" rx="1.5" fill="#E5A93C" opacity="0.9"/>
                            </svg>
                        </div>
                        <div class="actis-brand-title">ACTIS</div>
                        <div class="actis-brand-slogan">DE L'INSTRUCTION À L'IMPACT</div>
                    </a>
                </div>

                <!-- Navigation items -->
                <nav class="sidebar-nav">
                    <a href="{{ path('app_dashboard') }}" class="actis-nav-item {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                        <i class="bi bi-house-door-fill nav-icon"></i>
                        <span>Tableau de bord</span>
                    </a>

                    <a href="{{ path('app_instruction_index') }}" class="actis-nav-item {% if 'app_instruction' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-file-earmark-text nav-icon"></i>
                        <span>Instructions</span>
                    </a>

                    <a href="{{ path('app_action_index') }}" class="actis-nav-item {% if 'app_action' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-check2-square nav-icon"></i>
                        <span>Actions</span>
                    </a>

                    <a href="{{ path('app_action_index', {'retard': '1'}) }}" class="actis-nav-item {% if 'app_prorogation' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-calendar3 nav-icon"></i>
                        <span>Échéances</span>
                    </a>

                    <a href="{{ path('app_admin_entites') }}" class="actis-nav-item {% if 'app_admin_entite' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-diagram-3 nav-icon"></i>
                        <span>Entités</span>
                    </a>

                    <a href="{{ path('app_relance_index') }}" class="actis-nav-item {% if 'app_relance' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-send nav-icon"></i>
                        <span>Relances</span>
                    </a>

                    <a href="{{ path('app_export_instructions_csv') }}" class="actis-nav-item">
                        <i class="bi bi-bar-chart-line nav-icon"></i>
                        <span>Rapports</span>
                    </a>

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="actis-nav-group {% if 'app_admin' in app.request.attributes.get('_route') %}open{% endif %}" id="navGroupAdmin">
                            <button class="actis-nav-item actis-nav-dropdown-btn" onclick="toggleNavGroup('navGroupAdmin')" type="button">
                                <i class="bi bi-gear nav-icon"></i>
                                <span>Administration</span>
                                <i class="bi bi-chevron-down nav-dropdown-chevron"></i>
                            </button>
                            <div class="actis-submenu">
                                <a href="{{ path('app_admin_index') }}" class="submenu-item {% if app.request.attributes.get('_route') == 'app_admin_index' %}active{% endif %}">
                                    Vue d'ensemble
                                </a>
                                <a href="{{ path('app_admin_referentiels') }}" class="submenu-item {% if 'app_admin_type' in app.request.attributes.get('_route') or 'app_admin_priorite' in app.request.attributes.get('_route') or 'app_admin_canal' in app.request.attributes.get('_route') or app.request.attributes.get('_route') == 'app_admin_referentiels' %}active{% endif %}">
                                    Référentiels & Types
                                </a>
                                <a href="{{ path('app_admin_utilisateurs') }}" class="submenu-item {% if 'app_admin_utilisateurs' in app.request.attributes.get('_route') %}active{% endif %}">
                                    Utilisateurs & Rôles
                                </a>
                                <a href="{{ path('app_admin_entites') }}" class="submenu-item {% if 'app_admin_entites' in app.request.attributes.get('_route') %}active{% endif %}">
                                    Organigramme Entités
                                </a>
                                <a href="{{ path('app_admin_audit') }}" class="submenu-item {% if app.request.attributes.get('_route') == 'app_admin_audit' %}active{% endif %}">
                                    Journal d'audit
                                </a>
                            </div>
                        </div>
                    {% endif %}
                </nav>

                <!-- Sidebar Footer with BCC architectural illustration -->
                <div class="sidebar-bcc-footer">
                    <div class="bcc-building-art">
                        <svg viewBox="0 0 160 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="building-svg">
                            <!-- Building Wireframe -->
                            <rect x="20" y="28" width="40" height="52" stroke="rgba(255,255,255,0.18)" stroke-width="1.2" fill="rgba(15,35,70,0.3)"/>
                            <rect x="25" y="34" width="6" height="8" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="35" y="34" width="6" height="8" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="45" y="34" width="6" height="8" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="25" y="46" width="6" height="8" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="35" y="46" width="6" height="8" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="45" y="46" width="6" height="8" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="25" y="58" width="6" height="8" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="35" y="58" width="6" height="8" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="45" y="58" width="6" height="8" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>

                            <!-- Main Tower -->
                            <rect x="65" y="10" width="50" height="70" stroke="rgba(255,255,255,0.22)" stroke-width="1.2" fill="rgba(15,35,70,0.4)"/>
                            <line x1="65" y1="22" x2="115" y2="22" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"/>
                            <line x1="65" y1="34" x2="115" y2="34" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"/>
                            <line x1="65" y1="46" x2="115" y2="46" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"/>
                            <line x1="65" y1="58" x2="115" y2="58" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"/>
                            <line x1="65" y1="70" x2="115" y2="70" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"/>
                            <line x1="77" y1="10" x2="77" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"/>
                            <line x1="90" y1="10" x2="90" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"/>
                            <line x1="103" y1="10" x2="103" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="0.8"/>

                            <!-- Right Wing -->
                            <rect x="120" y="38" width="30" height="42" stroke="rgba(255,255,255,0.18)" stroke-width="1.2" fill="rgba(15,35,70,0.3)"/>
                            <rect x="125" y="44" width="5" height="7" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="135" y="44" width="5" height="7" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="125" y="56" width="5" height="7" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>
                            <rect x="135" y="56" width="5" height="7" stroke="rgba(255,255,255,0.12)" stroke-width="0.8"/>

                            <line x1="10" y1="80" x2="155" y2="80" stroke="rgba(255,255,255,0.25)" stroke-width="1.2"/>
                        </svg>
                    </div>
                    <div class="bcc-footer-name">BANQUE CENTRALE DU CONGO</div>
                    <div class="bcc-footer-slogan">DE L'INSTRUCTION À L'IMPACT</div>
                </div>
            </aside>

            <!-- Main Page Content -->
            <div class="main-wrapper">
                <!-- Topbar Header -->
                <header class="bcc-topbar">
                    <div class="topbar-brand-motto">
                        <button class="mobile-toggle" id="mobileToggle" title="Menu" type="button">
                            <i class="bi bi-list"></i>
                        </button>
                        <div class="motto-text-group">
                            <div class="motto-main">BANQUE CENTRALE DU CONGO</div>
                            <div class="motto-sub">STABILITÉ &bull; CONFIANCE &bull; DÉVELOPPEMENT</div>
                        </div>
                    </div>

                    <div class="topbar-search-wrapper">
                        <form action="{{ path('app_instruction_index') }}" method="get" class="bcc-search-box">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" name="q" placeholder="Rechercher une instruction, une action, une entité..." value="{{ app.request.query.get('q') }}">
                        </form>
                    </div>

                    <div class="topbar-user-section">
                        <!-- Notification Bell with red badge -->
                        <a href="{{ path('app_relance_index') }}" class="bcc-bell-btn" title="Notifications et relances">
                            <i class="bi bi-bell"></i>
                            <span class="bell-badge-count">3</span>
                        </a>

                        <!-- User Profile pill (Clickable) -->
                        <div class="bcc-user-profile-menu" id="userProfileMenu" onclick="toggleUserMenu(event)">
                            <div class="user-avatar-circle">
                                {{ app.user.prenom|slice(0, 1)|upper }}{{ app.user.nom|slice(0, 1)|upper }}
                            </div>
                            <div class="user-profile-meta">
                                <span class="user-full-name">{{ app.user.nomComplet }}</span>
                                <span class="user-entity-dept">{{ app.user.entite ? app.user.entite.nom : "Cellule d'Innovation" }}</span>
                            </div>
                            <i class="bi bi-chevron-down user-chevron"></i>

                            <!-- Dropdown options -->
                            <div class="user-dropdown-popover" id="userDropdownPopover" onclick="event.stopPropagation()">
                                <div class="dropdown-header-info">
                                    <strong>{{ app.user.nomComplet }}</strong>
                                    <small>{{ app.user.email }}</small>
                                </div>
                                <hr class="dropdown-divider-line">
                                <a href="{{ path('app_action_index', {'my_actions': '1'}) }}" class="dropdown-item">
                                    <i class="bi bi-check2-circle"></i> Mes actions
                                </a>
                                <a href="{{ path('app_instruction_index') }}" class="dropdown-item">
                                    <i class="bi bi-journal-text"></i> Instructions
                                </a>
                                <hr class="dropdown-divider-line">
                                <a href="{{ path('app_logout') }}" class="dropdown-item text-danger font-bold">
                                    <i class="bi bi-box-arrow-right"></i> Se déconnecter
                                </a>
                            </div>
                        </div>

                        <!-- Direct 1-Click Logout Button -->
                        <a href="{{ path('app_logout') }}" class="bcc-direct-logout-btn" title="Se déconnecter de l'application">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="logout-text">Déconnexion</span>
                        </a>
                    </div>
                </header>

                <!-- Page body -->
                <main class="content-container">
                    {# Flash messages #}
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }}">
                                {% if label == 'success' %}<i class="bi bi-check-circle-fill"></i>{% endif %}
                                {% if label == 'warning' %}<i class="bi bi-exclamation-triangle-fill"></i>{% endif %}
                                {% if label == 'danger' %}<i class="bi bi-x-circle-fill"></i>{% endif %}
                                {% if label == 'info' %}<i class="bi bi-info-circle-fill"></i>{% endif %}
                                <span>{{ message }}</span>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>

        <script>
        // ── Sidebar Collapse Toggle ──
        const sidebar = document.getElementById('sidebar');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const SIDEBAR_KEY = 'actis_sidebar_collapsed';

        // Restore sidebar state
        if (localStorage.getItem(SIDEBAR_KEY) === 'true') {
            sidebar.classList.add('collapsed');
        }

        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', function() {
                sidebar.classList.toggle('collapsed');
                localStorage.setItem(SIDEBAR_KEY, sidebar.classList.contains('collapsed'));
            });
        }

        // ── Mobile Sidebar Toggle ──
        const mobileToggle = document.getElementById('mobileToggle');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        if (mobileToggle) {
            mobileToggle.addEventListener('click', function() {
                sidebar.classList.toggle('mobile-open');
                sidebarOverlay.classList.toggle('active');
            });
        }

        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', function() {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('active');
            });
        }

        // ── User Dropdown Menu Toggle ──
        function toggleUserMenu(e) {
            e.stopPropagation();
            const popover = document.getElementById('userDropdownPopover');
            if (popover) {
                popover.classList.toggle('show');
            }
        }

        // Close user dropdown on outside click
        document.addEventListener('click', function(e) {
            const popover = document.getElementById('userDropdownPopover');
            const menu = document.getElementById('userProfileMenu');
            if (popover && popover.classList.contains('show')) {
                if (menu && !menu.contains(e.target)) {
                    popover.classList.remove('show');
                }
            }
        });
        </script>
    {% else %}
        {% block login_body %}{% endblock %}
    {% endif %}

    {% block javascripts %}{% endblock %}
</body>
</html>
