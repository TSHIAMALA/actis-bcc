<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ACTIS-BCC{% endblock %} - Suivi des Instructions du Gouverneur | Banque Centrale du Congo</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="{{ asset('images/icon.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/icon.png') }}">
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    
    <!-- TomSelect (Searchable Dropdowns) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <!-- TomSelect JS -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% if app.user %}
        <!-- Mobile Overlay Backdrop -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="app-wrapper">
            <!-- Sidebar — ACTIS Sovereign -->
            <aside class="sidebar" id="sidebar">
                <div class="sidebar-brand">
                    <img src="{{ asset('images/icon.png') }}" alt="ACTIS-BCC" class="brand-logo-img">
                    <div class="brand-text">
                        <h1>ACTIS-BCC</h1>
                        <p>Suivi des Instructions</p>
                    </div>
                    <!-- Collapse Toggle Button -->
                    <button class="sidebar-toggle" id="sidebarToggle" title="Réduire / Étendre">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                </div>

                <nav class="sidebar-nav">
                    <!-- Section: Pilotage -->
                    <div class="nav-section-title">Pilotage Exécutif</div>
                    <a href="{{ path('app_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                        <i class="bi bi-speedometer2 icon"></i>
                        <span>Tableau de bord</span>
                    </a>

                    <!-- Section: Gestion Opérationnelle -->
                    <div class="nav-section-title">Gestion Opérationnelle</div>
                    <a href="{{ path('app_instruction_index') }}" class="nav-link {% if 'app_instruction' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-journal-bookmark-fill icon"></i>
                        <span>Instructions & OS</span>
                    </a>
                    <a href="{{ path('app_action_index') }}" class="nav-link {% if 'app_action' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-check2-square icon"></i>
                        <span>Actions de suivi</span>
                    </a>
                    <a href="{{ path('app_prorogation_index') }}" class="nav-link {% if 'app_prorogation' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-calendar-range icon"></i>
                        <span>Prorogations</span>
                    </a>
                    <a href="{{ path('app_relance_index') }}" class="nav-link {% if 'app_relance' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-bell-fill icon"></i>
                        <span>Relances & Alertes</span>
                    </a>

                    {% if is_granted('ROLE_ADMIN') %}
                        <!-- Section: Administration — Submenu Accordion -->
                        <div class="nav-section-title">Administration</div>
                        <div class="nav-group {% if 'app_admin' in app.request.attributes.get('_route') %}open{% endif %}" id="navGroupAdmin">
                            <button class="nav-group-toggle" onclick="toggleNavGroup('navGroupAdmin')">
                                <i class="bi bi-gear-wide-connected icon"></i>
                                <span>Administration</span>
                                <i class="bi bi-chevron-right nav-chevron"></i>
                            </button>
                            <div class="nav-submenu">
                                <a href="{{ path('app_admin_index') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_index' %}active{% endif %}">
                                    <span>Vue d'ensemble</span>
                                </a>
                                <a href="{{ path('app_admin_referentiels') }}" class="nav-link {% if 'app_admin_type' in app.request.attributes.get('_route') or 'app_admin_priorite' in app.request.attributes.get('_route') or 'app_admin_canal' in app.request.attributes.get('_route') or app.request.attributes.get('_route') == 'app_admin_referentiels' %}active{% endif %}">
                                    <span>Référentiels & Types</span>
                                </a>
                                <a href="{{ path('app_admin_utilisateurs') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_utilisateurs' or app.request.attributes.get('_route') == 'app_admin_user_new' or app.request.attributes.get('_route') == 'app_admin_user_edit' %}active{% endif %}">
                                    <span>Utilisateurs & Rôles</span>
                                </a>
                                <a href="{{ path('app_admin_entites') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_entites' or app.request.attributes.get('_route') == 'app_admin_entite_new' or app.request.attributes.get('_route') == 'app_admin_entite_edit' %}active{% endif %}">
                                    <span>Organigramme Entités</span>
                                </a>
                                <a href="{{ path('app_admin_audit') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_audit' %}active{% endif %}">
                                    <span>Journal d'audit</span>
                                </a>
                            </div>
                        </div>
                    {% endif %}
                </nav>

                <div class="sidebar-footer">
                    <div class="user-snippet">
                        <div class="user-avatar">
                            {{ app.user.prenom|slice(0, 1)|upper }}{{ app.user.nom|slice(0, 1)|upper }}
                        </div>
                        <div class="user-info">
                            <div class="user-name">{{ app.user.nomComplet }}</div>
                            <div class="user-role">{{ app.user.entite ? app.user.entite.code : 'BCC' }} &bull; {{ app.user.primaryRoleLabel }}</div>
                        </div>
                        <a href="{{ path('app_logout') }}" class="btn-logout" title="Déconnexion">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Main Page Content -->
            <div class="main-wrapper">
                <!-- Topbar — Frost Glass -->
                <header class="topbar">
                    <div class="topbar-left">
                        <button class="mobile-toggle" id="mobileToggle" title="Menu">
                            <i class="bi bi-list"></i>
                        </button>
                        <form action="{{ path('app_instruction_index') }}" method="get" class="topbar-search">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" name="q" placeholder="Rechercher une référence, objet, mot-clé..." value="{{ app.request.query.get('q') }}">
                        </form>
                    </div>

                    <div class="topbar-actions">
                        <div class="topbar-datetime" id="topbarDatetime">
                            <i class="bi bi-calendar3"></i>
                            <span id="datetimeDisplay"></span>
                        </div>
                        <a href="{{ path('app_instruction_new') }}" class="btn-quick-new">
                            <i class="bi bi-plus-lg"></i>
                            <span>Nouvelle Instruction</span>
                        </a>
                        <a href="{{ path('app_export_instructions_csv') }}" class="btn btn-secondary btn-sm" title="Exporter toutes les instructions en CSV">
                            <i class="bi bi-file-earmark-spreadsheet"></i> Exporter
                        </a>
                    </div>
                </header>

                <!-- Page body -->
                <main class="content-container">
                    {# Flash messages #}
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }}">
                                {% if label == 'success' %}<i class="bi bi-check-circle-fill"></i>{% endif %}
                                {% if label == 'warning' %}<i class="bi bi-exclamation-triangle-fill"></i>{% endif %}
                                {% if label == 'danger' %}<i class="bi bi-x-circle-fill"></i>{% endif %}
                                {% if label == 'info' %}<i class="bi bi-info-circle-fill"></i>{% endif %}
                                <span>{{ message }}</span>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>

        <script>
        // ── Sidebar Collapse Toggle ──
        const sidebar = document.getElementById('sidebar');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const SIDEBAR_KEY = 'actis_sidebar_collapsed';

        // Restore sidebar state
        if (localStorage.getItem(SIDEBAR_KEY) === 'true') {
            sidebar.classList.add('collapsed');
        }

        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', function() {
                sidebar.classList.toggle('collapsed');
                localStorage.setItem(SIDEBAR_KEY, sidebar.classList.contains('collapsed'));
            });
        }

        // ── Mobile Sidebar Toggle ──
        const mobileToggle = document.getElementById('mobileToggle');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        if (mobileToggle) {
            mobileToggle.addEventListener('click', function() {
                sidebar.classList.toggle('mobile-open');
                sidebarOverlay.classList.toggle('active');
            });
        }

        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', function() {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('active');
            });
        }

        // ── Nav Group Accordion Toggle ──
        function toggleNavGroup(groupId) {
            const group = document.getElementById(groupId);
            if (group) {
                group.classList.toggle('open');
            }
        }

        // ── Live DateTime ──
        function updateDateTime() {
            const now = new Date();
            const options = { 
                weekday: 'short', 
                day: '2-digit', 
                month: 'short', 
                year: 'numeric',
                hour: '2-digit', 
                minute: '2-digit'
            };
            const display = document.getElementById('datetimeDisplay');
            if (display) {
                display.textContent = now.toLocaleDateString('fr-FR', options);
            }
        }
        updateDateTime();
        setInterval(updateDateTime, 30000);
        </script>
    {% else %}
        {% block login_body %}{% endblock %}
    {% endif %}

    {% block javascripts %}{% endblock %}
</body>
</html>
