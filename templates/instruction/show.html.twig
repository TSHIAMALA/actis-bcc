{% extends 'base.html.twig' %}

{% block title %}{{ instruction.reference }} - Cockpit 360°{% endblock %}

{% block body %}
{% if instruction.isDeleted %}
    <div class="alert alert-danger d-flex justify-content-between align-items-center mb-4" style="border-left: 5px solid var(--color-danger);">
        <div>
            <i class="bi bi-trash-fill fs-4 me-2"></i>
            <strong>Instruction archivée / supprimée logiquement</strong> le {{ instruction.deletedAt|date('d/m/Y à H:i') }}.
            {% if instruction.motifSuppression %}
                <div class="mt-1 small"><strong>Motif :</strong> {{ instruction.motifSuppression }}</div>
            {% endif %}
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <form method="post" action="{{ path('app_instruction_restore', {'id': instruction.id}) }}" onsubmit="return confirm('Confirmez-vous la restauration de cette instruction ?');" class="m-0">
                <input type="hidden" name="_token" value="{{ csrf_token('restore_instruction_' ~ instruction.id) }}">
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="bi bi-arrow-counterclockwise"></i> Restaurer l'Instruction
                </button>
            </form>
        {% endif %}
    </div>
{% endif %}

<!-- Page Header -->
<div class="page-header">
    <div>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
            <h2 class="page-title" style="margin: 0;">{{ instruction.reference }}</h2>
            <span class="badge {{ instruction.statut.badgeClass }}" style="font-size: 0.85rem;">{{ instruction.statut.libelle }}</span>
            <span class="badge {{ instruction.priorite.badgeClass }}" style="font-size: 0.85rem;">{{ instruction.priorite.libelle }}</span>
            {% if instruction.isEnRetard %}
                <span class="badge badge-danger" style="font-size: 0.85rem;"><i class="bi bi-alarm-fill"></i> En retard</span>
            {% endif %}
            {% if instruction.isDeleted %}
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.85rem;"><i class="bi bi-trash"></i> Archivée</span>
            {% endif %}
        </div>
        <p class="page-subtitle" style="font-size: 1.05rem; font-weight: 600; color: var(--bcc-navy);">
            {{ instruction.objet }}
        </p>
    </div>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <a href="{{ path('app_export_instruction_fiche', {'id': instruction.id}) }}" target="_blank" class="btn btn-secondary btn-sm" title="Fiche synthétique imprimable pour le Gouverneur">
            <i class="bi bi-printer"></i> Fiche Synthétique
        </a>
        {% if not instruction.isDeleted %}
            <a href="{{ path('app_relance_new', {'instruction_id': instruction.id}) }}" class="btn btn-secondary btn-sm" title="Transmettre une relance formelle">
                <i class="bi bi-bell"></i> Relancer
            </a>
            <a href="{{ path('app_prorogation_demande', {'instruction_id': instruction.id}) }}" class="btn btn-secondary btn-sm" title="Demander un report d'échéance">
                <i class="bi bi-calendar-plus"></i> Prorogation
            </a>
            <button type="button" class="btn btn-gold btn-sm" onclick="openAiActionsModal()" title="Extraire automatiquement des actions par IA à partir d'un document ou scan" style="background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%); color: #FFFFFF; border: none; font-weight: 600; box-shadow: 0 2px 8px rgba(13, 148, 136, 0.35);">
                <i class="bi bi-stars"></i> Générer Actions IA
            </button>
            <a href="{{ path('app_action_new', {'instructionId': instruction.id}) }}" class="btn btn-secondary btn-sm">
                <i class="bi bi-plus-circle"></i> Ajouter manuellement
            </a>
            <a href="{{ path('app_instruction_edit', {'id': instruction.id}) }}" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            <button type="button" class="btn btn-outline-danger btn-sm" onclick="document.getElementById('modalDeleteInstruction').style.display = 'flex'" title="Supprimer logiquement cette instruction">
                <i class="bi bi-trash"></i> Supprimer
            </button>
        {% endif %}
    </div>
</div>

<!-- Grid Overview -->
<div class="grid-2" style="margin-bottom: 24px;">
    <!-- General Info Card -->
    <div class="card" style="margin-bottom: 0;">
        <div class="card-header">
            <h3 class="card-title"><i class="bi bi-info-circle-fill" style="color: var(--bcc-navy-light);"></i> Informations Générales & Pilotage</h3>
            <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('modalChangeStatut').style.display = 'flex'">
                <i class="bi bi-arrow-left-right"></i> Changer le Statut
            </button>
        </div>
        <div class="card-body">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Type d'Instruction</div>
                    <div style="font-weight: 600;">{{ instruction.typeInstruction.libelle }}</div>
                </div>
                <div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Émetteur</div>
                    <div style="font-weight: 600;">{{ instruction.emetteur|default('Gouverneur de la BCC') }}</div>
                </div>
                <div style="grid-column: 1 / -1;">
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Conseillers responsables</div>
                    <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px;">
                        {% for c in instruction.responsables %}
                            <span title="{{ c.domaineCompetence }}" style="display: inline-flex; align-items: center; gap: 6px; background: #F0FDFA; border: 1px solid #99F6E4; color: #0F766E; border-radius: 999px; padding: 3px 10px; font-size: 0.8rem; font-weight: 600;">
                                <i class="bi bi-person-badge"></i> {{ c.nom }}
                                <span style="font-weight: 400; color: #0F766E; opacity: 0.8;">· {{ c.codeDomaine }}</span>
                            </span>
                        {% else %}
                            <span style="font-size: 0.85rem; color: var(--text-muted);">Aucun conseiller désigné —
                                <a href="{{ path('app_instruction_edit', {'id': instruction.id}) }}">en désigner</a>, ou laisser l'IA en proposer.
                            </span>
                        {% endfor %}
                    </div>
                </div>
                <div style="grid-column: 1 / -1;">
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Entités concernées <span style="text-transform: none;">(d'après les actions)</span></div>
                    <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px;">
                        {% for e in instruction.entitesConcernees %}
                            <span class="badge badge-secondary" title="{{ e.nom }}">{{ e.code }}</span>
                        {% else %}
                            <span style="font-size: 0.85rem; color: var(--text-muted);">Aucune action pour le moment.</span>
                        {% endfor %}
                    </div>
                </div>
                <div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Date d'Émission</div>
                    <div style="font-weight: 600;">{{ instruction.dateInstruction|date('d/m/Y') }}</div>
                </div>
                <div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Échéance Globale</div>
                    <div style="font-weight: 700; {% if instruction.isEnRetard %}color: var(--color-danger);{% endif %}">
                        {{ instruction.dateEcheance ? instruction.dateEcheance|date('d/m/Y') : 'Non définie' }}
                    </div>
                </div>
            </div>

            {% if instruction.description %}
                <div style="background: var(--bg-main); padding: 14px; border-radius: var(--radius-md); margin-top: 10px; font-size: 0.88rem;">
                    <div style="font-weight: 700; font-size: 0.78rem; color: var(--bcc-navy); text-transform: uppercase; margin-bottom: 4px;">Contenu / Synthèse :</div>
                    {{ instruction.description|nl2br }}
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Progress Card -->
    <div class="card" style="margin-bottom: 0;">
        <div class="card-header">
            <h3 class="card-title"><i class="bi bi-speedometer2" style="color: var(--bcc-gold);"></i> Avancement</h3>
        </div>
        <div class="card-body">
            <!-- Progress gauge -->
            <div style="margin-bottom: 24px; text-align: center; padding: 16px; background: var(--bg-main); border-radius: var(--radius-lg);">
                <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700;">Taux d'Exécution Global Consolidé</div>
                <div style="font-size: 2.5rem; font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--bcc-navy); margin: 4px 0 10px;">
                    {{ instruction.tauxAvancement }} %
                </div>
                <div class="progress-bar-container" style="height: 12px; max-width: 320px; margin: 0 auto;">
                    <div class="progress-bar-fill {% if instruction.tauxAvancement >= 80 %}success{% elseif instruction.tauxAvancement >= 30 %}warning{% else %}danger{% endif %}" style="width: {{ instruction.tauxAvancement }}%;"></div>
                </div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 8px;">
                    Calculé automatiquement à partir des {{ instruction.actions|length }} actions opérationnelles.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Document officiel (PDF) & lien portail BCC : bandeau compact, aperçu en fenêtre -->
<div class="card" id="documentOfficiel" style="padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
    <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
        <i class="bi bi-file-earmark-pdf-fill" style="color: {{ instruction.hasDocument ? '#DC2626' : '#CBD5E1' }}; font-size: 1.3rem;"></i>
        <div style="min-width: 0;">
            <div style="font-weight: 700; font-size: 0.85rem; color: var(--bcc-navy);">Document officiel</div>
            {% if instruction.hasDocument %}
                <div style="font-size: 0.76rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 420px;" title="{{ instruction.documentNomOriginal }}">{{ instruction.documentNomOriginal }}</div>
            {% else %}
                <div style="font-size: 0.76rem; color: var(--text-muted);">
                    Aucun PDF joint{% if not instruction.lienPortail %} ni lien portail{% endif %} —
                    <a href="{{ path('app_instruction_edit', {'id': instruction.id}) }}" style="font-weight: 600;">joindre le document</a>
                </div>
            {% endif %}
        </div>
    </div>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        {% if instruction.hasDocument %}
            <button type="button" class="btn btn-primary btn-sm" onclick="openDocumentModal()">
                <i class="bi bi-eye"></i> Consulter
            </button>
            <a href="{{ path('app_instruction_document', {'id': instruction.id, 'telecharger': 1}) }}" class="btn btn-secondary btn-sm" title="Télécharger le PDF">
                <i class="bi bi-download"></i>
            </a>
        {% endif %}
        {% if instruction.lienPortail %}
            <a href="{{ instruction.lienPortail }}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" title="{{ instruction.lienPortail }}">
                <i class="bi bi-box-arrow-up-right"></i> Portail BCC
            </a>
        {% endif %}
    </div>
</div>

{% if instruction.hasDocument %}
<div id="modalDocument" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center; padding: 20px;" onclick="if (event.target === this) closeDocumentModal()">
    <div style="background: #FFFFFF; border-radius: var(--radius-lg); width: min(1100px, 100%); height: 92vh; box-shadow: var(--shadow-lg); overflow: hidden; display: flex; flex-direction: column;">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; gap: 10px;">
            <h3 class="card-title" style="margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <i class="bi bi-file-earmark-pdf-fill" style="color: #DC2626;"></i> {{ instruction.reference }} — {{ instruction.documentNomOriginal }}
            </h3>
            <div style="display: flex; gap: 8px; align-items: center; flex-shrink: 0;">
                <a href="{{ path('app_instruction_document', {'id': instruction.id}) }}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" title="Ouvrir dans un nouvel onglet">
                    <i class="bi bi-arrows-fullscreen"></i>
                </a>
                <a href="{{ path('app_instruction_document', {'id': instruction.id, 'telecharger': 1}) }}" class="btn btn-secondary btn-sm" title="Télécharger">
                    <i class="bi bi-download"></i>
                </a>
                <button type="button" onclick="closeDocumentModal()" style="background: none; border: none; font-size: 1.4rem; cursor: pointer; line-height: 1;" title="Fermer">&times;</button>
            </div>
        </div>
        <!-- Le PDF n'est chargé qu'à l'ouverture -->
        <iframe id="documentFrame" data-src="{{ path('app_instruction_document', {'id': instruction.id}) }}#view=FitH"
                title="Document officiel {{ instruction.reference }}"
                style="flex: 1; width: 100%; border: 0; display: block;"></iframe>
    </div>
</div>
{% endif %}

<!-- Actions Decomposition Table -->
<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <h3 class="card-title" style="margin: 0;">
            <i class="bi bi-list-task" style="color: var(--bcc-gold);"></i> Décomposition en Actions Opérationnelles ({{ instruction.actions|length }})
        </h3>
        <div style="display: flex; gap: 8px; align-items: center;">
            <button type="button" class="btn btn-gold btn-sm" onclick="openAiActionsModal()" style="background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%); color: #FFFFFF; border: none; font-weight: 600; box-shadow: 0 2px 8px rgba(13, 148, 136, 0.35);">
                <i class="bi bi-stars"></i> Générer par IA
            </button>
            <a href="{{ path('app_action_new', {'instructionId': instruction.id}) }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Nouvelle Action
            </a>
        </div>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Action & Objectif</th>
                        <th>Entité Responsable</th>
                        <th>Responsable Agent</th>
                        <th>Échéance</th>
                        <th style="width: 150px;">Avancement</th>
                        <th>Statut</th>
                        <th style="min-width: 170px;">Conseiller (Cabinet)</th>
                        <th style="text-align: right;">Opérations</th>
                    </tr>
                </thead>
                <tbody>
                    {% for index, act in instruction.actions %}
                        <tr {% if act.isEnRetard %}style="background-color: #FEF2F2;"{% endif %} id="action-{{ act.id }}">
                            <td style="font-weight: 700; color: var(--text-muted);">{{ index + 1 }}</td>
                            <td>
                                <a href="{{ path('app_action_show', {'id': act.id}) }}" style="font-weight: 700; color: var(--bcc-navy-light);">
                                    {{ act.libelle }}
                                </a>
                                {% if act.resultatAttendu %}
                                    <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 2px;">
                                        <em>Attendu :</em> {{ act.resultatAttendu|length > 70 ? act.resultatAttendu|slice(0, 70) ~ '...' : act.resultatAttendu }}
                                    </div>
                                {% endif %}
                            </td>
                            <td><strong>{{ act.entiteResponsable.code }}</strong></td>
                            <td>{{ act.responsable ? act.responsable.nomComplet : '<span class="text-muted">Non assigné</span>'|raw }}</td>
                            <td>
                                {% if act.dateEcheance %}
                                    <span style="font-size: 0.85rem; font-weight: 600; {% if act.isEnRetard %}color: var(--color-danger);{% endif %}">
                                        {{ act.dateEcheance|date('d/m/Y') }}
                                    </span>
                                    {% if act.isEnRetard %}
                                        <div><span class="badge badge-danger" style="font-size: 0.65rem;">En retard</span></div>
                                    {% endif %}
                                {% else %}-{% endif %}
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill {% if act.tauxAvancement >= 80 %}success{% elseif act.tauxAvancement >= 30 %}warning{% else %}danger{% endif %}" style="width: {{ act.tauxAvancement }}%;"></div>
                                    </div>
                                    <span style="font-size: 0.75rem; font-weight: 700;">{{ act.tauxAvancement }}%</span>
                                </div>
                            </td>
                            <td><span class="badge {{ act.statut.badgeClass }}">{{ act.statut.libelle }}</span></td>
                            
                            <!-- Conseillers du Gouverneur Column -->
                            <td>
                                {% if act.suivisConseillers|length > 0 %}
                                    <div class="d-flex flex-column gap-1">
                                        {% for s in act.suivisConseillers %}
                                            <div class="d-flex align-items-center justify-content-between p-1 bg-light border rounded small" style="font-size: 0.75rem;">
                                                <div class="d-flex align-items-center gap-1 text-truncate" style="max-width: 110px;">
                                                    <span class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem; padding: 2px 4px;">{{ s.conseiller.codeDomaine }}</span>
                                                    <span class="fw-semibold text-dark text-truncate" title="{{ s.conseiller.domaineCompetence }}">{{ s.conseiller.utilisateur ? s.conseiller.utilisateur.nom : '' }}</span>
                                                </div>
                                                <a href="{{ path('app_suivi_conseiller_examen', {'id': s.id}) }}" class="badge {{ s.statutBadgeClass }} text-decoration-none" style="font-size: 0.65rem; padding: 2px 5px;" title="{{ s.avis ? s.avis|slice(0, 80) : s.statutLibelle }}">
                                                    <i class="bi {{ s.statutIcon }}"></i> {{ s.statutLibelle }}
                                                </a>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <span class="text-muted small fst-italic">Non suivi</span>
                                {% endif %}

                                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_CABINET') or is_granted('ROLE_GESTIONNAIRE') %}
                                    <div class="mt-1">
                                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" onclick="openAssignConseillerModal({{ act.id }}, '{{ act.libelle|e('js') }}')" style="font-size: 0.7rem; border-radius: 4px;">
                                            <i class="bi bi-person-plus-fill"></i> + Conseiller
                                        </button>
                                    </div>
                                {% endif %}
                            </td>

                            <td style="text-align: right; white-space: nowrap;">
                                <a href="{{ path('app_action_avancement', {'id': act.id}) }}" class="btn btn-gold btn-sm" title="Mettre à jour l'avancement">
                                    <i class="bi bi-speedometer2"></i> Avancement
                                </a>
                                <a href="{{ path('app_justificatif_depot', {'action_id': act.id}) }}" class="btn btn-secondary btn-sm" title="Déposer un justificatif / preuve">
                                    <i class="bi bi-paperclip"></i>
                                </a>
                                <a href="{{ path('app_action_show', {'id': act.id}) }}" class="btn btn-secondary btn-sm" title="Consulter la fiche détaillée">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" style="text-align: center; padding: 36px 20px; color: var(--text-muted);">
                                <i class="bi bi-stars" style="font-size: 2.2rem; color: var(--actis-primary);"></i>
                                <p style="margin-top: 10px; font-weight: 600; font-size: 1rem; color: var(--text-primary);">Aucune action opérationnelle définie pour cette instruction.</p>
                                <p style="font-size: 0.85rem; color: var(--text-secondary); max-width: 500px; margin: 0 auto 16px;">
                                    Vous pouvez soit uploader l'instruction/OS pour en extraire automatiquement les actions via l'intelligence artificielle, soit les saisir manuellement une par une.
                                </p>
                                <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                                    <button type="button" class="btn btn-gold btn-sm" onclick="openAiActionsModal()" style="background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%); color: #FFFFFF; border: none; font-weight: 600; padding: 8px 16px; box-shadow: 0 4px 12px rgba(13, 148, 136, 0.35);">
                                        <i class="bi bi-stars me-1"></i> Générer automatiquement par IA
                                    </button>
                                    <a href="{{ path('app_action_new', {'instructionId': instruction.id}) }}" class="btn btn-secondary btn-sm" style="padding: 8px 16px;">
                                        <i class="bi bi-plus-circle me-1"></i> Saisie manuelle
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Two columns: Justificatifs / Pièces & Historique d'Audit -->
<div class="grid-2">
    <!-- Justificatifs & Pièces Jointes -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-paperclip" style="color: var(--bcc-navy-light);"></i> Pièces Justificatives & Preuves ({{ instruction.justificatifs|length }})
            </h3>
            <a href="{{ path('app_justificatif_depot', {'instruction_id': instruction.id}) }}" class="btn btn-secondary btn-sm">
                <i class="bi bi-upload"></i> Joindre une pièce
            </a>
        </div>
        <div class="card-body" style="padding: 12px 20px;">
            {% for just in instruction.justificatifs %}
                <div style="padding: 10px 0; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <div style="font-weight: 600; color: var(--bcc-navy);">
                            {% if just.isPdf %}
                                <i class="bi bi-file-earmark-pdf-fill" style="color: #DC2626; margin-right: 4px;"></i>
                            {% elseif just.isImage %}
                                <i class="bi bi-file-earmark-image-fill" style="color: #2563EB; margin-right: 4px;"></i>
                            {% else %}
                                <i class="bi bi-file-earmark-text-fill" style="color: #64748B; margin-right: 4px;"></i>
                            {% endif %}
                            {{ just.nomFichier }}
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                            {{ just.tailleLisible }} &bull; Déposé par {{ just.deposePar ? just.deposePar.nomComplet : 'Système' }} le {{ just.dateDepot|date('d/m/Y H:i') }}
                            {% if just.description %} &bull; <em>{{ just.description }}</em>{% endif %}
                        </div>
                    </div>
                    <div style="display: flex; gap: 6px;">
                        <a href="{{ path('app_justificatif_download', {'id': just.id}) }}" class="btn btn-secondary btn-sm" title="Télécharger">
                            <i class="bi bi-download"></i>
                        </a>
                        <form action="{{ path('app_justificatif_delete', {'id': just.id}) }}" method="post" onsubmit="return confirm('Supprimer cette pièce justificative ?');">
                            <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--color-danger);" title="Supprimer">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            {% else %}
                <div style="padding: 24px; text-align: center; color: var(--text-muted);">
                    Aucun document justificatif rattaché.
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Historique & Traçabilité (Piste d'audit) -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-clock-history" style="color: var(--bcc-gold);"></i> Journal de Suivi & Audit
            </h3>
        </div>
        <div class="card-body">
            <div class="timeline">
                {% for hist in instruction.historiques %}
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-date">{{ hist.createdAt|date('d/m/Y à H:i') }} &bull; {{ hist.utilisateur ? hist.utilisateur.nomComplet : 'Système' }}</div>
                        <div class="timeline-content">
                            <strong>{{ hist.typeEvenement.libelle }}</strong> : {{ hist.description }}
                        </div>
                    </div>
                {% else %}
                    <div style="color: var(--text-muted); font-size: 0.85rem;">Aucun événement consigné dans l'historique.</div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<!-- Comments Section -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-chat-left-text-fill" style="color: var(--bcc-navy-light);"></i> Commentaires & Échanges ({{ instruction.commentaires|length }})</h3>
    </div>
    <div class="card-body">
        <div style="margin-bottom: 24px;">
            {{ form_start(commentForm) }}
                {{ form_widget(commentForm.commentaire, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Ajouter une observation, une consigne ou un retour d\'exécution...'}}) }}
                <div style="display: flex; justify-content: flex-end; margin-top: 8px;">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-send-fill"></i> Publier le commentaire
                    </button>
                </div>
            {{ form_end(commentForm) }}
        </div>

        <div>
            {% for comm in instruction.commentaires %}
                <div style="background: var(--bg-main); padding: 14px 18px; border-radius: var(--radius-md); margin-bottom: 12px; border-left: 3px solid var(--bcc-gold);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                        <strong style="color: var(--bcc-navy); font-size: 0.85rem;">{{ comm.utilisateur.nomComplet }} ({{ comm.utilisateur.entite.code }})</strong>
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size: 0.75rem; color: var(--text-muted);">{{ comm.createdAt|date('d/m/Y à H:i') }}</span>
                            {% if comm.utilisateur == app.user or is_granted('ROLE_ADMIN') %}
                                <form method="post" action="{{ path('app_instruction_comment_delete', {'id': instruction.id, 'commentId': comm.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?');" style="display: inline; margin: 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comm.id) }}">
                                    <button type="submit" class="btn btn-link text-danger p-0 border-0" style="font-size: 0.8rem;" title="Supprimer le commentaire">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                    <div style="font-size: 0.88rem; color: var(--text-primary);">
                        {{ comm.commentaire|nl2br }}
                    </div>
                </div>
            {% else %}
                <div style="color: var(--text-muted); font-size: 0.85rem; text-align: center; padding: 16px;">
                    Aucun commentaire pour le moment.
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Modal Delete / Soft-Delete Instruction -->
<div id="modalDeleteInstruction" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #FFFFFF; border-radius: var(--radius-lg); max-width: 520px; width: 100%; box-shadow: var(--shadow-lg); overflow: hidden;">
        <div class="card-header bg-danger text-white">
            <h3 class="card-title text-white mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i> Suppression Logique de l'Instruction</h3>
            <button type="button" onclick="document.getElementById('modalDeleteInstruction').style.display = 'none'" style="background: none; border: none; font-size: 1.2rem; color: #fff; cursor: pointer;">&times;</button>
        </div>
        <form action="{{ path('app_instruction_delete', {'id': instruction.id}) }}" method="post" style="padding: 24px;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_instruction_' ~ instruction.id) }}">
            <p class="text-danger small mb-3">
                <strong>Attention :</strong> L'instruction <strong>{{ instruction.reference }}</strong> ainsi que toutes ses actions associées seront retirées des tableaux de bord et archivées avec traçabilité d'audit.
            </p>
            <div class="form-group mb-3">
                <label class="form-label fw-bold">Motif de la suppression <span class="text-danger">*</span></label>
                <textarea name="motif_suppression" class="form-control" rows="3" required placeholder="Indiquez obligatoirement la raison (erreur de saisie, décision d'annulation, doublon...)"></textarea>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('modalDeleteInstruction').style.display = 'none'">Annuler</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Confirmer la suppression</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Change Status -->
<div id="modalChangeStatut" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #FFFFFF; border-radius: var(--radius-lg); max-width: 500px; width: 100%; box-shadow: var(--shadow-lg); overflow: hidden;">
        <div class="card-header">
            <h3 class="card-title">Changer le Statut de l'Instruction</h3>
            <button type="button" onclick="document.getElementById('modalChangeStatut').style.display = 'none'" style="background: none; border: none; font-size: 1.2rem; cursor: pointer;">&times;</button>
        </div>
        <form action="{{ path('app_instruction_change_statut', {'id': instruction.id}) }}" method="post" style="padding: 24px;">
            <div class="form-group">
                <label class="form-label">Nouveau Statut</label>
                <select name="statut_id" class="form-select" required>
                    {% for st in availableStatuts %}
                        <option value="{{ st.id }}" {% if instruction.statut.id == st.id %}selected{% endif %}>{{ st.libelle }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Motif / Commentaire de clôture ou transition</label>
                <textarea name="motif_cloture" class="form-control" rows="3" placeholder="Préciser les motivations..."></textarea>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('modalChangeStatut').style.display = 'none'">Annuler</button>
                <button type="submit" class="btn btn-primary">Valider la transition</button>
            </div>
        </form>
    </div>
</div>

<!-- ===================================================================
     MODALE IA : EXTRACTION & CRÉATION EN BLOC DES ACTIONS OPÉRATIONNELLES
     =================================================================== -->
<div id="modalAiActions" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); z-index: 1050; align-items: center; justify-content: center; padding: 20px; overflow-y: auto;">
    <div style="background: #FFFFFF; border-radius: 16px; max-width: 1050px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); overflow: hidden; display: flex; flex-direction: column; max-height: 90vh; border: 1px solid var(--border-color);">
        
        <!-- En-tête de la Modale -->
        <div style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #FFFFFF; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--actis-primary);">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, #0D9488 0%, #14B8A6 100%); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.25rem; box-shadow: 0 4px 12px rgba(13, 148, 136, 0.4);">
                    <i class="bi bi-stars"></i>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #FFFFFF; display: flex; align-items: center; gap: 8px;">
                        Générateur d'Actions Intelligentes (Google Gemini AI)
                        <span class="badge" style="background: rgba(20, 184, 166, 0.2); color: #2DD4BF; border: 1px solid rgba(45, 212, 191, 0.4); font-size: 0.7rem; font-weight: 600;">ACTIS AI ASSISTANT</span>
                    </h3>
                    <div style="font-size: 0.8rem; color: #94A3B8; margin-top: 2px;">
                        Instruction : <strong style="color: #E2E8F0;">{{ instruction.reference }}</strong> — {{ instruction.objet|length > 60 ? instruction.objet|slice(0, 60) ~ '...' : instruction.objet }}
                    </div>
                </div>
            </div>
            <button type="button" onclick="closeAiActionsModal()" style="background: rgba(255,255,255,0.1); border: none; border-radius: 8px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; color: #E2E8F0; cursor: pointer; font-size: 1.1rem; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'">
                &times;
            </button>
        </div>

        <!-- Indicateur d'étapes (Stepper) -->
        <div style="background: #F8FAFC; padding: 12px 24px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; gap: 24px;">
            <div id="stepIndicator1" style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 0.85rem; color: var(--actis-primary);">
                <span style="width: 26px; height: 26px; border-radius: 50%; background: var(--actis-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">1</span>
                <span>Document & Analyse IA</span>
            </div>
            <div style="height: 2px; width: 40px; background: var(--border-color);" id="stepperLine"></div>
            <div id="stepIndicator2" style="display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.85rem; color: var(--text-muted);">
                <span style="width: 26px; height: 26px; border-radius: 50%; background: #E2E8F0; color: #64748B; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;" id="stepNumber2">2</span>
                <span>Revue & Création en bloc</span>
            </div>
        </div>

        <!-- Corps de la Modale (Scrollable) -->
        <div style="padding: 24px; overflow-y: auto; flex: 1;">
            
            <!-- ÉTAPE 1 : UPLOAD & EXTRACTION -->
            <div id="aiStepUpload">
                <div style="text-align: center; max-width: 650px; margin: 0 auto 20px;">
                    <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--bcc-navy); margin-bottom: 6px;">
                        Téléversez le document de l'Instruction ou de l'Ordre de Service (OS)
                    </h4>
                    <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0;">
                        L'IA va extraire et décomposer automatiquement le contenu en actions opérationnelles précises, assignées et planifiées.
                    </p>
                </div>

                <!-- Zone de Drag & Drop -->
                <div id="aiDropzone" style="border: 2px dashed #CBD5E1; border-radius: 12px; background: #F8FAFC; padding: 32px 20px; text-align: center; cursor: pointer; transition: all 0.2s ease; position: relative;">
                    <input type="file" id="aiFileInput" accept=".pdf,.docx,.doc,.png,.jpg,.jpeg,.txt" style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" onchange="handleAiFileSelected(this.files)">
                    <div id="aiDropzonePrompt">
                        <div style="width: 56px; height: 56px; margin: 0 auto 12px; border-radius: 50%; background: rgba(13, 148, 136, 0.1); color: var(--actis-primary); display: flex; align-items: center; justify-content: center; font-size: 1.6rem;">
                            <i class="bi bi-cloud-arrow-up"></i>
                        </div>
                        <div style="font-size: 0.95rem; font-weight: 700; color: var(--bcc-navy); margin-bottom: 4px;">
                            Glissez-déposez votre fichier ici, ou <span style="color: var(--actis-primary); text-decoration: underline;">parcourez vos dossiers</span>
                        </div>
                        <div style="font-size: 0.78rem; color: var(--text-muted);">
                            Formats supportés : PDF, Word (.docx), Scans & Images (PNG, JPG) ou Texte (Max 25 Mo)
                        </div>
                    </div>

                    <!-- Fichier Sélectionné (Initialement caché) -->
                    <div id="aiFileSelectedBox" style="display: none; align-items: center; justify-content: space-between; background: #FFFFFF; border: 1px solid var(--actis-primary); border-radius: 8px; padding: 12px 16px; max-width: 480px; margin: 0 auto; text-align: left;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <i class="bi bi-file-earmark-check-fill fs-3" style="color: var(--actis-primary);"></i>
                            <div>
                                <div id="aiFileName" style="font-weight: 700; font-size: 0.9rem; color: var(--bcc-navy);">document.pdf</div>
                                <div id="aiFileSize" style="font-size: 0.75rem; color: var(--text-muted);">1.2 MB</div>
                            </div>
                        </div>
                        <button type="button" onclick="removeAiSelectedFile(event)" style="background: none; border: none; color: var(--color-danger); cursor: pointer; font-size: 1.1rem;" title="Retirer le fichier">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>

                <!-- Consignes supplémentaires / Optionnelles -->
                <div style="margin-top: 16px;">
                    <label class="form-label" style="font-size: 0.85rem; font-weight: 600; color: var(--bcc-navy); display: flex; justify-content: space-between;">
                        <span><i class="bi bi-sliders me-1"></i> Consignes ou orientations particulières (optionnel)</span>
                        <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: normal;">Ex: "Priorité haute sur les aspects comptables, délai maximal de 30 jours"</span>
                    </label>
                    <textarea id="aiCustomPrompt" class="form-control" rows="2" placeholder="Ajouter des consignes spécifiques pour guider l'analyse de l'IA..." style="font-size: 0.85rem;"></textarea>
                </div>

                <!-- Animation d'état de chargement IA -->
                <div id="aiLoadingIndicator" style="display: none; margin-top: 24px; padding: 24px; background: linear-gradient(135deg, rgba(13, 148, 136, 0.05) 0%, rgba(15, 23, 42, 0.05) 100%); border: 1px solid rgba(13, 148, 136, 0.2); border-radius: 12px; text-align: center;">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem; color: var(--actis-primary) !important;" role="status">
                        <span class="visually-hidden">Traitement en cours...</span>
                    </div>
                    <h5 style="font-weight: 700; font-size: 1rem; color: var(--bcc-navy); margin-bottom: 6px;" id="aiLoadingTitle">
                        Analyse intelligente du document en cours...
                    </h5>
                    <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0;" id="aiLoadingSubtitle">
                        Extraction du texte et structuration des actions opérationnelles via OpenAI GPT-4o.
                    </p>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px;" id="aiStep1Actions">
                    <button type="button" class="btn btn-secondary" onclick="closeAiActionsModal()">Annuler</button>
                    <button type="button" class="btn btn-primary" id="btnLaunchAiExtraction" onclick="launchAiExtraction()" style="background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%); border: none; font-weight: 600; padding: 8px 20px; box-shadow: 0 4px 12px rgba(13, 148, 136, 0.35);">
                        <i class="bi bi-stars me-1"></i> Lancer l'analyse IA
                    </button>
                </div>
            </div>

            <!-- ÉTAPE 2 : PRÉVISUALISATION, ÉDITION & CRÉATION EN BLOC -->
            <div id="aiStepPreview" style="display: none;">
                <!-- Header de succès & résumé -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <div style="font-size: 1rem; font-weight: 700; color: var(--bcc-navy); display: flex; align-items: center; gap: 8px;">
                            <span class="badge" style="background: var(--color-success-bg); color: var(--color-success); border: 1px solid var(--color-success); font-size: 0.85rem;" id="aiActionsCountBadge">
                                0 actions détectées
                            </span>
                            <span>Vérifiez et ajustez les actions avant enregistrement :</span>
                        </div>
                        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                            Cochez ou décochez les actions à créer. Vous pouvez modifier directement les textes, directions et dates.
                        </div>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="addNewAiActionRow()">
                            <i class="bi bi-plus-lg me-1"></i> Ajouter une ligne
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="backToAiUploadStep()">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Ré-analyser
                        </button>
                    </div>
                </div>

                <!-- Conseillers responsables proposés par l'IA -->
                <div id="aiConseillersBlock" style="border: 1px solid #99F6E4; background: #F0FDFA; border-radius: 8px; padding: 12px 14px; margin-bottom: 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
                        <div style="font-size: 0.9rem; font-weight: 700; color: #0F766E;">
                            <i class="bi bi-person-badge me-1"></i> Conseillers responsables proposés
                            <span style="font-weight: 400; font-size: 0.78rem; color: var(--text-muted);">— d'après leur domaine de compétence, à confirmer</span>
                        </div>
                        <select id="aiAjoutConseiller" class="form-select form-select-sm" style="max-width: 300px;" onchange="ajouterConseillerManuel(this)">
                            <option value="">+ Ajouter un autre conseiller…</option>
                        </select>
                    </div>
                    <div id="aiConseillersList" style="display: flex; flex-direction: column; gap: 6px;"></div>
                </div>

                <!-- Tableau interactif d'actions -->
                <div class="table-responsive" style="border: 1px solid var(--border-color); border-radius: 8px; max-height: 48vh; overflow-y: auto;">
                    <table class="table mb-0" id="aiActionsTable" style="font-size: 0.85rem;">
                        <thead style="position: sticky; top: 0; background: #F1F5F9; z-index: 2;">
                            <tr>
                                <th style="width: 40px; text-align: center;">
                                    <input type="checkbox" id="aiSelectAllCheckbox" checked onchange="toggleAllAiActions(this.checked)" style="cursor: pointer;">
                                </th>
                                <th style="min-width: 250px;">Libellé de l'Action <span class="text-danger">*</span></th>
                                <th style="min-width: 220px;">Résultat attendu / Objectif</th>
                                <th style="min-width: 180px;">Entité Responsable <span class="text-danger">*</span></th>
                                <th style="min-width: 130px;">Priorité</th>
                                <th style="min-width: 130px;">Échéance</th>
                                <th style="width: 50px; text-align: center;">Retirer</th>
                            </tr>
                        </thead>
                        <tbody id="aiActionsTableBody">
                            <!-- Les lignes seront insérées dynamiquement en JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Footer de validation en bloc -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border-color); flex-wrap: wrap; gap: 12px;">
                    <div style="font-size: 0.85rem; font-weight: 600; color: var(--bcc-navy);" id="aiSelectedCountInfo">
                        <i class="bi bi-check2-circle text-success me-1"></i> 0 action(s) sélectionnée(s) pour création
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <button type="button" class="btn btn-secondary" onclick="closeAiActionsModal()">Annuler</button>
                        <button type="button" class="btn btn-primary" id="btnBatchSaveActions" onclick="submitBatchActions()" style="background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%); border: none; font-weight: 700; padding: 8px 24px; box-shadow: 0 4px 12px rgba(13, 148, 136, 0.35);">
                            <i class="bi bi-check-all me-1"></i> Valider et Créer en bloc
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ===================================================================
     SCRIPTS CLIENT POUR LA MODALE IA ET LA CRÉATION EN BLOC
     =================================================================== -->
<script>
    // Références globales pour les entités et priorités
    const ALL_ENTITES = [
        {% for ent in allEntites %}
            { id: {{ ent.id }}, code: {{ ent.code|json_encode|raw }}, nom: {{ ent.nom|json_encode|raw }}, groupe: {{ ent.groupeDirectionGenerale|json_encode|raw }} },
        {% endfor %}
    ];

    const ALL_PRIORITES = [
        {% for prio in allPriorites %}
            { id: {{ prio.id }}, code: {{ prio.code|json_encode|raw }}, libelle: {{ prio.libelle|json_encode|raw }} },
        {% endfor %}
    ];

    // Entité par défaut des nouvelles lignes : première entité déjà concernée, sinon celle de l'utilisateur
    {% set entiteParDefaut = instruction.entitesConcernees|first ?: (app.user.entite ?? null) %}
    const DEFAULT_ENTITE_ID = {{ entiteParDefaut ? entiteParDefaut.id : 'null' }};
    const ALL_CONSEILLERS = [
        {% for c in allConseillers %}
            { id: {{ c.id }}, nom: {{ c.nom|json_encode|raw }}, code: {{ c.codeDomaine|json_encode|raw }}, domaine: {{ c.domaineCompetence|json_encode|raw }} },
        {% endfor %}
    ];
    const RESPONSABLES_ACTUELS = {{ instruction.responsables|map(c => c.id)|json_encode|raw }};
    const INSTRUCTION_ID = {{ instruction.id }};
    let currentSelectedFile = null;
    let extractedActionsData = [];

    function escapeHtml(text) {
        if (text === null || text === undefined) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function openDocumentModal() {
        const frame = document.getElementById('documentFrame');
        if (!frame.getAttribute('src')) {
            frame.setAttribute('src', frame.dataset.src);
        }
        document.getElementById('modalDocument').style.display = 'flex';
    }

    function closeDocumentModal() {
        document.getElementById('modalDocument').style.display = 'none';
    }

    document.addEventListener('keydown', function (e) {
        const modal = document.getElementById('modalDocument');
        if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
            closeDocumentModal();
        }
    });

    function openAiActionsModal() {
        document.getElementById('modalAiActions').style.display = 'flex';
        backToAiUploadStep();
    }

    function closeAiActionsModal() {
        document.getElementById('modalAiActions').style.display = 'none';
        resetAiExtractionState();
    }

    function resetAiExtractionState() {
        currentSelectedFile = null;
        extractedActionsData = [];
        document.getElementById('aiFileInput').value = '';
        document.getElementById('aiFileSelectedBox').style.display = 'none';
        document.getElementById('aiDropzonePrompt').style.display = 'block';
        document.getElementById('aiCustomPrompt').value = '';
        document.getElementById('aiLoadingIndicator').style.display = 'none';
        document.getElementById('btnLaunchAiExtraction').disabled = false;
    }

    function backToAiUploadStep() {
        document.getElementById('aiStepUpload').style.display = 'block';
        document.getElementById('aiStepPreview').style.display = 'none';
        document.getElementById('stepIndicator1').style.color = 'var(--actis-primary)';
        document.getElementById('stepIndicator1').querySelector('span').style.background = 'var(--actis-primary)';
        document.getElementById('stepIndicator1').querySelector('span').style.color = '#fff';
        document.getElementById('stepIndicator2').style.color = 'var(--text-muted)';
        document.getElementById('stepNumber2').style.background = '#E2E8F0';
        document.getElementById('stepNumber2').style.color = '#64748B';
    }

    function handleAiFileSelected(files) {
        if (!files || files.length === 0) return;
        currentSelectedFile = files[0];
        document.getElementById('aiFileName').textContent = currentSelectedFile.name;
        document.getElementById('aiFileSize').textContent = (currentSelectedFile.size / (1024 * 1024)).toFixed(2) + ' MB';
        document.getElementById('aiDropzonePrompt').style.display = 'none';
        document.getElementById('aiFileSelectedBox').style.display = 'flex';
    }

    function removeAiSelectedFile(e) {
        if (e) e.stopPropagation();
        currentSelectedFile = null;
        document.getElementById('aiFileInput').value = '';
        document.getElementById('aiFileSelectedBox').style.display = 'none';
        document.getElementById('aiDropzonePrompt').style.display = 'block';
    }

    // Drag & Drop visual highlights
    const dropzone = document.getElementById('aiDropzone');
    ['dragenter', 'dragover'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.style.borderColor = 'var(--actis-primary)';
            dropzone.style.background = 'rgba(13, 148, 136, 0.05)';
        }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.style.borderColor = '#CBD5E1';
            dropzone.style.background = '#F8FAFC';
        }, false);
    });

    dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files && files.length > 0) {
            handleAiFileSelected(files);
        }
    });

    // Lancement de l'analyse IA via Endpoint AJAX
    async function launchAiExtraction() {
        if (!currentSelectedFile && !document.getElementById('aiCustomPrompt').value.trim()) {
            alert('Veuillez sélectionner un fichier (PDF, Word, Scan) ou saisir une consigne textuelle.');
            return;
        }

        const btnLaunch = document.getElementById('btnLaunchAiExtraction');
        const loadingIndicator = document.getElementById('aiLoadingIndicator');
        btnLaunch.disabled = true;
        loadingIndicator.style.display = 'block';

        const formData = new FormData();
        if (currentSelectedFile) {
            formData.append('document', currentSelectedFile);
        }
        formData.append('custom_prompt', document.getElementById('aiCustomPrompt').value);

        try {
            const response = await fetch(`/instructions/${INSTRUCTION_ID}/ai-extract`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            });

            if (response.redirected || (response.url && response.url.includes('/login'))) {
                throw new Error("Votre session utilisateur a expiré. Veuillez recharger la page ou vous reconnecter.");
            }

            const rawText = await response.text();
            let result;
            try {
                result = JSON.parse(rawText);
            } catch (jsonErr) {
                if (rawText.includes('<title>')) {
                    const titleMatch = rawText.match(/<title>(.*?)<\/title>/i);
                    const pageTitle = titleMatch ? titleMatch[1] : 'Erreur Serveur';
                    throw new Error(`Le serveur a renvoyé une page d'erreur (${pageTitle}). Veuillez rafraîchir la page.`);
                }
                throw new Error("Erreur inattendue du serveur. Veuillez rafraîchir la page ou réessayer.");
            }

            if (!response.ok || !result.success) {
                throw new Error(result.message || 'Une erreur est survenue lors de l\'analyse IA.');
            }

            extractedActionsData = result.actions || [];
            renderActionsTable(extractedActionsData);
            renderConseillersProposes(result.conseillers || []);
            switchToPreviewStep();

        } catch (error) {
            console.error('Erreur IA:', error);
            alert('Erreur : ' + error.message);
        } finally {
            btnLaunch.disabled = false;
            loadingIndicator.style.display = 'none';
        }
    }

    // ── Conseillers responsables (proposés par l'IA, ou ajoutés à la main) ──
    function conseillerLigneHtml(c, raison, coche) {
        const deja = RESPONSABLES_ACTUELS.includes(c.id);
        return `
            <label class="ai-conseiller-row" data-id="${c.id}" style="display: flex; align-items: flex-start; gap: 10px; background: #FFFFFF; border: 1px solid #CCFBF1; border-radius: 6px; padding: 8px 10px; margin: 0; cursor: ${deja ? 'default' : 'pointer'};">
                <input type="checkbox" class="ai-conseiller-checkbox" value="${c.id}" ${coche || deja ? 'checked' : ''} ${deja ? 'disabled' : ''} style="margin-top: 3px;">
                <span style="flex: 1;">
                    <span style="font-weight: 600; color: var(--bcc-navy); font-size: 0.85rem;">${escapeHtml(c.nom)}</span>
                    <span class="badge badge-secondary" style="font-size: 0.65rem; margin-left: 4px;">${escapeHtml(c.code)}</span>
                    ${deja ? '<span style="font-size: 0.72rem; color: #0F766E; margin-left: 6px;">déjà responsable</span>' : ''}
                    <span style="display: block; font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(c.domaine)}</span>
                    ${raison ? `<span style="display: block; font-size: 0.75rem; color: #0F766E; margin-top: 2px;"><i class="bi bi-stars"></i> ${escapeHtml(raison)}</span>` : ''}
                </span>
            </label>`;
    }

    function rafraichirListeAjoutConseiller() {
        const affiches = Array.from(document.querySelectorAll('.ai-conseiller-row')).map(r => parseInt(r.dataset.id, 10));
        const select = document.getElementById('aiAjoutConseiller');
        select.innerHTML = '<option value="">+ Ajouter un autre conseiller…</option>'
            + ALL_CONSEILLERS.filter(c => !affiches.includes(c.id))
                .map(c => `<option value="${c.id}">${escapeHtml(c.nom)} — ${escapeHtml(c.domaine)}</option>`).join('');
    }

    function renderConseillersProposes(proposes) {
        const list = document.getElementById('aiConseillersList');
        const ids = proposes.map(p => p.id);
        // Les responsables déjà désignés sont rappelés en tête, puis les propositions de l'IA
        const actuels = ALL_CONSEILLERS.filter(c => RESPONSABLES_ACTUELS.includes(c.id) && !ids.includes(c.id));

        let html = actuels.map(c => conseillerLigneHtml(c, null, true)).join('');
        html += proposes.map(p => conseillerLigneHtml(p, p.raison, true)).join('');
        list.innerHTML = html || '<div style="font-size: 0.8rem; color: var(--text-muted);">L\'IA n\'a pas identifié de conseiller pour ce sujet. Vous pouvez en ajouter un ci-dessus.</div>';
        rafraichirListeAjoutConseiller();
    }

    function ajouterConseillerManuel(select) {
        const c = ALL_CONSEILLERS.find(x => x.id === parseInt(select.value, 10));
        if (!c) return;
        const list = document.getElementById('aiConseillersList');
        if (!list.querySelector('.ai-conseiller-row')) list.innerHTML = '';
        list.insertAdjacentHTML('beforeend', conseillerLigneHtml(c, null, true));
        rafraichirListeAjoutConseiller();
    }

    function switchToPreviewStep() {
        document.getElementById('aiStepUpload').style.display = 'none';
        document.getElementById('aiStepPreview').style.display = 'block';
        document.getElementById('stepIndicator2').style.color = 'var(--actis-primary)';
        document.getElementById('stepNumber2').style.background = 'var(--actis-primary)';
        document.getElementById('stepNumber2').style.color = '#fff';
    }

    function renderActionsTable(actions) {
        const tbody = document.getElementById('aiActionsTableBody');
        tbody.innerHTML = '';

        document.getElementById('aiActionsCountBadge').textContent = actions.length + ' action(s) détectée(s)';

        actions.forEach((act, index) => {
            const tr = createActionRowElement(act, index);
            tbody.appendChild(tr);
        });

        updateSelectedCount();
    }

    function createActionRowElement(act = {}, index = 0) {
        const tr = document.createElement('tr');
        tr.className = 'ai-action-row';

        // Options Entités, groupées par Direction Générale (ALL_ENTITES est déjà trié par DG)
        const entiteChoisie = act.entite_id || DEFAULT_ENTITE_ID;
        let entiteOptionsHtml = entiteChoisie ? '' : '<option value="" selected>-- Choisir l\'entité --</option>';
        let groupeCourant = null;
        ALL_ENTITES.forEach(ent => {
            if (ent.groupe !== groupeCourant) {
                if (groupeCourant !== null) entiteOptionsHtml += '</optgroup>';
                groupeCourant = ent.groupe;
                entiteOptionsHtml += `<optgroup label="${escapeHtml(ent.groupe)}">`;
            }
            const selected = entiteChoisie && entiteChoisie == ent.id ? 'selected' : '';
            entiteOptionsHtml += `<option value="${ent.id}" ${selected}>${escapeHtml(ent.code)} - ${escapeHtml(ent.nom)}</option>`;
        });
        if (groupeCourant !== null) entiteOptionsHtml += '</optgroup>';

        // Options Priorités
        let prioriteOptionsHtml = '';
        ALL_PRIORITES.forEach(prio => {
            const selected = (act.priorite_id && act.priorite_id == prio.id) || (act.priorite_code && act.priorite_code === prio.code) ? 'selected' : '';
            prioriteOptionsHtml += `<option value="${prio.id}" ${selected}>${prio.libelle}</option>`;
        });

        tr.innerHTML = `
            <td style="text-align: center; vertical-align: middle;">
                <input type="checkbox" class="ai-row-checkbox" checked onchange="updateSelectedCount()" style="cursor: pointer;">
            </td>
            <td>
                <textarea class="form-control form-control-sm ai-libelle" rows="2" required placeholder="Libellé de l'action...">${act.libelle || ''}</textarea>
            </td>
            <td>
                <textarea class="form-control form-control-sm ai-resultat" rows="2" placeholder="Résultat attendu / Objectif...">${act.resultat_attendu || act.description || ''}</textarea>
            </td>
            <td>
                <select class="form-select form-select-sm ai-entite" required>
                    ${entiteOptionsHtml}
                </select>
            </td>
            <td>
                <select class="form-select form-select-sm ai-priorite">
                    ${prioriteOptionsHtml}
                </select>
            </td>
            <td>
                <input type="date" class="form-control form-control-sm ai-echeance" value="${act.date_echeance || ''}">
            </td>
            <td style="text-align: center; vertical-align: middle;">
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove(); updateSelectedCount();" title="Supprimer cette action">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;
        return tr;
    }

    function addNewAiActionRow() {
        const tbody = document.getElementById('aiActionsTableBody');
        const newRow = createActionRowElement({}, tbody.children.length);
        tbody.appendChild(newRow);
        updateSelectedCount();
    }

    function toggleAllAiActions(isChecked) {
        document.querySelectorAll('.ai-row-checkbox').forEach(cb => {
            cb.checked = isChecked;
        });
        updateSelectedCount();
    }

    function updateSelectedCount() {
        const checkboxes = document.querySelectorAll('.ai-row-checkbox');
        const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
        document.getElementById('aiSelectedCountInfo').innerHTML = `<i class="bi bi-check2-circle text-success me-1"></i> <strong>${checkedCount}</strong> sur ${checkboxes.length} action(s) sélectionnée(s) pour création`;
        document.getElementById('btnBatchSaveActions').disabled = (checkedCount === 0);
    }

    // Soumission et Création en Bloc dans la Base de Données
    async function submitBatchActions() {
        const rows = document.querySelectorAll('.ai-action-row');
        const actionsToCreate = [];

        rows.forEach(row => {
            const isChecked = row.querySelector('.ai-row-checkbox').checked;
            if (!isChecked) return;

            const libelle = row.querySelector('.ai-libelle').value.trim();
            const resultatAttendu = row.querySelector('.ai-resultat').value.trim();
            const entiteId = row.querySelector('.ai-entite').value;
            const prioriteId = row.querySelector('.ai-priorite').value;
            const dateEcheance = row.querySelector('.ai-echeance').value;

            if (libelle) {
                actionsToCreate.push({
                    libelle: libelle,
                    resultat_attendu: resultatAttendu,
                    entite_id: entiteId,
                    priorite_id: prioriteId,
                    date_echeance: dateEcheance
                });
            }
        });

        if (actionsToCreate.length === 0) {
            alert('Veuillez sélectionner au moins une action avec un libellé valide.');
            return;
        }

        const sansEntite = actionsToCreate.find(a => !a.entite_id);
        if (sansEntite) {
            alert(`Choisissez l'entité responsable de l'action « ${sansEntite.libelle} ».`);
            return;
        }

        // Conseillers cochés (les responsables déjà désignés sont désactivés, donc ignorés ici)
        const responsables = Array.from(document.querySelectorAll('.ai-conseiller-checkbox:checked:not(:disabled)'))
            .map(cb => parseInt(cb.value, 10));

        const btnBatch = document.getElementById('btnBatchSaveActions');
        btnBatch.disabled = true;
        btnBatch.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Création en cours...';

        try {
            const response = await fetch(`/instructions/${INSTRUCTION_ID}/actions/batch-create`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ actions: actionsToCreate, responsables: responsables })
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                throw new Error(result.message || 'Une erreur est survenue lors de la création en bloc des actions.');
            }

            // Succès : recharger la page pour afficher le tableau des actions mis à jour
            window.location.reload();

        } catch (error) {
            console.error('Erreur de création en bloc:', error);
            alert('Erreur : ' + error.message);
            btnBatch.disabled = false;
            btnBatch.innerHTML = '<i class="bi bi-check-all me-1"></i> Valider et Créer en bloc';
        }
    }

    // Modal Affectation Conseiller
    function openAssignConseillerModal(actionId, actionLibelle) {
        const form = document.getElementById('formAssignConseiller');
        form.action = '/suivi-conseillers/affecter/' + actionId;
        document.getElementById('assignActionLibelle').textContent = actionLibelle;
        
        const modal = document.getElementById('modalAssignConseiller');
        if (modal) {
            modal.style.display = 'flex';
        }
    }
    function closeAssignConseillerModal() {
        const modal = document.getElementById('modalAssignConseiller');
        if (modal) {
            modal.style.display = 'none';
        }
    }
</script>

<!-- Modal Affecter un Conseiller du Gouverneur -->
<div id="modalAssignConseiller" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); z-index: 1050; align-items: center; justify-content: center; padding: 20px; overflow-y: auto;">
    <div style="background: #FFFFFF; border-radius: 16px; max-width: 540px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); overflow: hidden; display: flex; flex-direction: column; border: 1px solid #E2E8F0;">
        <form method="post" id="formAssignConseiller" action="">
            <div style="background: linear-gradient(135deg, #091A2F 0%, #0F2744 100%); color: #FFFFFF; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0D9488;">
                <h5 style="margin: 0; font-size: 1.05rem; font-weight: 700; display: flex; align-items: center; gap: 8px; color: #FFFFFF;">
                    <i class="bi bi-person-badge-fill text-warning"></i> Affecter un Conseiller du Gouverneur
                </h5>
                <button type="button" onclick="closeAssignConseillerModal()" style="background: rgba(255,255,255,0.1); border: none; border-radius: 8px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; color: #E2E8F0; cursor: pointer; font-size: 1.25rem;">&times;</button>
            </div>
            <div style="padding: 20px;">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Action sélectionnée :</label>
                    <div id="assignActionLibelle" class="fw-bold text-dark p-2 bg-light rounded border small"></div>
                </div>

                <div class="mb-3">
                    <label for="selectConseiller" class="form-label fw-semibold text-dark">Conseiller & Domaine de Compétence <span class="text-danger">*</span></label>
                    <select name="conseiller_id" id="selectConseiller" class="form-select" required>
                        <option value="">-- Choisir un Conseiller du Gouverneur --</option>
                        {% for c in allConseillers %}
                            <option value="{{ c.id }}">
                                [{{ c.codeDomaine }}] {{ c.utilisateur ? c.utilisateur.nomComplet : '' }} — {{ c.domaineCompetence }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Niveau de Priorité Cabinet</label>
                    <select name="priorite_cabinet" class="form-select">
                        <option value="NORMALE" selected>Normale</option>
                        <option value="URGENTE">Urgente (Suivi rapproché)</option>
                        <option value="TRES_URGENTE">Très Urgente (Alerte Haute Direction)</option>
                        <option value="BASSE">Basse</option>
                    </select>
                </div>

                <div class="mb-0">
                    <label for="pointAttentionInit" class="form-label fw-semibold text-dark">Note / Point d'attention initial (Optionnel)</label>
                    <textarea name="point_attention" id="pointAttentionInit" class="form-control" rows="2" placeholder="Orientation spécifique pour l'examen du conseiller..."></textarea>
                </div>
            </div>
            <div style="background: #F8FAFC; border-top: 1px solid #E2E8F0; padding: 12px 20px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-secondary btn-sm" onclick="closeAssignConseillerModal()">Annuler</button>
                <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                    <i class="bi bi-check-circle me-1"></i> Confirmer l'affectation
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
