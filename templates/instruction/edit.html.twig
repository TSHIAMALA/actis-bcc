{% extends 'base.html.twig' %}

{% block title %}Modifier l'instruction {{ instruction.reference }}{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2 class="page-title">Modifier l'instruction : {{ instruction.reference }}</h2>
        <p class="page-subtitle">{{ instruction.objet }}</p>
    </div>
    <div>
        <a href="{{ path('app_instruction_show', {'id': instruction.id}) }}" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour à la fiche
        </a>
    </div>
</div>

<div class="card" style="max-width: 900px; margin: 0 auto;">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-pencil-square" style="color: var(--bcc-gold);"></i> Formulaire de Modification</h3>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
            <div class="grid-2">
                <div class="form-group">
                    {{ form_label(form.typeInstruction, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.typeInstruction, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.typeInstruction) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.reference, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.reference, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.reference) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.objet, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.objet, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.objet) }}
            </div>

            <div class="grid-2">
                <div class="form-group">
                    {{ form_label(form.priorite, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.priorite, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.priorite) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.emetteur, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.emetteur, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.emetteur) }}
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    {{ form_label(form.entitePilote, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.entitePilote, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.entitePilote) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.responsable, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.responsable, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.responsable) }}
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    {{ form_label(form.dateInstruction, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.dateInstruction, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.dateInstruction) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.dateReception, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.dateReception, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.dateReception) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.dateEcheance, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.dateEcheance, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.dateEcheance) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
                <a href="{{ path('app_instruction_show', {'id': instruction.id}) }}" class="btn btn-secondary">Annuler</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Enregistrer les modifications
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
